// Dateipfad: frontend/src/layouts/BaseLayout.astro
---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "ABTEILUNG83 - Less Noise. Nice Data. No Bloat." } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | ABTEILUNG83</title>
    
    <ViewTransitions />
  </head>
  <body>
    <slot />
  </body>
</html>