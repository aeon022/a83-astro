---
// Dateipfad: frontend/src/layouts/BaseLayout.astro
// Version: V14.0 - GLOBAL SYNC ENGINE INTEGRATION
// Changes: Fixed <main> class for global menu glitch support

import '../styles/global.css'; 
import Header from './Header.astro';
import Footer from '../components/blocks/Footer.astro';
import GlobalCursor from '../components/ui/GlobalCursor.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "ABTEILUNG83 - Less Noise. Nice Data. No Bloat." } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | ABTEILUNG83</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  
  <body class="font-sans antialiased bg-a83-bg text-a83-text selection:bg-a83-accent selection:text-white transition-colors duration-500 flex flex-col min-h-screen">
    
    {/* Navigation & Brand Header */}
    <Header />

    {/* MAIN WRAPPER 
        Die Klasse 'nav-content-sync' reagiert auf html[data-nav-state] 
        und triggert die Glitch-Animationen global.
    */}
    <main class="flex-grow nav-content-sync">
        <slot />
    </main>
    
    {/* Global Footer */}
    <Footer />
    
    {/* Tactical HUD Cursor */}
    <GlobalCursor />

    {/* Cookie Consent Terminal */}
    <CookieBanner />

  </body>
</html>

<style is:global>
  kbd {
    font-family: 'JetBrains Mono', monospace;
  }

  .interactive-element:hover {
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--a83-accent) 40%, transparent));
    transition: filter 0.3s ease;
  }

  /* ==============================================================
     GLOBAL SPATIAL NAV SYNC ENGINE (GSNSE)
     Steuert das visuelle Verhalten des Contents bei Menü-Interaktion.
     ============================================================== */
  
  /* Verhindert Klicks auf den Content, während das System instabil/offen ist */
  html[data-nav-state="opening"] .nav-content-sync,
  html[data-nav-state="open"] .nav-content-sync {
    pointer-events: none;
    user-select: none;
  }

  html[data-nav-state="opening"] .nav-content-sync {
    animation: system-collapse 0.6s cubic-bezier(0.86, 0, 0.07, 1) forwards;
  }
  
  html[data-nav-state="open"] .nav-content-sync {
    opacity: 0; 
    filter: blur(20px); 
    transform: scale(0.95);
  }
  
  html[data-nav-state="closing"] .nav-content-sync {
    animation: system-reboot 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  html:not([data-nav-state]) .nav-content-sync {
    opacity: 1; 
    filter: blur(0px); 
    transform: scale(1); 
    pointer-events: auto;
  }

  /* ANIMATION: System-Kollaps beim Öffnen */
  @keyframes system-collapse {
    0% { opacity: 1; transform: scale(1) skewX(0deg); filter: blur(0) brightness(1); }
    15% { opacity: 0.8; transform: scale(1.02) skewX(5deg) translate3d(5px, 0, 0); filter: blur(1px) brightness(1.5) contrast(1.2); }
    30% { opacity: 0.3; transform: scale(0.98) skewX(-15deg) translate3d(-10px, 5px, 0); filter: invert(0.2) hue-rotate(45deg); }
    45% { opacity: 0.9; transform: scale(1.05) skewX(10deg); filter: brightness(2) contrast(1.5); }
    60% { opacity: 0; transform: scale(0.95); filter: blur(10px); }
    100% { opacity: 0; transform: scale(0.95); filter: blur(20px); }
  }

  /* ANIMATION: System-Reboot beim Schließen */
  @keyframes system-reboot {
    0% { opacity: 0; transform: scale(0.95); filter: blur(20px); }
    30% { opacity: 0.8; transform: scale(1.05) skewX(-10deg) translate3d(-5px, -2px, 0); filter: brightness(2) contrast(1.5) hue-rotate(-20deg); }
    50% { opacity: 0.3; transform: scale(0.98) skewX(15deg) translate3d(8px, 2px, 0); filter: invert(0.1); }
    70% { opacity: 1; transform: scale(1.01) skewX(-2deg); filter: brightness(1.2); }
    100% { opacity: 1; transform: scale(1) skewX(0deg); filter: blur(0) brightness(1) contrast(1); }
  }
</style>