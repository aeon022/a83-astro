
---
// Dateipfad: src/layouts/BaseLayout.astro
interface Props {
  title: string;
}

const { title, description = "ABTEILUNG83 - Less Noise. Nice Data. No Bloat." } = Astro.props;
---

<!doctype html>
<html lang="de" class="bg-[#050505] text-white selection:bg-neon-green selection:text-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | ABTEILUNG83</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --neon-green: #00ff41;
  }
  
  kbd {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Sanfter Glow für interaktive Elemente */
  .interactive-element:hover {
    filter: drop-shadow(0 0 8px rgba(0, 255, 65, 0.3));
    transition: filter 0.3s ease;
  }
</style>