---
// Dateipfad: frontend/src/layouts/BaseLayout.astro
// Version: V17.1 - OMNISCIENT RESTORE ENGINE + THEME PERSISTENCE + GLOBAL HUD
// Fixes: Theme-Flicker & Content Visibility Reset

import '../styles/global.css';
import Header from './Header.astro';
import Footer from '../components/blocks/Footer.astro';
import GlobalCursor from '../components/ui/GlobalCursor.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import CommandPalette from '../components/islands/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  isSnappable?: boolean;
}

const { 
  title, 
  description = "ABTEILUNG83 - Less Noise. Nice Data. No Bloat.", 
  isSnappable = false 
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | ABTEILUNG83</title>
    
    <script is:inline>
      (function() {
        // Always set dark or light class — dark: Tailwind utilities require a class, not just @media.
        // localStorage preference wins; otherwise follow system preference.
        const saved = localStorage.getItem('theme');
        const theme = (saved === 'dark' || saved === 'light')
          ? saved
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.add(theme);
        document.documentElement.setAttribute('data-nav-state', 'closed');

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (localStorage.getItem('theme')) return;
          document.documentElement.classList.remove('dark', 'light');
          document.documentElement.classList.add(e.matches ? 'dark' : 'light');
        });
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "ABTEILUNG83",
        "image": "https://abteilung83.at/og-preview.png",
        "@id": "https://abteilung83.at",
        "url": "https://abteilung83.at",
        "telephone": "+436605672361",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Steyrergasse 88/4",
          "addressLocality": "Graz",
          "postalCode": "8010",
          "addressCountry": "AT"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 47.0707,
          "longitude": 15.4395
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        "founder": {
          "@type": "Person",
          "name": "Gerwin Weiher"
        }
      }
    </script>
  </head>
  
  <body class="font-sans antialiased bg-a83-bg text-a83-text selection:bg-a83-accent selection:text-white transition-colors duration-500 flex flex-col h-screen overflow-hidden">
    
    <Header />

    <main 
      id="main-content" 
      data-snappable={isSnappable}
      class:list={[
        "flex-grow nav-content-sync w-full overflow-y-auto",
        { "snap-y snap-mandatory scroll-smooth hide-scrollbar": isSnappable }
      ]}
    >
        <div class="flex flex-col min-h-full">
            <div class="flex-grow">
                <slot />
            </div>

            {isSnappable ? (
              <section class="snap-start">
                <Footer />
              </section>
            ) : (
              <Footer />
            )}
        </div>
    </main>
    
    <GlobalCursor />
    <CookieBanner />
    <CommandPalette /> 
    <div id="glitch-overlay-node" aria-hidden="true"></div>

    <script>
      // A83 ADVANCED SCROLL RESTORATION ENGINE V16.5
      const getScrollKey = () => `a83_scroll_${window.location.pathname}`;

      const savePos = () => {
        const main = document.getElementById('main-content');
        if (main && (main.hasAttribute('data-snappable') || main.getAttribute('data-snappable') === 'true')) {
          sessionStorage.setItem(getScrollKey(), main.scrollTop.toString());
        }
      };

      const restorePos = () => {
        const main = document.getElementById('main-content');
        const saved = sessionStorage.getItem(getScrollKey());

        if (main && saved) {
          const scrollVal = parseInt(saved, 10);
          const snappable = main.getAttribute('data-snappable') === 'true';
          if (snappable) (main as HTMLElement).style.scrollSnapType = 'none';
          
          (main as HTMLElement).style.scrollBehavior = 'auto';
          main.scrollTop = scrollVal;

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (snappable) (main as HTMLElement).style.scrollSnapType = 'y mandatory';
              (main as HTMLElement).style.scrollBehavior = 'smooth';
            });
          });
        }
      };

      document.addEventListener('astro:before-preparation', (event) => {
        savePos();

        const originalLoader = (event as any).loader;
        (event as any).loader = async function() {
          const html = document.documentElement;
          if (html.getAttribute('data-nav-state') === 'open') {
             html.setAttribute('data-nav-state', 'closing');
          }

          const glitchNode = document.getElementById('glitch-overlay-node');
          if (glitchNode) {
            glitchNode.classList.add('glitch-out');
            await new Promise(resolve => setTimeout(resolve, 350));
          }
          
          await originalLoader();
        };
      });

      document.addEventListener('astro:after-swap', () => {
        restorePos();
        
        const glitchNode = document.getElementById('glitch-overlay-node');
        if (glitchNode) {
          glitchNode.classList.remove('glitch-out');
          glitchNode.classList.add('glitch-in');
          setTimeout(() => glitchNode.classList.remove('glitch-in'), 400);
        }
      });

      window.addEventListener('load', restorePos);

      document.addEventListener('DOMContentLoaded', () => {
        const glitchNode = document.getElementById('glitch-overlay-node');
        if (glitchNode) {
          glitchNode.classList.add('glitch-in');
          setTimeout(() => glitchNode.classList.remove('glitch-in'), 400);
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const link = target.closest('a');
        if (link && link.hash && link.pathname === window.location.pathname) {
          const main = document.getElementById('main-content');
          const targetEl = document.querySelector(link.hash);
          if (main && targetEl) {
            e.preventDefault();
            targetEl.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    </script>

  </body>
</html>

<style is:global>
  html, body {
    overflow: hidden !important;
    height: 100% !important;
    width: 100%;
  }

  #main-content {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  kbd {
    font-family: 'JetBrains Mono', monospace;
  }

  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .interactive-element:hover {
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--a83-accent) 40%, transparent));
    transition: filter 0.3s ease;
  }

  /* GSNSE - GLOBAL SPATIAL NAV SYNC ENGINE */
  html[data-nav-state="opening"] .nav-content-sync,
  html[data-nav-state="open"] .nav-content-sync {
    pointer-events: none;
    user-select: none;
  }

  html[data-nav-state="opening"] .nav-content-sync {
    animation: system-collapse 0.6s cubic-bezier(0.86, 0, 0.07, 1) forwards;
  }
  
  html[data-nav-state="open"] .nav-content-sync {
    opacity: 0; 
    filter: blur(20px); 
    transform: scale(0.95);
  }
  
  html[data-nav-state="closing"] .nav-content-sync {
    animation: system-reboot 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes system-collapse {
    0% { opacity: 1; transform: scale(1); filter: blur(0); }
    100% { opacity: 0; transform: scale(0.95); filter: blur(20px); }
  }

  @keyframes system-reboot {
    0% { opacity: 0; transform: scale(0.95); filter: blur(20px); }
    100% { opacity: 1; transform: scale(1); filter: blur(0); }
  }

  /* GLOBAL GLITCH TRANSITION ENGINE */
  #glitch-overlay-node {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: difference;
  }

  #glitch-overlay-node::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 255, 65, 0.15),
      rgba(0, 255, 65, 0.15) 2px,
      transparent 2px,
      transparent 4px
    );
    opacity: 0;
  }

  #glitch-overlay-node.glitch-out {
    animation: gpu-glitch-out 0.4s steps(4) forwards;
  }
  #glitch-overlay-node.glitch-out::after {
    animation: scanline-flash 0.4s forwards;
  }

  #glitch-overlay-node.glitch-in {
    animation: gpu-glitch-in 0.4s steps(4) forwards;
  }

  @keyframes gpu-glitch-out {
    0% { opacity: 0; background: transparent; }
    50% { opacity: 1; background: rgb(0, 255, 255); }
    100% { opacity: 1; background: rgb(200, 200, 200); }
  }

  @keyframes gpu-glitch-in {
    0% { opacity: 1; background: rgb(255, 255, 255); }
    100% { opacity: 0; background: transparent; }
  }

  @keyframes scanline-flash {
    0%, 100% { opacity: 0; }
    40%, 60% { opacity: 1; }
  }
</style>