---
// src/layouts/Header.astro
---
<header id="site-header">
  <div class="header-row flex justify-end items-center gap-6 w-full">
    
    <a href="/" class="brand-wordmark font-mono" data-text="const firma =&#xa;&quot;ABTEILUNG83&quot;;">
      const firma = "ABTEILUNG83";
    </a>

    <div class="burger-home-slot">
      <button id="nav-trigger" class="mech-burger" aria-label="Menü öffnen" aria-expanded="false">
        <div class="mech-lines">
          <span class="m-line m-top"></span>
          <span class="m-line m-mid"></span>
          <span class="m-line m-bot"></span>
        </div>
      </button>
    </div>
    
  </div>
</header>

<div id="nav-overlay" aria-hidden="true">
  <div class="nav-backdrop"></div>
  
  <div class="nav-card">
    <div class="card-accent-bar"></div>

    <div class="nav-head">
      <div class="flex flex-col gap-1">
        <h1 class="font-mono text-a83-text-bold text-xl tracking-widest uppercase">System_Menu</h1>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-a83-accent rounded-full animate-pulse shadow-[0_0_8px_var(--a83-accent)]"></span>
          <span class="font-mono text-[10px] text-a83-text uppercase tracking-widest opacity-80">Secure Connection Active</span>
        </div>
      </div>
      <div class="nav-close-slot">
        <button class="nav-close-btn" aria-label="Menü schließen">
          <span class="c-line c-1"></span>
          <span class="c-line c-2"></span>
        </button>
      </div>
    </div>
    
    <div class="nav-menu font-mono">
      <a href="/work" class="nav-link" data-title="[01_WORK]" data-hint="> open ./vault/portfolio"> [01_WORK] </a>
      <a href="/services" class="nav-link" data-title="[02_SERVICES]" data-hint="> execute services.sh"> [02_SERVICES] </a>
      <a href="/about" class="nav-link" data-title="[03_ABOUT]" data-hint="> read whoami.txt"> [03_ABOUT] </a>
      <a href="/contact" class="nav-link" data-title="[04_CONTACT]" data-hint="> init_connection()"> [04_CONTACT] </a>
    </div>
    
    <div id="nav-brandmark"></div>
  </div>
  
  <div class="nav-hint">
    <span style="color: var(--a83-accent); opacity: 0.9; margin-right: 8px; font-weight: bold;">root@a83:~ $</span> 
    <span id="hint-text" class="cmd" style="color: #ffffff; text-shadow: 0 0 10px rgba(255,255,255,0.5); font-weight: bold;"></span>
    <span class="animate-cursor-blink" style="color: var(--a83-accent); font-weight: bold;">_</span>
  </div>
</div>

<script>
  const trigger = document.getElementById('nav-trigger');
  const closeBtn = document.querySelector('.nav-close-btn');
  const overlay = document.getElementById('nav-overlay');
  const html = document.documentElement;
  const body = document.body;
  const links = document.querySelectorAll('.nav-link');
  const hintText = document.getElementById('hint-text');

  function openMenu() {
    trigger.setAttribute('aria-expanded', 'true');
    overlay.setAttribute('aria-hidden', 'false');
    html.setAttribute('data-nav-state', 'opening');
    
    html.classList.add('nav-lock');
    body.classList.add('nav-lock');
    
    setTimeout(() => {
      html.setAttribute('data-nav-state', 'open');
    }, 850);
  }

  function closeMenu() {
    trigger.setAttribute('aria-expanded', 'false');
    html.setAttribute('data-nav-state', 'closing');
    
    setTimeout(() => {
      overlay.setAttribute('aria-hidden', 'true');
      html.removeAttribute('data-nav-state');
      html.classList.remove('nav-lock');
      body.classList.remove('nav-lock');
    }, 400);
  }

  trigger?.addEventListener('click', () => {
    if (trigger.getAttribute('aria-expanded') === 'true') closeMenu();
    else openMenu();
  });
  closeBtn?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.getAttribute('aria-hidden') === 'false') {
      closeMenu();
    }
  });

  links.forEach(link => {
    link.addEventListener('mouseenter', (e) => {
      const hint = (e.target as HTMLElement).getAttribute('data-hint') || '';
      if(hintText) hintText.textContent = hint;
      overlay?.classList.add('hint-visible');
    });
    link.addEventListener('mouseleave', () => {
      overlay?.classList.remove('hint-visible');
    });
  });
</script>

<style is:global>
:root {
  --nav-bg: color-mix(in srgb, var(--a83-surface) 45%, transparent);
  --nav-backdrop: color-mix(in srgb, var(--deep-canvas) 92%, transparent);
}

.nav-lock { overflow: hidden !important; touch-action: none !important; }

#site-header { 
  position: fixed; top: 0; left: 0; right: 0; z-index: 40; 
  padding: 24px clamp(24px, 4vw, 40px); display: flex;
  justify-content: flex-end; align-items: center; pointer-events: none;
}
.header-row { pointer-events: auto; }

/* ==========================================
   1. WORDMARK (Ghost Glitch mit Slice)
   ========================================== */
.brand-wordmark {
  color: var(--a83-text); font-size: clamp(12px, 1.2vw, 14px);
  font-weight: 700; letter-spacing: 0.1em; text-decoration: none;
  position: relative; opacity: 0.8; transition: opacity 0.3s ease;
}
.brand-wordmark:hover { opacity: 1; }
.brand-wordmark:hover::before, .brand-wordmark:hover::after {
  content: attr(data-text); position: absolute; left: 50%; top: 50%; 
  transform: translate(-50%, -50%); pointer-events: none;
  opacity: 0.3; mix-blend-mode: screen; white-space: pre; line-height: 1.1;
  text-align: right; font-size: 1.1em; width: max-content;
  filter: blur(0.5px);
}

/* skewX schiebt die obere und untere Zeile in entgegengesetzte Richtungen! */
.brand-wordmark:hover::before { color: var(--a83-text-bold); animation: ghost-drift-1 2s steps(4) infinite; }
.brand-wordmark:hover::after { color: var(--a83-text); animation: ghost-drift-2 2s steps(4) infinite reverse; }

@keyframes ghost-drift-1 {
  0% { transform: translate(-50%, -50%) translate(2px, 1px) skewX(2deg); }
  33% { transform: translate(-50%, -50%) translate(-2px, -1px) skewX(-3deg); }
  66% { transform: translate(-50%, -50%) translate(1px, -2px) skewX(4deg); }
  100% { transform: translate(-50%, -50%) translate(0, 0) skewX(0deg); }
}
@keyframes ghost-drift-2 {
  0% { transform: translate(-50%, -50%) translate(-2px, -1px) skewX(-2deg); }
  33% { transform: translate(-50%, -50%) translate(1px, 2px) skewX(3deg); }
  66% { transform: translate(-50%, -50%) translate(-1px, 1px) skewX(-4deg); }
  100% { transform: translate(-50%, -50%) translate(0, 0) skewX(0deg); }
}

/* ==========================================
   2. MECHANICAL SLICE BURGER
   ========================================== */
.mech-burger {
  all: unset; display: flex; align-items: center; justify-content: center;
  width: 48px; height: 48px; cursor: pointer; color: var(--a83-text-bold);
  transition: color 0.3s ease;
}
.mech-burger:hover { color: var(--a83-accent); }

.mech-lines { width: 32px; height: 14px; position: relative; }
.m-line {
  position: absolute; height: 2px; background-color: currentColor; 
  left: 0; right: 0; transition: all 0.4s cubic-bezier(0.86, 0, 0.07, 1);
}
.m-top { top: 0; transform-origin: center; }
.m-mid { top: 6px; right: 8px; }
.m-bot { top: 12px; transform-origin: center; }

.mech-burger:hover .m-mid { right: 0; transform: translateX(4px); }

.mech-burger[aria-expanded="true"] .m-mid { opacity: 0; transform: translateX(20px); }
.mech-burger[aria-expanded="true"] .m-top { top: 6px; transform: rotate(45deg); background-color: var(--a83-accent); }
.mech-burger[aria-expanded="true"] .m-bot { top: 6px; transform: rotate(-45deg); background-color: var(--a83-accent); }

/* ==========================================
   3. OVERLAY & BACKDROP
   ========================================== */
#nav-overlay {
  position: fixed; inset: 0; z-index: 1000;
  display: none; pointer-events: none; opacity: 0;
}
#nav-overlay::before {
  content: ""; position: fixed; inset: 0; background: var(--nav-backdrop);
  opacity: 0; transition: opacity 0.5s ease;
}
#nav-overlay[aria-hidden="false"] { display: block; pointer-events: auto; opacity: 1; }

html[data-nav-state="opening"] #nav-overlay::before,
html[data-nav-state="open"] #nav-overlay::before { opacity: 1; backdrop-filter: blur(16px); }
html[data-nav-state="closing"] #nav-overlay::before { opacity: 0; }

/* ==========================================
   4. HOLO CARD
   ========================================== */
.nav-card {
  position: fixed !important;
  top: clamp(24px, 3vw, 40px) !important; 
  right: clamp(24px, 4vw, 40px) !important;
  width: min(480px, 90vw); 
  
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%);
  
  background-color: var(--nav-bg);
  background-image: radial-gradient(color-mix(in srgb, var(--a83-text) 15%, transparent) 1px, transparent 1px);
  background-size: 16px 16px;
  
  backdrop-filter: blur(20px) saturate(120%); 
  
  border: 1px solid color-mix(in srgb, var(--a83-accent) 40%, transparent);
  box-shadow: 
    0 20px 50px rgba(0,0,0,0.6),
    0 0 30px color-mix(in srgb, var(--a83-accent) 15%, transparent),
    inset 0 0 20px color-mix(in srgb, var(--a83-accent) 10%, transparent);
    
  z-index: 2; overflow: hidden;
  opacity: 0; transform: scaleY(0.005) scaleX(0); transform-origin: right top;
}

.card-accent-bar {
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background-color: var(--a83-accent);
  box-shadow: 0 0 20px var(--a83-accent);
}

html[data-nav-state="opening"] .nav-card {
  animation: crt-boot-slow 0.85s cubic-bezier(0.86, 0, 0.07, 1) forwards;
}
html[data-nav-state="open"] .nav-card {
  opacity: 1; transform: scaleY(1) scaleX(1);
}
html[data-nav-state="closing"] .nav-card {
  transition: transform 0.3s ease, opacity 0.3s ease;
  opacity: 0; transform: translateY(-20px) scale(0.98);
}

@keyframes crt-boot-slow {
  0% { transform: scaleY(0.005) scaleX(0); opacity: 1; }
  35% { transform: scaleY(0.005) scaleX(1); opacity: 1; } 
  100% { transform: scaleY(1) scaleX(1); opacity: 1; } 
}

/* ==========================================
   5. MENU & CLOSE BUTTON
   ========================================== */
.nav-head {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding: 32px 40px 24px; border-bottom: 1px solid color-mix(in srgb, var(--a83-accent) 20%, transparent);
}
.nav-close-btn {
  all: unset; display: flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; cursor: pointer; position: relative;
  border: 1px solid color-mix(in srgb, var(--a83-sub) 30%, transparent);
  transition: all 0.3s ease;
}
.c-line {
  position: absolute; width: 16px; height: 2px;
  background-color: var(--a83-text); transition: background-color 0.3s ease;
}
.c-1 { transform: rotate(45deg); }
.c-2 { transform: rotate(-45deg); }

.nav-close-btn:hover { border-color: var(--a83-accent); box-shadow: 0 0 10px color-mix(in srgb, var(--a83-accent) 30%, transparent); }
.nav-close-btn:hover .c-line { background-color: var(--a83-accent); }

.nav-menu { padding: 32px 40px 60px; display: grid; gap: 20px; position: relative; z-index: 2; }

.nav-menu > a {
  text-decoration: none; color: var(--a83-text); font-size: clamp(24px, 3.5vw, 32px); font-weight: 900;
  opacity: 0; transform: translateX(-20px); transition: opacity .4s ease, transform .4s ease;
  position: relative; display: inline-block; width: max-content;
}

html[data-nav-state="open"] .nav-menu > a { opacity: 1; transform: translateX(0); }
html[data-nav-state="open"] .nav-menu > *:nth-child(1) { transition-delay: .4s; }
html[data-nav-state="open"] .nav-menu > *:nth-child(2) { transition-delay: .5s; }
html[data-nav-state="open"] .nav-menu > *:nth-child(3) { transition-delay: .6s; }
html[data-nav-state="open"] .nav-menu > *:nth-child(4) { transition-delay: .7s; }

html[data-nav-state="closing"] .nav-menu > * { transition: opacity .2s, transform .2s; opacity: 0; transform: translateX(-10px); }

.nav-menu > a:hover { color: var(--a83-text-bold); text-shadow: 0 0 15px color-mix(in srgb, var(--a83-text-bold) 50%, transparent); }
.nav-menu > a:hover::before {
  content: attr(data-title); position: absolute; left: 2px; top: 0;
  color: var(--a83-accent); opacity: 0.6; z-index: -1;
  animation: glitch-link 0.3s steps(2) infinite;
}
@keyframes glitch-link { 0% { transform: translate(-1px, 1px); } 100% { transform: translate(1px, -1px); } }

/* ==========================================
   6. HINT & WATERMARK
   ========================================== */
.nav-hint {
  position: fixed !important; left: clamp(32px, 4vw, 48px) !important; bottom: clamp(32px, 4vh, 48px) !important;
  display: flex; font-family: 'JetBrains Mono', Courier, monospace; font-size: 14px; z-index: 10;
  opacity: 0; transform: translateY(10px); transition: opacity 0.3s ease, transform 0.3s ease;
}
#nav-overlay.hint-visible .nav-hint { opacity: 1; transform: translateY(0); }

/* Watermark weiter nach oben gerückt (bottom: 8%) */
#nav-brandmark {
  position: absolute; right: -5%; bottom: 8%; 
  width: 350px; aspect-ratio: 1/1; 
  background-image: url('/logo/logo-a83-white.svg');
  background-size: contain; background-repeat: no-repeat; background-position: right bottom;
  
  opacity: 0.02; 
  pointer-events: none; z-index: 0; mix-blend-mode: overlay;
  
  animation: holo-glitch 8s infinite;
}

@keyframes holo-glitch {
  0%, 100% { transform: translate(0, 0); opacity: 0.02; filter: blur(0px); }
  10% { transform: translate(1px, -1px); opacity: 0.03; filter: blur(1px); }
  11% { transform: translate(-1px, 1px); opacity: 0.01; }
  12% { transform: translate(0, 0); opacity: 0.02; }
  60% { transform: translate(0, 0); opacity: 0.02; }
  61% { transform: skewX(1deg); opacity: 0.04; }
  62% { transform: skewX(0deg); opacity: 0.02; }
}
</style>