---
// Dateipfad: frontend/src/layouts/Header.astro
// Version: V14.0 - SYNCED TACTICAL NAV
// Vibe: Spatial UI + Terminal HUD
---
<header id="site-header">
  <div class="header-row flex justify-end items-center gap-6 w-full">
    
    <a href="/" class="brand-wordmark font-mono" data-text="const firma =&#xa;&quot;ABTEILUNG83&quot;;">
      const firma = "ABTEILUNG83";
    </a>

    <div class="burger-home-slot">
      <button id="nav-trigger" class="mech-burger" aria-label="Menü öffnen" aria-expanded="false">
        <div class="mech-lines">
          <span class="m-line m-top"></span>
          <span class="m-line m-mid"></span>
          <span class="m-line m-bot"></span>
        </div>
      </button>
    </div>
    
  </div>
</header>

<div id="nav-overlay" aria-hidden="true">
  <div class="spatial-backdrop"></div>
  
  <img id="spatial-media-layer" src="" alt="" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000 mix-blend-overlay z-0 pointer-events-none" />

  <div class="spatial-grid">
    
    <nav class="flex flex-col justify-center h-full gap-2 relative z-10 w-full md:w-auto">
      <a href="/work" class="spatial-link group" data-img="/images/nav-work.webp" data-hint="> Accessing vault/portfolio...&#xa;> 14 entries found.&#xa;> Awaiting selection.">
        <span class="spatial-num">01</span>
        <span class="spatial-text">Work</span>
      </a>
      <a href="/services" class="spatial-link group" data-img="/images/nav-services.webp" data-hint="> Scanning tech-stack & modules...&#xa;> High-Performance nodes available.&#xa;> Clearance level verified.">
        <span class="spatial-num">02</span>
        <span class="spatial-text">Services</span>
      </a>
      <a href="/process" class="spatial-link group" data-img="/images/nav-process.webp" data-hint="> Loading standard operating procedures...&#xa;> Zero Bloat directive active.&#xa;> Execution path ready.">
        <span class="spatial-num">03</span>
        <span class="spatial-text">Process</span>
      </a>
      <a href="/blog" class="spatial-link group" data-img="/images/nav-blog.webp" data-hint="> Fetching latest system logs and intel...&#xa;> Decrypting data packets...&#xa;> 100% complete.">
        <span class="spatial-num">04</span>
        <span class="spatial-text">Log</span>
      </a>
      <a href="/about" class="spatial-link group" data-img="/images/nav-about.webp" data-hint="> cat whoami.txt&#xa;> Entity: ABTEILUNG83&#xa;> Mission: Less Noise. Nice Data.">
        <span class="spatial-num">05</span>
        <span class="spatial-text">About</span>
      </a>
    </nav>

    <div class="flex flex-col justify-end pb-8 h-full relative z-10 font-mono text-bone-white pointer-events-auto w-full md:w-80 gap-10">
      
      <div class="hidden md:block">
        <span class="block text-[10px] text-veranda-green uppercase tracking-widest mb-4 border-b border-veranda-green/20 pb-2">// TERMINAL_OUTPUT</span>
        <div class="console-output text-sm leading-relaxed text-bone-white/80 min-h-[80px] flex flex-col justify-end">
          <div id="hint-text" class="whitespace-pre-wrap">> System idle.&#xa;> Awaiting input...</div>
          <div class="mt-2 text-a83-accent text-xs">
            <span class="font-bold mr-2">root@a83:~ $</span>
            <span class="animate-cursor-blink bg-a83-accent w-2 h-3 inline-block align-middle"></span>
          </div>
        </div>
      </div>

      <div>
        <span class="block text-[10px] text-veranda-green uppercase tracking-widest mb-4 border-b border-veranda-green/20 pb-2">// EXECUTABLES</span>
        <div class="flex flex-col gap-4">
          <a href="/#roi-calculator" class="spatial-action flex items-center gap-3 text-sm hover:text-a83-accent transition-colors group" data-hint="> Execute /sys/calc/roi_simulator.sh&#xa;> Booting projection engine...&#xa;> Ready for input.">
            <span class="w-2 h-2 border border-current group-hover:bg-a83-accent transition-colors"></span>
            ROI_CALCULATOR.sh
          </a>
          <a href="/contact" class="spatial-action flex items-center gap-3 text-sm hover:text-a83-accent transition-colors group" data-hint="> init_connection()&#xa;> Establishing secure handshake...&#xa;> Ping: 12ms. Ready.">
            <span class="w-2 h-2 border border-current bg-bone-white group-hover:bg-a83-accent transition-colors"></span>
            INIT_CONNECTION()
          </a>
        </div>
      </div>

      <div class="hidden md:block">
        <span class="block text-[10px] text-veranda-green uppercase tracking-widest mb-4 border-b border-veranda-green/20 pb-2">// SYS_STATUS</span>
        <div class="text-xs space-y-2 opacity-60">
          <div class="flex justify-between gap-8"><span>Node:</span> <span>A83-Main</span></div>
          <div class="flex justify-between gap-8"><span>Uptime:</span> <span>99.99%</span></div>
          <div class="flex justify-between gap-8"><span>Latency:</span> <span class="text-a83-accent">12ms</span></div>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  const trigger = document.getElementById('nav-trigger');
  const overlay = document.getElementById('nav-overlay');
  const html = document.documentElement;
  const body = document.body;
  const navLinks = document.querySelectorAll('.spatial-link');
  const actionLinks = document.querySelectorAll('.spatial-action');
  const allLinks = [...navLinks, ...actionLinks];
  
  const mediaLayer = document.getElementById('spatial-media-layer');
  const hintText = document.getElementById('hint-text');
  const defaultHint = "> System idle.\n> Awaiting input...";

  function openMenu() {
    if (trigger) trigger.setAttribute('aria-expanded', 'true');
    if (overlay) overlay.setAttribute('aria-hidden', 'false');
    
    // Phase 1: Glitch-Collapse starten
    html.setAttribute('data-nav-state', 'opening');
    html.classList.add('nav-lock');
    body.classList.add('nav-lock');
    
    // Phase 2: Nach 600ms (CSS-Dauer) in den statischen "Open" Zustand
    setTimeout(() => {
      html.setAttribute('data-nav-state', 'open');
    }, 600); 
  }

  function closeMenu() {
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
    
    // Phase 1: Glitch-Reboot starten
    html.setAttribute('data-nav-state', 'closing');
    
    // Phase 2: Nach 500ms (CSS-Dauer) Attribute entfernen
    setTimeout(() => {
      if (overlay) overlay.setAttribute('aria-hidden', 'true');
      html.removeAttribute('data-nav-state');
      html.classList.remove('nav-lock');
      body.classList.remove('nav-lock');
    }, 500); 
  }

  if (trigger) {
    trigger.addEventListener('click', () => {
      if (trigger.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });
  }

  // Schließen bei Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay && overlay.getAttribute('aria-hidden') === 'false') {
      closeMenu();
    }
  });

  // Link Hover Effekte (Media & Hint)
  allLinks.forEach(link => {
    link.addEventListener('mouseenter', (e) => {
      const target = e.currentTarget;
      const imgSrc = target.getAttribute('data-img');
      const hint = target.getAttribute('data-hint') || '';

      if (mediaLayer && imgSrc) {
        mediaLayer.src = imgSrc;
        mediaLayer.classList.remove('opacity-0');
        mediaLayer.classList.add('opacity-40');
      }

      if (hintText) {
        hintText.innerHTML = ''; 
        hintText.classList.remove('typing-effect');
        void hintText.offsetWidth; 
        
        setTimeout(() => {
          hintText.textContent = hint;
          hintText.classList.add('typing-effect');
        }, 30);
      }
    });
    
    link.addEventListener('mouseleave', () => {
      if (mediaLayer) {
        mediaLayer.classList.remove('opacity-40');
        mediaLayer.classList.add('opacity-0');
      }

      if (hintText) {
        hintText.textContent = defaultHint;
        hintText.classList.remove('typing-effect');
      }
    });
  });
</script>

<style is:global>
.nav-lock { overflow: hidden !important; touch-action: none !important; }

#site-header { 
  position: fixed; top: 0; left: 0; right: 0; z-index: 2000;
  padding: 24px clamp(24px, 4vw, 40px); display: flex;
  justify-content: flex-end; align-items: center; pointer-events: none;
  background: transparent !important;
  mix-blend-mode: difference;
  color: #ffffff;
}
.header-row { pointer-events: auto; }

.brand-wordmark, .mech-burger {
  color: currentColor !important;
  transition: opacity 0.3s ease, color 0.3s ease;
}

html[data-nav-state="open"] #site-header,
html[data-nav-state="opening"] #site-header { mix-blend-mode: normal; }

html[data-nav-state="open"] .brand-wordmark,
html[data-nav-state="opening"] .brand-wordmark,
html[data-nav-state="open"] .mech-burger,
html[data-nav-state="opening"] .mech-burger { color: var(--bone-white) !important; }

/* Wordmark Glitch-Ghosting */
.brand-wordmark { font-size: clamp(12px, 1.2vw, 14px); font-weight: 700; letter-spacing: 0.1em; text-decoration: none; position: relative; }
.brand-wordmark:hover { opacity: 0.7; }
.brand-wordmark:hover::before, .brand-wordmark:hover::after {
  content: attr(data-text); position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); pointer-events: none;
  opacity: 0.4; mix-blend-mode: screen; white-space: pre; line-height: 1.1; text-align: right; font-size: 1.1em; width: max-content; filter: blur(0.5px);
}
.brand-wordmark:hover::before { color: var(--a83-accent); animation: ghost-drift-1 2s steps(4) infinite; }
.brand-wordmark:hover::after { color: var(--a83-accent); animation: ghost-drift-2 2s steps(4) infinite reverse; }

@keyframes ghost-drift-1 { 0% { transform: translate(-50%, -50%) translate(2px, 1px) skewX(2deg); } 33% { transform: translate(-50%, -50%) translate(-2px, -1px) skewX(-3deg); } 66% { transform: translate(-50%, -50%) translate(1px, -2px) skewX(4deg); } 100% { transform: translate(-50%, -50%) translate(0, 0) skewX(0deg); } }
@keyframes ghost-drift-2 { 0% { transform: translate(-50%, -50%) translate(-2px, -1px) skewX(-2deg); } 33% { transform: translate(-50%, -50%) translate(1px, 2px) skewX(3deg); } 66% { transform: translate(-50%, -50%) translate(-1px, 1px) skewX(-4deg); } 100% { transform: translate(-50%, -50%) translate(0, 0) skewX(0deg); } }

/* Mech-Burger Menu Button */
.mech-burger { all: unset; display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; cursor: pointer; }
.mech-burger:hover { color: var(--a83-accent) !important; }
.mech-lines { width: 32px; height: 14px; position: relative; }
.m-line { position: absolute; height: 2px; background-color: currentColor; left: 0; right: 0; transition: all 0.4s cubic-bezier(0.86, 0, 0.07, 1); }
.m-top { top: 0; transform-origin: center; }
.m-mid { top: 6px; right: 8px; }
.m-bot { top: 12px; transform-origin: center; }

.mech-burger:hover .m-mid { right: 0; transform: translateX(4px); }
#nav-trigger[aria-expanded="true"] .m-mid { opacity: 0; transform: translateX(20px); }
#nav-trigger[aria-expanded="true"] .m-top { top: 6px; transform: rotate(45deg); }
#nav-trigger[aria-expanded="true"] .m-bot { top: 6px; transform: rotate(-45deg); }

#nav-overlay {
  position: fixed; inset: 0; z-index: 1000;
  display: none; opacity: 0; pointer-events: none;
}
#nav-overlay[aria-hidden="false"] { display: block; opacity: 1; pointer-events: auto; }

.spatial-backdrop {
  position: absolute; inset: 0;
  backdrop-filter: blur(0px) brightness(1);
  background: rgba(0, 0, 0, 0);
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: -1;
}

html[data-nav-state="opening"] .spatial-backdrop,
html[data-nav-state="open"] .spatial-backdrop {
  backdrop-filter: blur(40px) brightness(0.5); 
  background: var(--deep-canvas); 
  opacity: 0.95;
}

.spatial-grid {
  position: relative;
  width: 100%; height: 100%;
  display: flex; flex-direction: column; justify-content: space-between;
  padding: clamp(32px, 8vw, 100px) clamp(24px, 5vw, 60px);
  opacity: 0; transform: scale(1.02);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

@media (min-width: 768px) {
  .spatial-grid { flex-direction: row; align-items: center; }
}

html[data-nav-state="opening"] .spatial-grid,
html[data-nav-state="open"] .spatial-grid {
  opacity: 1; transform: scale(1);
  transition-delay: 0.1s;
}

.spatial-link {
  display: flex; align-items: center; gap: clamp(16px, 2vw, 32px);
  text-decoration: none;
  opacity: 0; transform: translateX(-40px);
  transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

html[data-nav-state="open"] .spatial-link { opacity: 1; transform: translateX(0); }
html[data-nav-state="open"] .spatial-link:nth-child(1) { transition-delay: 0.1s; }
html[data-nav-state="open"] .spatial-link:nth-child(2) { transition-delay: 0.15s; }
html[data-nav-state="open"] .spatial-link:nth-child(3) { transition-delay: 0.2s; }
html[data-nav-state="open"] .spatial-link:nth-child(4) { transition-delay: 0.25s; }
html[data-nav-state="open"] .spatial-link:nth-child(5) { transition-delay: 0.3s; }

.spatial-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: clamp(12px, 1.5vw, 16px);
  color: var(--veranda-green);
  opacity: 0.5;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
  transition: color 0.4s ease;
}

.spatial-text {
  font-family: 'Inter', sans-serif;
  font-size: clamp(60px, 10vw, 140px);
  font-weight: 900;
  letter-spacing: -0.03em;
  line-height: 0.85;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 1px rgba(228, 232, 223, 0.2);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
}

.spatial-link:hover .spatial-text {
  color: var(--bone-white);
  -webkit-text-stroke: 0px transparent;
  transform: translateX(2vw);
  text-shadow: 0 0 40px rgba(255,255,255,0.15);
}

.spatial-link:hover .spatial-num {
  color: var(--a83-accent);
  opacity: 1;
}

.typing-effect {
  overflow: hidden;
  display: inline-block;
  white-space: pre-wrap;
  animation: typing 0.4s steps(30, end) forwards;
}

@keyframes typing {
  from { clip-path: inset(0 100% 0 0); }
  to { clip-path: inset(0 0 0 0); }
}
</style>