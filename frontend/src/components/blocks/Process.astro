---
// Dateipfad: frontend/src/components/blocks/Process.astro
// Vibe: Technical, "Neonlicht im Regen"
// Tech: Astro + Tailwind v4 + Keystatic 
// FIX: Supernova Hold-Phase (Text-Impact verlängert), Taboo Zones Restored

const bentoItems = Array.from({ length: 8 });

const codeSnippets = [
  "const architecture = new System({ core: 'A83' });",
  "interface UINode { id: string; state: 'active' | 'idle'; }",
  "function synthesis(brief: Briefing): Schema { ... }",
  "deploy.pipeline.push(optimization_step);",
  "while (isDesigning) { refine(visuals); }",
  "export default defineProject({ title: 'NextGen' });",
  "const vNode = h('div', { class: 'bento-grid' });",
  "git commit -m 'feat: neural-ui-scaling';",
  "await architecture.validate(blueprint);"
];
---

<section id="process" class="nav-content-sync relative bg-a83-bg border-t border-black/5 dark:border-white/10 transition-colors duration-500 [overflow-x:clip]">
  <div class="max-w-[1800px] mx-auto relative flex flex-col-reverse lg:flex-row">
    
    <div class="w-full lg:w-1/2 relative z-20 pb-40 lg:pt-20 lg:pb-60 px-6 lg:px-16 flex flex-col gap-[10vh] lg:gap-[80vh]">
      
      <div class="step-trigger mb-32 lg:mb-0 pt-10 lg:pt-20 min-h-[60vh] flex flex-col justify-center" data-step="0">
         <div class="flex items-center gap-4 mb-6">
            <span class="w-2 h-2 bg-a83-accent shadow-[0_0_8px_var(--a83-accent)]"></span>
            <span class="font-mono text-xs text-black/50 dark:text-white/50 uppercase tracking-[0.4em] font-bold transition-colors">// EXECUTION_PIPELINE</span>
         </div>
         <h2 class="text-5xl md:text-7xl font-black text-black dark:text-white tracking-tighter mb-6 transition-colors duration-500">
            The Compile<br>
            <span class="text-transparent" style="-webkit-text-stroke: 1.5px var(--a83-accent);">Protocol.</span>
         </h2>
         <p class="text-xl text-black/60 dark:text-white/60 max-w-md transition-colors duration-500">
           Vom Rohdaten-Chaos zum High-Performance Asset. Unser Prozess ist eine präzise Pipeline ohne Bloat.
         </p>
         <div class="mt-8 flex gap-4">
           <div class="font-mono text-xs text-a83-accent bg-a83-accent/10 px-3 py-1 rounded border border-a83-accent/20 animate-pulse">> SYSTEM_READY</div>
         </div>
      </div>

      <div class="lg:hidden h-[10vh]"></div>

      <div class="step-trigger group min-h-[90vh] lg:min-h-auto flex flex-col justify-center" data-step="1">
        <div class="font-mono text-a83-accent text-sm mb-4 tracking-widest opacity-60 group-hover:opacity-100 transition-opacity">01_INIT_PROTOCOL</div>
        <h3 class="text-3xl md:text-4xl font-black text-black dark:text-white mb-6 group-hover:translate-x-4 transition-transform duration-500 transition-colors">Discovery &<br>Briefing</h3>
        <p class="text-lg text-black/60 dark:text-white/60 max-w-sm leading-relaxed border-l-2 border-black/10 dark:border-white/10 pl-6 group-hover:border-a83-accent transition-colors duration-500">
          Wir definieren Ziele, nicht Wünsche. Wir schärfen den Scope und priorisieren Tasks für maximale Effizienz.
        </p>
        <code class="block mt-6 text-xs text-black/50 dark:text-white/50 font-mono bg-black/5 dark:bg-white/5 p-3 rounded w-fit transition-colors">fn init_details() -> scoped</code>
      </div>

      <div class="step-trigger group min-h-[90vh] lg:min-h-auto flex flex-col justify-center" data-step="2">
        <div class="font-mono text-a83-accent text-sm mb-4 tracking-widest opacity-60 group-hover:opacity-100 transition-opacity">02_VISUAL_SYNTHESIS</div>
        <h3 class="text-3xl md:text-4xl font-black text-black dark:text-white mb-6 group-hover:translate-x-4 transition-transform duration-500 transition-colors">Design &<br>Architecture</h3>
        <p class="text-lg text-black/60 dark:text-white/60 max-w-sm leading-relaxed border-l-2 border-black/10 dark:border-white/10 pl-6 group-hover:border-a83-accent transition-colors duration-500">
          Wireframe zu UI. Wir entwickeln visuelle Vokabulare, die skalieren. "Clean-Neon" Ästhetik statt überladener Deko.
        </p>
        <code class="block mt-6 text-xs text-black/50 dark:text-white/50 font-mono bg-black/5 dark:bg-white/5 p-3 rounded w-fit transition-colors">const style = "systematic"</code>
      </div>

      <div class="step-trigger group min-h-[150vh] lg:min-h-auto flex flex-col justify-center" data-step="3">
        <div class="font-mono text-a83-accent text-sm mb-4 tracking-widest opacity-60 group-hover:opacity-100 transition-opacity">03_HARD_COMPILE</div>
        <h3 class="text-3xl md:text-4xl font-black text-black dark:text-white mb-6 group-hover:translate-x-4 transition-transform duration-500 transition-colors">Development &<br>Build</h3>
        <p class="text-lg text-black/60 dark:text-white/60 max-w-sm leading-relaxed border-l-2 border-black/10 dark:border-white/10 pl-6 group-hover:border-a83-accent transition-colors duration-500">
          Wir schreiben Code, den Maschinen lieben. Zero JS by Default oder CMS mit Custom Designs.
        </p>
        <code class="block mt-6 text-xs text-black/50 dark:text-white/50 font-mono bg-black/5 dark:bg-white/5 p-3 rounded w-fit transition-colors">npm run build --prod</code>
      </div>

      <div class="step-trigger group min-h-[90vh] lg:min-h-auto flex flex-col justify-center" data-step="4">
        <div class="font-mono text-a83-accent text-sm mb-4 tracking-widest opacity-60 group-hover:opacity-100 transition-opacity">04_ORBITAL_LAUNCH</div>
        <h3 class="text-3xl md:text-4xl font-black text-black dark:text-white mb-6 group-hover:translate-x-4 transition-transform duration-500 transition-colors">Deploy &<br>Tracking</h3>
        <p class="text-lg text-black/60 dark:text-white/60 max-w-sm leading-relaxed border-l-2 border-black/10 dark:border-white/10 pl-6 group-hover:border-a83-accent transition-colors duration-500">
          Dynamisches Deployment. Wir skalieren die Infrastruktur nach Bedarf – vom dedizierten Local-Node bis zum Cloudflare-Edge. Immer automatisiert via CI/CD, immer kompromisslos schnell.
        </p>
        <code class="block mt-6 text-xs text-black/50 dark:text-white/50 font-mono bg-black/5 dark:bg-white/5 p-3 rounded w-fit transition-colors">fn protocol_ship_details()</code>
      </div>

    </div>

    <div class="w-full lg:w-1/2 h-[45vh] lg:h-screen sticky top-16 lg:top-0 z-10 lg:z-auto flex items-center justify-center pointer-events-none lg:pointer-events-auto mix-blend-hard-light lg:mix-blend-normal">
      
      <div class="hidden lg:block absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.03)_1px,transparent_1px)] dark:bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:40px_40px] transition-colors duration-500"></div>
      
      <div id="process-core" class="relative w-[400px] h-[400px] transition-all duration-700 ease-out preserve-3d scale-[0.55] lg:scale-100 origin-center lg:origin-center" data-state="0">
        
        <div class="core-aftermath absolute inset-[-50%] pointer-events-none opacity-0 transition-opacity duration-1000">
            <div class="absolute inset-0 bg-[conic-gradient(from_0deg,transparent_0deg,var(--a83-accent)_20deg,transparent_40deg,transparent_100deg,var(--a83-accent)_140deg,transparent_180deg)] opacity-10 animate-spin-slow rounded-full blur-2xl"></div>
        </div>

        {/* LAYER 0: INGEST */}
        <div class="core-layer layer-ingest absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-500">
          <div class="w-full h-1 bg-white/5 mb-4 relative overflow-hidden">
             <div class="absolute inset-0 bg-a83-accent animate-ingest-progress"></div>
          </div>
          <div class="font-mono text-[10px] text-a83-accent flex flex-col gap-1 items-center">
             <span class="animate-pulse">COMPILING_CORE_ASSETS...</span>
             <span id="hex-process" class="opacity-40 tracking-widest font-bold">0x00 0x83 0xFF</span>
          </div>
        </div>
        
        {/* LAYER 1: DISCOVERY RADAR */}
        <div class="core-layer layer-noise absolute inset-0 flex flex-wrap gap-2 items-center justify-center opacity-0 transition-opacity duration-500">
           <div class="radar-scanner absolute inset-0 rounded-full border border-a83-accent/20 animate-radar-sweep">
              <div class="absolute inset-0 rounded-full bg-[conic-gradient(from_0deg,var(--a83-accent)_0deg,transparent_90deg)] opacity-10"></div>
              <div class="absolute top-[20%] left-[30%] w-1.5 h-1.5 bg-a83-accent rounded-full animate-ping opacity-0 radar-point transition-opacity duration-500"></div>
              <div class="absolute top-[60%] left-[70%] w-1.5 h-1.5 bg-a83-accent rounded-full animate-ping opacity-0 radar-point transition-opacity duration-500 [animation-delay:1s]"></div>
           </div>
        </div>

        {/* LAYER 2: BLUEPRINT (Architecture Mode) */}
        <div class="core-layer layer-blueprint absolute inset-0 border border-a83-accent/30 bg-a83-accent/[0.02] opacity-0 transition-opacity duration-500 rotate-12 scale-90 flex flex-col p-6 shadow-[0_0_40px_rgba(0,0,0,0.2)] overflow-hidden">
           <div class="absolute top-4 right-4 flex items-center gap-2 z-30">
              <span class="w-1.5 h-1.5 bg-a83-accent rounded-full animate-architect-blink shadow-[0_0_8px_var(--a83-accent)]"></span>
              <span class="font-mono text-[7px] text-a83-accent uppercase tracking-widest opacity-80 font-bold">Architect_Mode: Active</span>
           </div>
           <div class="absolute inset-0 z-0 opacity-[0.07] pointer-events-none select-none font-mono text-[6px] p-4 mask-vertical-fade">
              <div class="animate-code-stream flex flex-col gap-2">
                 {[...codeSnippets, ...codeSnippets].map(line => (
                    <span class="whitespace-nowrap text-a83-accent">{line}</span>
                 ))}
              </div>
           </div>
           <div class="flex justify-between items-start mb-6 relative z-10">
              <div class="w-10 h-10 border border-a83-accent/50 flex items-center justify-center font-black text-[10px] text-a83-accent bg-a83-bg/50 backdrop-blur-sm">A83</div>
              <div class="flex flex-col gap-1 items-end">
                 <div class="h-1 w-20 bg-a83-accent/40 bento-element opacity-0 transition-all duration-500"></div>
                 <div class="h-1 w-12 bg-a83-accent/20 bento-element opacity-0 transition-all duration-500 delay-100"></div>
              </div>
           </div>
           <div class="grid grid-cols-3 gap-2 flex-1 relative z-10">
              {bentoItems.map((_, i) => (
                 <div 
                   style={`transition-delay: ${200 + i * 50}ms`}
                   class="border border-a83-accent/20 bg-a83-bg/80 backdrop-blur-sm p-2 flex flex-col gap-1 relative overflow-hidden bento-element opacity-0 translate-y-4 transition-all duration-500"
                 >
                    <div class="h-1 w-full bg-a83-accent/20"></div>
                    <div class="h-1 w-2/3 bg-a83-accent/10"></div>
                    <div class="absolute bottom-1 right-1 font-mono text-[4px] text-a83-accent/30">MOD_{i}</div>
                 </div>
              ))}
           </div>
        </div>
        
        {/* LAYER 3: BUILD (Terminal) */}
        <div class="core-layer layer-build absolute inset-0 bg-[#1e1e1e] border border-white/10 opacity-0 transition-opacity duration-500 shadow-2xl flex flex-col">
          <div class="h-6 bg-[#2d2d2d] w-full flex items-center px-3 gap-1 border-b border-white/5">
            <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
            <div class="ml-2 text-[9px] font-mono text-white/30 tracking-widest">TERM_ROOT // A83</div>
          </div>
          <div class="flex-1 p-4 font-mono text-[11px] md:text-xs leading-loose text-green-400 overflow-hidden relative">
            <div class="absolute inset-0 bg-green-500/5 pointer-events-none"></div>
            <span id="typewriter-output"></span>
            <span class="animate-pulse bg-green-400 text-black px-0.5 ml-1"> </span>
          </div>
        </div>
        
        {/* LAYER 4: SHIP */}
        <div class="core-layer layer-ship absolute inset-0 rounded-full bg-black dark:bg-white opacity-0 transition-opacity duration-500 scale-50">
           <div class="absolute inset-0 rounded-full bg-black dark:bg-white blur-xl opacity-20 dark:opacity-50 animate-pulse"></div>
           <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-a83-accent to-transparent opacity-90 mix-blend-overlay"></div>
           <div class="absolute inset-0 flex items-center justify-center">
             <span id="ship-status-text" class="font-black text-white dark:text-black tracking-widest text-xl transition-all">GO_LIVE</span>
           </div>
        </div>

      </div>
    </div>
  </div>

  {/* SUPERNOVA OVERLAY */}
  <div id="supernova-overlay" style="display: none;" class="fixed inset-0 w-full h-full z-[999999] pointer-events-none items-center justify-center overflow-hidden top-0 left-0">
      <div id="supernova-invert" class="absolute inset-0 backdrop-invert opacity-0"></div>
      <div id="supernova-bg" class="absolute inset-0 bg-a83-accent opacity-0 mix-blend-hard-light"></div>
      <div id="supernova-text" class="relative z-10 text-white dark:text-black font-black text-4xl md:text-7xl tracking-tighter opacity-0 scale-50">DEPLOYMENT_SUCCESS</div>
      <div id="supernova-ring" class="absolute w-[50px] h-[50px] rounded-full border-[20px] border-white dark:border-black opacity-0 scale-0 origin-center"></div>
  </div>

</section>

<style is:global>
  .preserve-3d { transform-style: preserve-3d; perspective: 1000px; }
  .writing-vertical { writing-mode: vertical-rl; text-orientation: mixed; }
  
  [data-state="0"] .layer-ingest { opacity: 1; transform: scale(1); }
  [data-state="1"] .layer-noise { opacity: 1; }
  [data-state="1"] .radar-point { opacity: 1; }
  [data-state="2"] .layer-blueprint { opacity: 1; transform: rotateX(20deg) rotateY(-20deg) scale(1); }
  [data-state="2"] .bento-element { opacity: 1; translate: 0 0; }
  [data-state="3"] .layer-build { opacity: 1; transform: scale(1.1); box-shadow: 0 0 30px rgba(0,255,100,0.1); }
  [data-state="4"] .layer-ship { opacity: 1; transform: scale(1); box-shadow: 0 0 50px rgba(0,0,0,0.2), 0 0 100px var(--a83-accent); }

  @keyframes ingest-progress { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  .animate-ingest-progress { animation: ingest-progress 2s linear infinite; }
  @keyframes radar-sweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .animate-radar-sweep { animation: radar-sweep 6s linear infinite; }
  @keyframes architect-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  .animate-architect-blink { animation: architect-blink 1s ease-in-out infinite; }
  @keyframes code-stream { 0% { transform: translateY(0); } 100% { transform: translateY(-50%); } }
  .animate-code-stream { animation: code-stream 20s linear infinite; }
  .mask-vertical-fade { mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent); }

  /* SUPERNOVA KEYFRAMES - EXTENDED */
  .run-invert-shock { animation: invert-shock 0.4s ease-in-out forwards; }
  .run-flash-bg { animation: flash-bg 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .run-text-pop { animation: text-pop 3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
  .run-shock-ring { animation: shock-ring 1s ease-out forwards; }
  
  @keyframes invert-shock { 0% { backdrop-filter: invert(0); opacity: 0; } 10% { backdrop-filter: invert(1); opacity: 1; } 100% { backdrop-filter: invert(0); opacity: 0; } }
  @keyframes flash-bg { 0% { opacity: 0; } 10% { opacity: 1; } 100% { opacity: 0; } }
  
  @keyframes text-pop { 
    0% { opacity: 0; transform: scale(0.5); letter-spacing: -0.1em; } 
    10% { opacity: 1; transform: scale(1.1); letter-spacing: 0.1em; } 
    80% { opacity: 1; transform: scale(1.15); letter-spacing: 0.15em; filter: blur(0px); } 
    100% { opacity: 0; transform: scale(1.5); letter-spacing: 0.5em; filter: blur(20px); } 
  }
  
  @keyframes shock-ring { 0% { transform: scale(0); opacity: 1; border-width: 50px; } 100% { transform: scale(20); opacity: 0; border-width: 0px; } }
</style>

<script>
  const core = document.getElementById('process-core');
  const hexElement = document.getElementById('hex-process');
  const triggers = document.querySelectorAll('.step-trigger');
  const shipText = document.getElementById('ship-status-text');
  const overlay = document.getElementById('supernova-overlay');
  if (overlay && document.body) { document.body.appendChild(overlay); }

  const invert = document.getElementById('supernova-invert');
  const bg = document.getElementById('supernova-bg');
  const text = document.getElementById('supernova-text');
  const ring = document.getElementById('supernova-ring');
  let hasFiredSupernova = false;

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const step = entry.target.getAttribute('data-step');
        if (core && step) {
          core.setAttribute('data-state', step);
          if (step === '4' && !hasFiredSupernova && overlay) {
            hasFiredSupernova = true;
            overlay.style.display = 'flex';
            requestAnimationFrame(() => {
                if(invert) { invert.classList.remove('run-invert-shock'); void invert.offsetWidth; invert.classList.add('run-invert-shock'); }
                if(bg) { bg.classList.remove('run-flash-bg'); void bg.offsetWidth; bg.classList.add('run-flash-bg'); }
                if(text) { text.classList.remove('run-text-pop'); void text.offsetWidth; text.classList.add('run-text-pop'); }
                if(ring) { ring.classList.remove('run-shock-ring'); void ring.offsetWidth; ring.classList.add('run-shock-ring'); }
            });
            setTimeout(() => { core.classList.add('is-deployed'); if (shipText) shipText.innerText = "ONLINE"; }, 800);
            // Overlay Cleanup nach 4 Sekunden (passend zum 3s Animation Hold + Fade)
            setTimeout(() => { overlay.style.display = 'none'; }, 4000);
          } else if (step === '2') {
            hasFiredSupernova = false; core.classList.remove('is-deployed');
          }
        }
      }
    });
  }, { rootMargin: '-30% 0px -30% 0px', threshold: 0 });
  triggers.forEach(t => observer.observe(t));

  const terminalElement = document.getElementById('typewriter-output');
  const sequence = [{ text: "sndmsg tomlinson@bbn-tenexa", action: 'type', speed: 50 }, { action: 'wait', speed: 400 }, { action: 'break' }, { text: "CONTENT: QWERTYUIOP", action: 'type', speed: 80 }, { action: 'wait', speed: 800 }, { action: 'break' }, { text: "> WARN: PROTOCOL_ANCIENT", action: 'type', speed: 10 }, { action: 'wait', speed: 600 }, { action: 'clear', speed: 30 }, { text: "> init modern_stack...", action: 'type', speed: 30 }, { action: 'break' }, { text: "> rm -rf /pagebuilder_bloat", action: 'type', speed: 40 }, { action: 'wait', speed: 400 }, { action: 'break' }, { text: "> installing: @astrojs/perf", action: 'type', speed: 20 }, { action: 'break' }, { text: "  [OK] Core loaded (12ms)", action: 'type', speed: 10 }, { action: 'break' }, { text: "> compiling masterpiece...", action: 'type', speed: 30 }, { action: 'wait', speed: 3000 }, { action: 'clear', speed: 20 }];
  let seqIndex = 0; let charIndex = 0;
  function runTerminal() {
    if (!terminalElement || core?.getAttribute('data-state') !== '3') { setTimeout(runTerminal, 500); return; }
    if (seqIndex >= sequence.length) seqIndex = 0;
    const currentStep = sequence[seqIndex];
    if (currentStep.action === 'type') {
      if (charIndex < currentStep.text.length) { terminalElement.appendChild(document.createTextNode(currentStep.text.charAt(charIndex))); charIndex++; setTimeout(runTerminal, currentStep.speed); }
      else { seqIndex++; charIndex = 0; runTerminal(); }
    } else if (currentStep.action === 'wait') { setTimeout(() => { seqIndex++; runTerminal(); }, currentStep.speed); }
    else if (currentStep.action === 'break') { terminalElement.appendChild(document.createElement('br')); seqIndex++; runTerminal(); }
    else if (currentStep.action === 'clear') { terminalElement.textContent = ''; seqIndex++; setTimeout(runTerminal, currentStep.speed); }
  }
  runTerminal();
</script>