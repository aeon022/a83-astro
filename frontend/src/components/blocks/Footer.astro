<style is:global>
  /* GLOBAL SYSTEM REBOOT GLITCH */
  body.sys-rebooting {
    animation: sys-reboot-glitch 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    overflow-x: hidden;
  }

  /* Simuliert statisches Rauschen während des Glitches */
  body.sys-rebooting::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="1.5" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23n)"/></svg>');
    opacity: 0.25;
    mix-blend-mode: overlay;
  }

  @keyframes sys-reboot-glitch {
    0% { filter: none; transform: translate3d(0, 0, 0) scale(1); }
    15% { filter: invert(0.8) hue-rotate(180deg) contrast(150%); transform: translate3d(-10px, 5px, 0) scale(1.01) skewX(2deg); }
    30% { filter: contrast(300%) grayscale(100%); transform: translate3d(10px, -5px, 0) scale(1.02) skewX(-3deg); }
    45% { filter: blur(4px) contrast(500%) sepia(100%) hue-rotate(90deg); transform: scale(1.05); } /* Der Jump-Peak */
    50% { filter: blur(8px) contrast(800%) saturate(0); transform: scale(1.08); }
    65% { filter: invert(0.9) hue-rotate(270deg); transform: translate3d(5px, 10px, 0) skewX(4deg); }
    85% { filter: contrast(150%); transform: translate3d(-2px, -2px, 0); }
    100% { filter: none; transform: translate3d(0, 0, 0) scale(1); }
  }
</style>

<script>
  // Funktion kapseln, damit sie bei View Transitions neu geladen werden kann
  const initFooterSystems = () => {
    // 1. CLOCK LOGIC
    const clock = document.getElementById('utc-clock');
    if (clock) {
      const updateTime = () => {
        const now = new Date();
        const timeString = now.toISOString().split('T')[1].split('.')[0];
        clock.innerText = timeString;
      };
      updateTime();
      
      // Cleanup altes Interval (wichtig bei View Transitions!)
      if (window.a83ClockInterval) clearInterval(window.a83ClockInterval);
      window.a83ClockInterval = setInterval(updateTime, 1000);
    }

    // 2. REBOOT LOGIC
    const btn = document.getElementById('system-reboot-btn');
    
    // Alten Listener entfernen durch Klonen (verhindert Double-Fires in Astro)
    if (btn) {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        if (document.body.classList.contains('sys-rebooting')) return;

        // Trigger Glitch
        document.body.classList.add('sys-rebooting');
        
        // Brute-Force Scroll am Peak des Glitches (330ms)
        setTimeout(() => {
          // 1. Target für normale Unterseiten (Window/Body)
          window.scrollTo(0, 0);
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
          
          // 2. Target für die Startseite (CSS-Snap-Container)
          const snapContainer = document.querySelector('main.overflow-y-auto');
          if (snapContainer) {
            snapContainer.scrollTop = 0;
          }
        }, 330);

        // System stabilisieren
        setTimeout(() => {
          document.body.classList.remove('sys-rebooting');
        }, 750);
      });
    }
  };

  // Setup für Astro View Transitions UND initialen Page Load
  document.addEventListener('astro:page-load', initFooterSystems);
  
  // Fallback, falls View Transitions deaktiviert sind
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initFooterSystems();
  } else {
    document.addEventListener('DOMContentLoaded', initFooterSystems);
  }
</script>