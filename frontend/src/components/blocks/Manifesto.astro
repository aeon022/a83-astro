<style>
  /* --- 3D CINEMATIC REVEAL --- */
  .reveal-3d {
    opacity: 0;
    transform: translateY(40px) scale(0.96) rotateX(10deg);
    filter: blur(8px);
    transform-origin: center top;
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }
  .reveal-3d.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0deg);
    filter: blur(0);
  }
  .delay-100 { transition-delay: 100ms; }
  .delay-200 { transition-delay: 200ms; }
  .delay-300 { transition-delay: 300ms; }
  .delay-400 { transition-delay: 400ms; }
  .delay-500 { transition-delay: 500ms; }
  .bg-radial-accent { background: radial-gradient(circle at center, var(--a83-accent), transparent 70%); }

  /* --- MAX HEADROOM GLITCH EFFECT --- */
  .max-headroom-entity {
    /* Ermöglicht das Ausbrechen aus der Box */
    transform: scale(1.2) translateZ(50px);
    transition: opacity 0.2s ease-in, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    mix-blend-mode: hard-light; /* Aggressiver Blend-Mode für den digitalen Look */
  }

  /* Der eigentliche Glitch-Container */
  .glitch-image {
    /* RGB Split Effekt via Text-Shadow Hack (funktioniert auch auf Boxen) */
    box-shadow: -5px 0 var(--a83-accent), 5px 0 blue;
    /* Scanlines und Stottern */
    animation: max-headroom-stutter 0.2s infinite linear alternate-reverse;
    filter: contrast(1.5) brightness(1.2) hue-rotate(90deg);
  }

  @keyframes max-headroom-stutter {
    0% {
      clip-path: inset(10% 0 80% 0);
      transform: translate(-2px, 2px) skewX(5deg);
    }
    20% {
      clip-path: inset(60% 0 20% 0);
      transform: translate(2px, -2px) skewX(-5deg);
      filter: contrast(2) brightness(1.5) hue-rotate(0deg) invert(0.1);
    }
    40% {
      clip-path: inset(30% 0 50% 0);
      transform: translate(-5px, 0) scale(1.05);
    }
    60% {
      clip-path: inset(80% 0 5% 0);
      transform: translate(5px, 5px) skewX(2deg);
       filter: contrast(1.5) brightness(1.2) hue-rotate(180deg);
    }
    80% {
      clip-path: inset(5% 0 90% 0);
      transform: translate(0, -5px);
    }
    100% {
      clip-path: inset(40% 0 40% 0);
      transform: translate(2px, 2px) skewX(-2deg);
    }
  }
</style>

<script>
  // --- CINEMATIC REVEAL & SCRAMBLE ENGINE (Vanilla JS) ---
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        
        const scrambles = entry.target.querySelectorAll('.scramble-text');
        scrambles.forEach(el => scrambleText(el));

        if (entry.target.classList.contains('scramble-text')) {
          scrambleText(entry.target);
        }
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.reveal-3d').forEach((el) => observer.observe(el));

  const chars = '!<>-_\\/[]{}—=+*^?#________';
  function scrambleText(element) {
    const originalText = element.getAttribute('data-text') || element.innerText;
    let iteration = 0;
    if (!element.style.width) element.style.width = `${element.offsetWidth}px`;

    const interval = setInterval(() => {
      element.innerText = originalText.split('').map((letter, index) => {
        if (index < iteration) return originalText[index];
        return chars[Math.floor(Math.random() * chars.length)];
      }).join('');
      if (iteration >= originalText.length) { 
        clearInterval(interval);
        element.style.width = 'auto';
      }
      iteration += 1 / 2;
    }, 40);
  }
</script>