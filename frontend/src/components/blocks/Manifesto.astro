---
// Dateipfad: frontend/src/components/blocks/Manifesto.astro
// Vibe: Editorial Cyberpunk / High-End Agency
// Tech: CSS Grid (Bento), CSS Glitch Animation, nav-content-sync
---

<section id="manifesto" class="nav-content-sync relative w-full px-6 lg:px-16 py-32 md:py-48 bg-a83-bg border-t border-white/5 overflow-hidden">
  
  <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-[radial-gradient(circle_at_center,color-mix(in_srgb,var(--a83-accent)_3%,transparent)_0%,transparent_70%)] pointer-events-none"></div>

  <div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-8 items-center relative z-10">
    
    <div class="lg:col-span-6 flex flex-col items-start pr-0 lg:pr-12">
      
      <div class="flex items-center gap-3 mb-8">
        <span class="w-1.5 h-1.5 bg-white/50"></span>
        <span class="font-mono text-[10px] text-white/50 uppercase tracking-[0.3em]">// CORE_DIRECTIVE</span>
      </div>

      <h2 class="text-5xl md:text-7xl font-black text-white tracking-tighter leading-[1.1] mb-8 font-sans">
        Fesch. Frisch.<br />
        <span class="text-transparent" style="-webkit-text-stroke: 1px var(--a83-accent);">Future.</span>
      </h2>

      <p class="text-xl md:text-3xl text-white/70 font-medium tracking-tight mb-6">
        Webdesign, das kompiliert.<br />
        <span class="text-white">Für Menschen.</span>
      </p>

      <p class="text-sm md:text-base text-white/40 font-mono max-w-md leading-relaxed mb-12">
        Wir bauen keine monolithischen Bloatware-Templates. Wir konstruieren maßgeschneiderte, asynchrone Architekturen. Deploy ready. Less Noise. Nice Data. No Bloat.
      </p>

      <div class="font-mono text-xs md:text-sm text-a83-accent bg-a83-accent/10 border border-a83-accent/20 px-4 py-2 inline-flex relative overflow-hidden group">
        <span class="raw-glitch inline-block tracking-[0.2em]">R^^t_ /to/!eb#_></span>
      </div>

    </div>


    <div class="lg:col-span-6 grid grid-cols-2 gap-4 md:gap-6">
      
      <div class="col-span-2 bg-white/[0.02] border border-white/10 rounded-2xl p-6 md:p-8 hover:border-white/20 transition-colors">
        <div class="flex justify-between items-start mb-8">
          <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest">Sys_Architecture</span>
          <span class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]"></span>
        </div>
        <div class="font-mono text-sm md:text-base text-white/80 space-y-2">
          <div class="flex items-center gap-4"><span class="text-a83-accent w-4">-></span> Engine: Astro_v5</div>
          <div class="flex items-center gap-4"><span class="text-a83-accent w-4">-></span> Styling: Tailwind_v4</div>
          <div class="flex items-center gap-4"><span class="text-a83-accent w-4">-></span> Data: StudioCMS_Native</div>
          <div class="flex items-center gap-4 text-white/40 line-through decoration-red-500"><span class="text-red-500 w-4">x</span> Legacy: WordPress</div>
        </div>
      </div>

      <div class="col-span-2 sm:col-span-1 aspect-square bg-black border border-white/10 rounded-2xl relative overflow-hidden group">
        <img src="/images/manifesto-photo.webp" alt="ABTEILUNG83 Workspace" class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity group-hover:scale-105 group-hover:opacity-100 transition-all duration-700 ease-out" />
        
        <div class="absolute inset-0 bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.3)_2px,rgba(0,0,0,0.3)_4px)] pointer-events-none"></div>
        <div class="absolute inset-0 shadow-[inset_0_0_30px_rgba(0,0,0,0.8)] pointer-events-none"></div>
        
        <div class="absolute bottom-4 left-4">
          <span class="font-mono text-[9px] bg-black/60 backdrop-blur text-white px-2 py-1 border border-white/10">VISUAL_ASSET_01</span>
        </div>
      </div>

      <a href="/work" class="col-span-2 sm:col-span-1 aspect-square bg-a83-accent/10 border border-a83-accent/30 rounded-2xl p-6 flex flex-col justify-between hover:bg-a83-accent hover:border-a83-accent transition-all duration-300 group cursor-pointer text-decoration-none">
        <div class="flex justify-between items-center">
          <span class="font-mono text-[10px] text-a83-accent group-hover:text-black uppercase tracking-widest transition-colors">Access_Vault</span>
          <svg class="w-4 h-4 text-a83-accent group-hover:text-black group-hover:translate-x-1 group-hover:-translate-y-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 4h16v16M4 20L20 4"></path>
          </svg>
        </div>
        
        <div>
          <h3 class="font-sans text-2xl md:text-3xl font-bold text-white group-hover:text-black tracking-tight transition-colors mb-2">Highlights</h3>
          <p class="font-mono text-xs text-a83-accent group-hover:text-black/70 transition-colors">> Init protocol</p>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  /* Rohe Glitch-Animation für den Hacker-String */
  .raw-glitch {
    display: inline-block;
    animation: text-clip 3s linear infinite;
  }

  @keyframes text-clip {
    0% { clip-path: inset(0 0 0 0); transform: translateX(0); }
    5% { clip-path: inset(10% 0 80% 0); transform: translateX(2px); }
    10% { clip-path: inset(0 0 0 0); transform: translateX(0); }
    45% { clip-path: inset(0 0 0 0); transform: translateX(0); }
    50% { clip-path: inset(60% 0 10% 0); transform: translateX(-2px); }
    55% { clip-path: inset(0 0 0 0); transform: translateX(0); }
    100% { clip-path: inset(0 0 0 0); transform: translateX(0); }
  }
</style>