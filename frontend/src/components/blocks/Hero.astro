---
// Dateipfad: frontend/src/components/blocks/Hero.astro
import TerminalButton from '../ui/TerminalButton.astro';
---

<section id="hero-section" class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden bg-a83-surface perspective-container">
  
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at-[40%_50%],transparent_0%,var(--deep-canvas)_90%)] opacity-95"></div>
    
    <div class="video-fusion-container">
      <video 
        src="/video/hero/hero.webm" 
        autoplay loop muted playsinline 
        class="video-fusion-element will-change-transform"
      ></video>
    </div>

    <div class="absolute inset-0 bg-[linear-gradient(var(--a83-text)_1px,transparent_1px),linear-gradient(90deg,var(--a83-text)_1px,transparent_1px)] bg-[size:100px_100px] opacity-[0.03]"></div>
  </div>

  <canvas id="hero-rain" class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-60"></canvas>

  <div id="hero-visibility-layer" class="nav-content-sync relative w-full px-6 lg:px-16 z-20 flex flex-col h-full justify-center">
    
    <div class="absolute top-10 left-6 lg:left-16 flex gap-6 items-center">
       <div class="flex items-center gap-2 bg-black/40 backdrop-blur-md px-3 py-1 border border-white/10">
          <span class="w-2 h-2 bg-a83-accent animate-pulse"></span>
          <span class="font-mono text-[10px] text-white uppercase tracking-[0.5em] font-black">Link_Established</span>
       </div>
       <span class="hidden md:block font-mono text-[9px] text-white/50 uppercase tracking-widest">A83_Mainframe // Orbital_Sync</span>
    </div>

    <div id="hero-content-block" class="flex flex-col items-start transform-style-3d transition-transform duration-75 ease-out will-change-transform translate-z-0">
      
      <div class="mb-6 translate-z-20 border-l-2 border-a83-accent pl-4">
        <span class="font-mono text-xs md:text-sm text-a83-sub uppercase tracking-[0.3em]">// Webdesign, das knallt.</span>
      </div>

      <h1 id="hero-headline" class="relative group leading-none mb-12 translate-z-50 cursor-none">
        <span class="block font-black text-white uppercase tracking-tighter whitespace-nowrap headline-fluid-size neon-outline glitch-accent" data-text="Wie Neonlicht">
          Wie Neonlicht
        </span>
        <span class="block font-black text-white uppercase tracking-tighter headline-fluid-size blazing-neon glitch-accent" data-text="im Regen.">
          im Regen.
        </span>
      </h1>

      <div class="flex flex-col sm:flex-row gap-8 items-start pl-2 translate-z-30">
          <TerminalButton variant="primary" href="mailto:post@abteilung83.at" prefix="EXEC" text="init_contact" />
          <button onclick="window.scrollTo({top: window.innerHeight, behavior: 'smooth'})" class="group flex items-center gap-4 font-mono text-[11px] uppercase tracking-[0.4em] text-white hover:text-a83-accent transition-all">
            <span class="w-12 h-[1px] bg-white group-hover:w-20 group-hover:bg-a83-accent transition-all"></span>
            Enter_Vault
          </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* --- PERFORMANCE OPTIMIZED STYLES --- */
  .perspective-container { perspective: 1000px; } /* Etwas flacher für weniger Rechenlast */
  .transform-style-3d { transform-style: preserve-3d; backface-visibility: hidden; }
  .translate-z-0 { transform: translateZ(0); } /* GPU Promotion */
  .translate-z-20 { transform: translateZ(20px); }
  .translate-z-30 { transform: translateZ(40px); }
  .translate-z-50 { transform: translateZ(80px); }

  /* Video Fusion: Filter reduziert für bessere Framerate */
  .video-fusion-container {
    position: absolute; inset: 0;
    z-index: -1; overflow: hidden;
    mask-image: radial-gradient(ellipse at center right, black 20%, transparent 85%);
  }
  .video-fusion-element {
    width: 100%; height: 100%; object-fit: cover; 
    object-position: right center;
    mix-blend-mode: screen; 
    filter: brightness(0.7) contrast(120%); /* Weniger Filter-Stacking */
    opacity: 0.6;
  }

  /* Typography & Effects (Unverändert) */
  .headline-fluid-size { font-size: clamp(3rem, 10vw, 9rem); line-height: 0.82; }
  .neon-outline { color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.7); }
  .blazing-neon {
    color: #ffffff;
    text-shadow: 0 0 15px var(--a83-accent), 0 0 30px var(--a83-accent);
    animation: neon-pulse 4s infinite alternate ease-in-out;
  }
  @keyframes neon-pulse {
    0% { opacity: 0.95; }
    100% { opacity: 1; text-shadow: 0 0 20px var(--a83-accent), 0 0- 40px var(--a83-accent); }
  }
</style>

<script>
  const canvas = document.getElementById('hero-rain') as HTMLCanvasElement;
  const section = document.getElementById('hero-section');
  const contentBlock = document.getElementById('hero-content-block');
  const headline = document.getElementById('hero-headline');
  const ctx = canvas?.getContext('2d', { alpha: true });

  if (canvas && ctx && section) {
    let width = canvas.width = section.offsetWidth;
    let height = canvas.height = section.offsetHeight;
    let isIntense = false;
    let isActive = true; // Steuerung über IntersectionObserver

    // OPTIMIERUNG 1: Stop Animation when not in view
    const observer = new IntersectionObserver((entries) => {
      isActive = entries[0].isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(section);

    if (headline) {
      headline.addEventListener('mouseenter', () => { isIntense = true; headline.classList.add('is-glitching-hard'); });
      headline.addEventListener('mouseleave', () => { isIntense = false; headline.classList.remove('is-glitching-hard'); });
    }

    class Drop {
      x = 0; y = 0; speed = 0; length = 0; opacity = 0; layer = 0;
      constructor() { this.reset(true); }
      reset(initial = false) {
        this.layer = Math.random() > 0.5 ? 1 : 2;
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * -height : -50;
        this.speed = this.layer * (isIntense ? 10 : 2.5); 
        this.length = this.layer * (isIntense ? 30 : 12);
        this.opacity = this.layer * (isIntense ? 0.5 : 0.1); 
      }
      update() {
        this.y += this.speed;
        if (this.y > height) this.reset();
      }
      draw() {
        ctx.beginPath();
        ctx.strokeStyle = `rgba(255, 75, 18, ${this.opacity})`;
        ctx.lineWidth = this.layer * 0.5;
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x, this.y - this.length);
        ctx.stroke();
      }
    }

    let drops = Array.from({ length: 120 }, () => new Drop()); // Anzahl leicht reduziert

    function animate() {
      if (isActive) {
        ctx.clearRect(0, 0, width, height);
        for (let i = 0; i < drops.length; i++) {
          drops[i].update();
          drops[i].draw();
        }
      }
      requestAnimationFrame(animate);
    }
    animate();

    // OPTIMIERUNG 2: Throttled 3D Parallax
    if (contentBlock) {
      let ticking = false;
      window.addEventListener('mousemove', (e) => {
        if (!ticking && isActive) {
          window.requestAnimationFrame(() => {
            const xRotate = (e.clientY / window.innerHeight - 0.5) * -8; 
            const yRotate = (e.clientX / window.innerWidth - 0.5) * 8;
            contentBlock.style.transform = `rotateX(${xRotate}deg) rotateY(${yRotate}deg) translateZ(0)`;
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }

    window.addEventListener('resize', () => {
      width = canvas.width = section.offsetWidth;
      height = canvas.height = section.offsetHeight;
    }, { passive: true });
  }
</script>