---
// Dateipfad: frontend/src/components/blocks/Hero.astro
import TerminalButton from '../ui/TerminalButton.astro';
---

<section id="hero-section" class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden bg-a83-surface perspective-container">
  
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at-[40%_50%],transparent_0%,var(--deep-canvas)_90%)] opacity-95"></div>
    
    <div class="video-fusion-container">
      <video 
        src="/video/hero/hero.webm" 
        autoplay loop muted playsinline 
        class="video-fusion-element"
      ></video>
    </div>

    <div class="absolute inset-0 bg-[linear-gradient(var(--a83-text)_1px,transparent_1px),linear-gradient(90deg,var(--a83-text)_1px,transparent_1px)] bg-[size:100px_100px] opacity-[0.04] mix-blend-overlay"></div>
  </div>

  <canvas id="hero-rain" class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-60"></canvas>

  <div id="hero-visibility-layer" class="relative w-full px-6 lg:px-16 z-20 flex flex-col h-full justify-center">
    
    <div class="absolute top-10 left-6 lg:left-16 flex gap-6 items-center">
       <div class="flex items-center gap-2 bg-black/40 backdrop-blur-md px-3 py-1 border border-white/10">
          <span class="w-2 h-2 bg-a83-accent animate-pulse"></span>
          <span class="font-mono text-[10px] text-white uppercase tracking-[0.5em] font-black">Link_Established</span>
       </div>
       <span class="hidden md:block font-mono text-[9px] text-white/50 uppercase tracking-widest">A83_Mainframe // Orbital_Sync</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-10 flex flex-col items-start">
        
        <h1 id="hero-headline" class="relative group leading-none mb-12">
          <span class="block font-black text-white uppercase tracking-tighter whitespace-nowrap headline-fluid-size neon-outline glitch-accent" data-text="Wie Neonlicht">
            Wie Neonlicht
          </span>
          
          <span class="block font-black text-a83-accent uppercase tracking-tighter headline-fluid-size neon-glow glitch-accent" data-text="im Regen.">
            im Regen.
          </span>
        </h1>

        <div class="flex flex-col sm:flex-row gap-8 items-start pl-2">
            <TerminalButton 
              variant="primary" 
              href="mailto:post@abteilung83.at" 
              prefix="EXEC" 
              text="init_contact" 
            />
            <button onclick="window.scrollTo({top: window.innerHeight, behavior: 'smooth'})" class="group flex items-center gap-4 font-mono text-[11px] uppercase tracking-[0.4em] text-white hover:text-a83-accent transition-all">
              <span class="w-12 h-[1px] bg-white group-hover:w-20 group-hover:bg-a83-accent transition-all"></span>
              Enter_Vault
            </button>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* --- MENU SYNC (Cinematic Fade Out) --- */
  /* Reagiert auf das HTML-Attribut, das vom Header.astro gesetzt wird */
  :global(html[data-nav-state="opening"]) #hero-visibility-layer,
  :global(html[data-nav-state="open"]) #hero-visibility-layer {
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.98);
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-nav-state="closing"]) #hero-visibility-layer,
  :global(html:not([data-nav-state])) #hero-visibility-layer {
    opacity: 1;
    filter: blur(0px);
    transform: scale(1);
    pointer-events: auto;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  /* --- VIDEO FUSION --- */
  .video-fusion-container {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 80vw;
    z-index: -1;
    overflow: hidden;
    mask-image: radial-gradient(ellipse at center right, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center right, black 20%, transparent 80%);
  }

  .video-fusion-element {
    width: 100%; height: 100%; object-fit: cover;
    mix-blend-mode: screen; 
    filter: contrast(140%) brightness(0.7) saturate(1.2);
    opacity: 0.8;
  }

  /* --- NEON TYPOGRAPHY --- */
  .headline-fluid-size {
    font-size: clamp(3rem, 10vw, 9rem);
    line-height: 0.82;
  }

  .neon-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.8);
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
  }

  .neon-glow {
    text-shadow: 
      0 0 10px rgba(255, 75, 18, 0.8),
      0 0 30px rgba(255, 75, 18, 0.4),
      0 0 60px rgba(255, 75, 18, 0.2);
  }

  .perspective-container { perspective: 2000px; }

  /* Glitch Styles */
  .glitch-accent { position: relative; }
  .is-glitching-hard { animation: text-flicker-hard 0.1s linear infinite !important; }
  
  @keyframes text-flicker-hard {
    0% { transform: translate(0, 0); text-shadow: 5px 0 var(--a83-accent), -5px 0 #fff; }
    50% { transform: translate(-3px, 2px); text-shadow: -5px 0 var(--a83-accent), 5px 0 #fff; opacity: 0.8; }
    100% { transform: translate(2px, -1px); text-shadow: 3px 0 var(--a83-accent), -3px 0 #fff; }
  }
</style>

<script>
  // FIX: Alle TypeScript Assertions ("as Type" und "!") entfernt für reines Vanilla JS
  const canvas = document.getElementById('hero-rain');
  const headline = document.getElementById('hero-headline');
  const section = document.getElementById('hero-section');
  const ctx = canvas ? canvas.getContext('2d') : null;

  if (canvas && ctx && section) {
    let width = canvas.width = section.offsetWidth;
    let height = canvas.height = section.offsetHeight;
    let isIntense = false;

    if (headline) {
      headline.addEventListener('mouseenter', () => { 
        isIntense = true; 
        headline.classList.add('is-glitching-hard'); 
      });
      headline.addEventListener('mouseleave', () => { 
        isIntense = false; 
        headline.classList.remove('is-glitching-hard'); 
      });
    }

    const rainColor = '255, 75, 18'; 
    class Drop {
      constructor() { this.reset(true); }
      reset(initial = false) {
        this.layer = Math.random() > 0.5 ? 1 : 2;
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * -height : -50;
        this.speed = this.layer * (isIntense ? 12 : 3); 
        this.length = this.layer * (isIntense ? 40 : 15);
        this.opacity = this.layer * (isIntense ? 0.6 : 0.15); 
      }
      update() {
        this.y += this.speed;
        if (this.y > height) this.reset();
      }
      draw() {
        ctx.beginPath();
        ctx.strokeStyle = `rgba(${rainColor}, ${this.opacity})`;
        ctx.lineWidth = this.layer * 0.5; 
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x, this.y - this.length);
        ctx.stroke();
      }
    }

    let drops = Array.from({ length: 180 }, () => new Drop());
    function animate() {
      ctx.clearRect(0, 0, width, height);
      drops.forEach(drop => { drop.update(); drop.draw(); });
      requestAnimationFrame(animate);
    }
    animate();

    window.addEventListener('resize', () => {
      width = canvas.width = section.offsetWidth;
      height = canvas.height = section.offsetHeight;
    });
  }
</script>