---
// src/components/blocks/Hero.astro
import TerminalButton from '../ui/TerminalButton.astro';
---

<section id="hero-section" class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden bg-a83-surface perspective-2000">
  
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_50%,transparent_0%,var(--deep-canvas)_90%)] opacity-95"></div>
    
    <div class="video-fusion-container">
      <video 
        src="/video/hero/hero.webm" 
        autoplay loop muted playsinline 
        class="video-fusion-element"
      ></video>
    </div>

    <div class="absolute inset-0 bg-[linear-gradient(var(--a83-text)_1px,transparent_1px),linear-gradient(90deg,var(--a83-text)_1px,transparent_1px)] bg-[size:100px_100px] opacity-[0.04] mix-blend-overlay"></div>
  </div>

  <canvas id="hero-rain" class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-60"></canvas>

  <div class="relative w-full px-6 lg:px-16 z-20 flex flex-col h-full justify-center">
    
    <div id="hero-content-block" class="flex flex-col items-start transform-style-3d transition-transform duration-200 ease-out">
      
      <div class="flex items-center gap-4 mb-10 translate-z-20">
         <div class="flex items-center gap-3 bg-black/50 backdrop-blur-xl px-4 py-2 border border-white/10 shadow-[0_0_20px_rgba(255,255,255,0.05)]">
            <span class="w-2 h-2 bg-a83-accent animate-pulse shadow-[0_0_8px_var(--a83-accent)]"></span>
            <span class="font-mono text-xs text-white uppercase tracking-[0.5em] font-black">Link_Established</span>
         </div>
         <span class="hidden md:block font-mono text-[10px] text-white/40 uppercase tracking-[0.3em]">A83_Orbital_Node // Stable</span>
      </div>

      <h1 id="hero-headline" class="relative group leading-none mb-14 translate-z-50">
        <span class="block font-black text-white uppercase tracking-tighter whitespace-nowrap headline-fluid-size neon-outline glitch-accent" data-text="Wie Neonlicht">
          Wie Neonlicht
        </span>
        <span class="block font-black text-a83-accent uppercase tracking-tighter headline-fluid-size neon-glow glitch-accent" data-text="im Regen.">
          im Regen.
        </span>
      </h1>

      <div class="flex flex-col sm:flex-row gap-8 items-start pl-2 translate-z-30">
          <TerminalButton 
            variant="primary" 
            href="mailto:post@abteilung83.at" 
            prefix="EXEC" 
            text="init_contact" 
          />
          <button onclick="window.scrollTo({top: window.innerHeight, behavior: 'smooth'})" class="group flex items-center gap-4 font-mono text-[11px] uppercase tracking-[0.5em] text-white hover:text-a83-accent transition-all">
            <span class="w-12 h-[1px] bg-white group-hover:w-20 group-hover:bg-a83-accent transition-all"></span>
            Enter_Vault
          </button>
      </div>

    </div>
  </div>
</section>

<style>
  /* --- 3D UTILS --- */
  .perspective-2000 { perspective: 2000px; }
  .transform-style-3d { transform-style: preserve-3d; }
  .translate-z-20 { transform: translateZ(40px); }
  .translate-z-30 { transform: translateZ(60px); }
  .translate-z-50 { transform: translateZ(100px); }

  /* --- VIDEO FUSION: Keine sichtbaren Ränder mehr --- */
  .video-fusion-container {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 80vw;
    z-index: -1;
    /* Kombinierte Maske für weiche Ränder links und außen */
    mask-image: linear-gradient(to right, transparent 0%, black 45%),
                radial-gradient(ellipse at center right, black 30%, transparent 85%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 45%),
                        radial-gradient(ellipse at center right, black 30%, transparent 85%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .video-fusion-element {
    width: 100%; height: 100%; object-fit: cover;
    mix-blend-mode: screen; 
    filter: contrast(135%) brightness(0.75) saturate(1.2);
    opacity: 0.8;
  }

  /* --- NEON TYPOGRAPHY --- */
  .headline-fluid-size {
    font-size: clamp(3.5rem, 11vw, 10rem);
    line-height: 0.82;
  }

  .neon-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.9);
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }

  .neon-glow {
    text-shadow: 
      0 0 10px rgba(255, 75, 18, 0.9),
      0 0 30px rgba(255, 75, 18, 0.5),
      0 0 70px rgba(255, 75, 18, 0.2);
  }

  /* --- GLITCH --- */
  .glitch-accent { position: relative; }
  .is-glitching-hard { animation: text-flicker-hard 0.1s linear infinite !important; }
  
  @keyframes text-flicker-hard {
    0% { transform: translate(0, 0); text-shadow: 6px 0 var(--a83-accent), -6px 0 #fff; }
    50% { transform: translate(-3px, 1px); text-shadow: -6px 0 var(--a83-accent), 6px 0 #fff; }
    100% { transform: translate(2px, -2px); text-shadow: 4px 0 var(--a83-accent), -4px 0 #fff; }
  }
</style>

<script>
  // 1. NEON RAIN ENGINE
  const canvas = document.getElementById('hero-rain') as HTMLCanvasElement;
  const headline = document.getElementById('hero-headline');
  const section = document.getElementById('hero-section');
  const contentBlock = document.getElementById('hero-content-block');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx && section) {
    let width = canvas.width = section.offsetWidth;
    let height = canvas.height = section.offsetHeight;
    let isIntense = false;

    if (headline) {
      headline.addEventListener('mouseenter', () => { 
        isIntense = true; 
        headline.classList.add('is-glitching-hard'); 
      });
      headline.addEventListener('mouseleave', () => { 
        isIntense = false; 
        headline.classList.remove('is-glitching-hard'); 
      });
    }

    const rainColor = '255, 75, 18'; 
    class Drop {
      x=0; y=0; length=0; speed=0; opacity=0; layer=0;
      constructor() { this.reset(true); }
      reset(initial = false) {
        this.layer = Math.random() > 0.5 ? 1 : 2;
        this.x = Math.random() * width;
        this.y = initial ? Math.random() * -height : -50;
        this.speed = this.layer * (isIntense ? 14 : 4); 
        this.length = this.layer * (isIntense ? 45 : 18);
        this.opacity = this.layer * (isIntense ? 0.6 : 0.15); 
      }
      update() {
        this.y += this.speed;
        if (this.y > height) this.reset();
      }
      draw() {
        ctx!.beginPath();
        ctx!.strokeStyle = `rgba(${rainColor}, ${this.opacity})`;
        ctx!.lineWidth = this.layer * 0.5; 
        ctx!.moveTo(this.x, this.y);
        ctx!.lineTo(this.x, this.y - this.length);
        ctx!.stroke();
      }
    }

    let drops = Array.from({ length: 200 }, () => new Drop());
    function animate() {
      ctx!.clearRect(0, 0, width, height);
      drops.forEach(drop => { drop.update(); drop.draw(); });
      requestAnimationFrame(animate);
    }
    animate();

    // 2. TARGETED 3D PARALLAX (Nur der Textblock)
    window.addEventListener('mousemove', (e) => {
      const xRotate = (e.clientY / window.innerHeight - 0.5) * -15; // Neigung
      const yRotate = (e.clientX / window.innerWidth - 0.5) * 15;
      
      if (contentBlock) {
        contentBlock.style.transform = `rotateX(${xRotate}deg) rotateY(${yRotate}deg)`;
      }
    });

    window.addEventListener('resize', () => {
      width = canvas.width = section.offsetWidth;
      height = canvas.height = section.offsetHeight;
    });
  }
</script>