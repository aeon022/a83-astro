---
// Dateipfad: src/components/blocks/Highlights.astro
// Version: V10.1 - TACTICAL DATA FOLDER / NAV POSITION FIX
// Feature: Notch-Corners, Brackets, Sidebar-Readout & High-Performance Slider

interface ProjectEntry {
  entity: string;
  arch: string;
  protocolReadout: string;
  coverImage?: string; 
}

interface Project {
  slug: string;
  entry: ProjectEntry;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;
---

<section id="highlights" class="snap-center relative w-full h-screen max-h-[1080px] min-h-[700px] bg-a83-bg overflow-hidden border-b border-veranda-green/20 flex flex-col justify-between py-8 lg:py-10 transition-colors duration-500 cursor-none selection:bg-a83-accent selection:text-white">
  
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(var(--veranda-green)_1px,transparent_1px),linear-gradient(90deg,var(--veranda-green)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-a83-bg via-transparent to-a83-bg"></div>
  </div>

  <div class="nav-content-sync w-full max-w-[1800px] mx-auto px-6 lg:px-16 relative z-10 flex justify-between items-start pointer-events-none shrink-0 transition-all duration-500">
      <div class="pointer-events-auto">
        <div class="flex items-center gap-3 mb-2">
          <div class="relative w-1.5 h-1.5">
            <div class="absolute inset-0 bg-a83-accent rounded-full animate-ping opacity-75"></div>
            <div class="relative w-1.5 h-1.5 bg-a83-accent rounded-full shadow-[0_0_10px_var(--a83-accent)]"></div>
          </div>
          <span class="font-mono text-[9px] text-a83-accent uppercase tracking-[0.4em] font-bold">
            // VISUAL_LOGS
          </span>
        </div>
        <h2 class="text-3xl md:text-5xl font-black text-a83-text-bold tracking-tighter leading-none">
          Deployments.
        </h2>
      </div>
  </div>

  <div class="nav-content-sync w-full max-w-[1800px] mx-auto px-6 lg:px-16 relative z-10 flex justify-end items-end pointer-events-none transition-all duration-500 mt-4 -mb-4">
      <div class="flex gap-4 pointer-events-auto items-center">
        <span class="font-mono text-[8px] text-veranda-green/30 uppercase tracking-[0.3em] mr-4 hidden md:block">manual_override //</span>
        
        <button id="nav-prev" class="group relative w-14 h-10 flex items-center justify-center bg-transparent focus:outline-none">
            <div class="absolute inset-0 border border-veranda-green/30 group-hover:border-a83-accent transition-colors duration-300 [clip-path:polygon(0_0,100%_0,100%_70%,85%_100%,0_100%)] bg-a83-surface/50 backdrop-blur-sm"></div>
            <div class="relative z-10 opacity-60 group-hover:opacity-100 transition-opacity">
                <svg class="w-3 h-3 text-a83-text group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            </div>
        </button>

        <button id="nav-next" class="group relative w-14 h-10 flex items-center justify-center bg-transparent focus:outline-none">
            <div class="absolute inset-0 border border-veranda-green/30 group-hover:border-a83-accent transition-colors duration-300 [clip-path:polygon(15%_0,100%_0,100%_100%,0_100%,0_30%)] bg-a83-surface/50 backdrop-blur-sm"></div>
            <div class="relative z-10 opacity-60 group-hover:opacity-100 transition-opacity">
                <svg class="w-3 h-3 text-a83-text group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
        </button>
      </div>
  </div>

  <div class="nav-content-sync flex-1 flex items-center w-full relative z-10 overflow-hidden my-2 lg:my-4 transition-all duration-500">
      <div 
        id="highlights-track" 
        class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide gap-4 md:gap-8 px-4 md:px-16 w-full touch-pan-y h-full items-center"
      >
        <div class="min-w-[10vw] h-full shrink-0 snap-align-none"></div>

        {projects.map((project, index) => (
          <article 
            class="group snap-center shrink-0 w-[85vw] md:w-[50vw] lg:w-[750px] h-[70%] md:h-[75%] relative cinematic-card"
            data-index={index}
            data-cursor-text="OPEN_FILE"
          >
            <div class="absolute -inset-2 pointer-events-none opacity-40 group-hover:opacity-100 transition-opacity duration-500">
                <div class="absolute top-0 left-0 w-4 h-4 border-t border-l border-a83-accent"></div>
                <div class="absolute top-0 right-0 w-4 h-4 border-t border-r border-a83-accent"></div>
                <div class="absolute bottom-0 left-0 w-4 h-4 border-b border-l border-a83-accent"></div>
                <div class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-a83-accent"></div>
            </div>

            <div class="glitch-wrapper relative w-full h-full bg-deep-canvas overflow-hidden border border-veranda-green/20 transition-all duration-500 group-hover:border-a83-accent/50 [clip-path:polygon(0_0,calc(100%-30px)_0,100%_30px,100%_100%,0_100%)]">
                
                {project.entry.coverImage ? (
                    <>
                        <img 
                            src={project.entry.coverImage} 
                            alt={project.entry.entity}
                            loading={index < 2 ? "eager" : "lazy"}
                            class="absolute inset-0 w-full h-full object-cover grayscale opacity-90 lg:opacity-50 lg:group-hover:opacity-80 lg:group-hover:grayscale-0 transition-all duration-700 ease-out"
                        />
                         {/* Glitch Layers */}
                        <div class="glitch-layer layer-r absolute inset-0 bg-transparent opacity-0 pointer-events-none mix-blend-overlay" style={`background-image: url('${project.entry.coverImage}'); background-size: cover; background-position: center;`}></div>
                        <div class="glitch-layer layer-g absolute inset-0 bg-transparent opacity-0 pointer-events-none mix-blend-overlay" style={`background-image: url('${project.entry.coverImage}'); background-size: cover; background-position: center;`}></div>
                    </>
                ) : (
                    <div class="absolute inset-0 w-full h-full bg-deep-canvas flex items-center justify-center overflow-hidden">
                        <div class="absolute inset-0 opacity-5" style="background: repeating-linear-gradient(45deg, #000, #000 10px, var(--veranda-green) 10px, var(--veranda-green) 20px);"></div>
                        <span class="block font-mono text-[10px] tracking-[0.3em] text-veranda-green uppercase animate-pulse">Awaiting_Data_Link</span>
                    </div>
                )}

                <div class="absolute right-0 top-12 bottom-0 w-12 border-l border-veranda-green/20 flex flex-col items-center py-6 gap-8 z-20 bg-deep-canvas/40 backdrop-blur-md hidden md:flex">
                    <span class="[writing-mode:vertical-rl] text-[8px] font-mono text-veranda-green/40 uppercase tracking-[0.4em]">UUID_A83_TRK</span>
                    <div class="w-px flex-1 bg-veranda-green/10"></div>
                    <span class="[writing-mode:vertical-rl] text-[8px] font-mono text-a83-accent uppercase font-bold tracking-widest">DEPLOY_SUCCESS</span>
                </div>

                <div class="absolute inset-0 bg-gradient-to-t from-a83-bg via-a83-bg/60 to-transparent opacity-90 transition-opacity duration-500"></div>

                <div class="absolute inset-0 p-6 md:p-10 flex flex-col justify-end">
                    
                    <div class="absolute top-6 left-6 flex items-center gap-3 fade-in-element">
                        <span class="bg-a83-accent text-deep-canvas font-mono text-[9px] uppercase px-2 py-0.5 font-bold shadow-[0_0_10px_var(--a83-accent)]">
                            MOD_{ (index + 1).toString().padStart(2, '0') }
                        </span>
                        <span class="text-[9px] font-mono text-veranda-green tracking-widest uppercase border border-veranda-green/30 px-2 py-0.5 bg-deep-canvas/80">
                            {project.entry.arch}
                        </span>
                    </div>

                    <div class="relative overflow-hidden pr-12">
                        <h3 class="glitch-text-target text-3xl md:text-5xl lg:text-5xl font-black text-bone-white tracking-tighter leading-[0.9] mb-4 transform transition-transform duration-500 slide-up-element group-hover:text-a83-accent">
                            {project.entry.entity}
                        </h3>
                        
                        <div class="border-t border-veranda-green/30 pt-4 flex flex-col gap-4 opacity-100 lg:opacity-0 transition-opacity duration-500 fade-in-element delay-100">
                            <p class="text-veranda-green text-[11px] leading-relaxed max-w-sm font-mono">
                                <span class="text-a83-accent font-bold mr-2">></span> {project.entry.protocolReadout}
                            </p>
                        </div>
                    </div>
                </div>

                <a href={`/work/${project.slug}`} class="absolute inset-0 z-30 focus:outline-none cursor-none"></a>
            </div>
          </article>
        ))}
        
        <div class="min-w-[10vw] h-full shrink-0 snap-align-none"></div>
      </div>
  </div>

  <div class="nav-content-sync w-full max-w-[1800px] mx-auto px-6 lg:px-16 relative z-10 pointer-events-none shrink-0 transition-all duration-500 pb-4">
     <div class="flex justify-between items-center mb-2 font-mono text-[8px] text-veranda-green/40 uppercase tracking-[0.2em]">
        <span>SYS_SCAN_PROGRESS</span>
        <span>NODE_04_STABLE</span>
     </div>
     <div class="w-full h-px bg-veranda-green/10 flex items-center">
        <div id="prog-bar" class="h-[2px] bg-a83-accent shadow-[0_0_15px_var(--a83-accent)] w-0 relative transition-all duration-100 ease-out">
            <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-a83-accent rotate-45"></div>
        </div>
     </div>
  </div>

</section>

<style is:global>
  html {
    scroll-snap-type: y proximity;
    scroll-padding-top: 0;
  }
</style>

<style>
  #highlights-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: none;
  }
  #highlights-track::-webkit-scrollbar { display: none; }

  /* Glitch Animations */
  .active-slide .glitch-layer { animation: glitch-anim 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both; }
  .active-slide .glitch-layer.layer-r { animation-delay: 0ms; transform: translate(5px, -5px); }
  .active-slide .glitch-layer.layer-g { animation-delay: 50ms; transform: translate(-5px, 5px); }

  /* Reveal Logic */
  .active-slide .slide-up-element { transform: translateY(0) !important; }
  .active-slide .fade-in-element { opacity: 1 !important; }
  .group:hover .slide-up-element { transform: translateY(0) !important; }
  .group:hover .fade-in-element { opacity: 1 !important; }

  @keyframes glitch-anim {
    0% { opacity: 0; clip-path: inset(50% 0 50% 0); transform: translate(0); }
    20% { opacity: 0.8; clip-path: inset(10% 0 60% 0); transform: translate(-5px, 5px); filter: hue-rotate(90deg); }
    40% { opacity: 0.8; clip-path: inset(40% 0 20% 0); transform: translate(5px, -5px); filter: hue-rotate(180deg); }
    60% { opacity: 0.8; clip-path: inset(80% 0 5% 0); transform: translate(-2px, 2px); }
    80% { opacity: 0.8; clip-path: inset(10% 0 80% 0); transform: translate(2px, -2px); }
    100% { opacity: 0; clip-path: inset(50% 0 50% 0); transform: translate(0); }
  }
</style>

<script>
  const track = document.getElementById('highlights-track') as HTMLElement;
  const progBar = document.getElementById('prog-bar');
  const prevBtn = document.getElementById('nav-prev');
  const nextBtn = document.getElementById('nav-next');
  const cards = document.querySelectorAll('.cinematic-card');
  
  // Intersection Observer for Active States
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('active-slide');
        void (entry.target as HTMLElement).offsetWidth; 
        entry.target.classList.add('active-slide');
      } else {
        entry.target.classList.remove('active-slide');
      }
    });
  }, { root: track, threshold: 0.6 });
  
  cards.forEach(c => observer.observe(c));

  // Scroll & Button Logic
  if (track && progBar) {
     track.addEventListener('scroll', () => {
        const max = track.scrollWidth - track.clientWidth;
        const percent = (track.scrollLeft / max) * 100;
        progBar.style.width = `${percent}%`;
     }, { passive: true });

     prevBtn?.addEventListener('click', () => {
        const cardWidth = track.querySelector('article')?.clientWidth || 750;
        track.scrollBy({ left: -(cardWidth + 48), behavior: 'smooth' });
     });

     nextBtn?.addEventListener('click', () => {
        const cardWidth = track.querySelector('article')?.clientWidth || 750;
        track.scrollBy({ left: (cardWidth + 48), behavior: 'smooth' });
     });
  }
</script>