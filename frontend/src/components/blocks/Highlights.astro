---
// Dateipfad: src/components/blocks/Highlights.astro
// Version: V9.1 - TACTICAL OPS / KOJIMA THEME + NAV SYNC FIX
// Feature: Fallback "Blueprint" Pattern & Semantic Color Tokens

interface ProjectEntry {
  entity: string;
  arch: string;
  protocolReadout: string;
  coverImage?: string; 
}

interface Project {
  slug: string;
  entry: ProjectEntry;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props as Props;
---

<section id="highlights" class="snap-center relative w-full h-screen max-h-[1080px] min-h-[700px] bg-a83-bg overflow-hidden border-b border-veranda-green/20 flex flex-col justify-between py-8 lg:py-10 transition-colors duration-500 cursor-none selection:bg-a83-accent selection:text-white">
  
  <div class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(var(--veranda-green)_1px,transparent_1px),linear-gradient(90deg,var(--veranda-green)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-a83-bg via-transparent to-a83-bg"></div>
  </div>

  <div class="nav-content-sync w-full max-w-[1800px] mx-auto px-6 lg:px-16 relative z-10 flex justify-between items-end pointer-events-none shrink-0 transition-all duration-500">
      <div class="pointer-events-auto">
        <div class="flex items-center gap-3 mb-2">
          <div class="relative w-1.5 h-1.5">
            <div class="absolute inset-0 bg-a83-accent rounded-full animate-ping opacity-75"></div>
            <div class="relative w-1.5 h-1.5 bg-a83-accent rounded-full shadow-[0_0_10px_var(--a83-accent)]"></div>
          </div>
          <span class="font-mono text-[9px] text-a83-accent uppercase tracking-[0.4em] font-bold">
            // VISUAL_LOGS
          </span>
        </div>
        <h2 class="text-3xl md:text-5xl font-black text-a83-text-bold tracking-tighter leading-none">
          Deployments.
        </h2>
      </div>

      <div class="flex gap-3 pointer-events-auto">
        <button id="nav-prev" class="group relative w-16 h-12 flex items-center justify-center bg-transparent focus:outline-none">
            <div class="absolute inset-0 border border-veranda-green/30 group-hover:border-a83-accent transition-colors duration-300 [clip-path:polygon(0_0,100%_0,100%_70%,85%_100%,0_100%)] bg-a83-surface/50 backdrop-blur-sm"></div>
            <div class="relative flex items-center gap-2 z-10 opacity-60 group-hover:opacity-100 transition-opacity">
                <svg class="w-3 h-3 text-a83-text group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                <span class="font-mono text-[9px] text-a83-text font-bold tracking-widest hidden md:block">PREV</span>
            </div>
        </button>

        <button id="nav-next" class="group relative w-16 h-12 flex items-center justify-center bg-transparent focus:outline-none">
            <div class="absolute inset-0 border border-veranda-green/30 group-hover:border-a83-accent transition-colors duration-300 [clip-path:polygon(15%_0,100%_0,100%_100%,0_100%,0_30%)] bg-a83-surface/50 backdrop-blur-sm"></div>
            <div class="relative flex items-center gap-2 z-10 opacity-60 group-hover:opacity-100 transition-opacity">
                <span class="font-mono text-[9px] text-a83-text font-bold tracking-widest hidden md:block">NEXT</span>
                <svg class="w-3 h-3 text-a83-text group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
        </button>
      </div>
  </div>

  <div class="nav-content-sync flex-1 flex items-center w-full relative z-10 overflow-hidden my-2 lg:my-4 transition-all duration-500">
      <div 
        id="highlights-track" 
        class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide gap-4 md:gap-8 px-4 md:px-16 w-full touch-pan-y h-full items-center"
      >
        <div class="min-w-[5vw] h-full shrink-0 snap-align-none"></div>

        {projects.map((project, index) => (
          <article 
            class="group snap-center shrink-0 w-[85vw] md:w-[60vw] lg:w-[900px] h-[85%] md:h-[90%] relative cinematic-card"
            data-index={index}
          >
            <div class="glitch-wrapper relative w-full h-full bg-deep-canvas overflow-hidden border border-veranda-green/20 transition-all duration-500 hover:border-a83-accent/50">
                
                {/* --- IMAGE OR PLACEHOLDER LOGIC --- */}
                {project.entry.coverImage ? (
                    <>
                        <img 
                            src={project.entry.coverImage} 
                            alt={project.entry.entity}
                            loading={index < 2 ? "eager" : "lazy"}
                            class="absolute inset-0 w-full h-full object-cover grayscale opacity-90 lg:opacity-70 lg:group-hover:opacity-100 lg:group-hover:grayscale-0 transition-all duration-700 ease-out"
                        />
                         {/* Glitch Layers */}
                        <div class="glitch-layer layer-r absolute inset-0 bg-transparent opacity-0 pointer-events-none mix-blend-overlay" style={`background-image: url('${project.entry.coverImage}'); background-size: cover; background-position: center;`}></div>
                        <div class="glitch-layer layer-g absolute inset-0 bg-transparent opacity-0 pointer-events-none mix-blend-overlay" style={`background-image: url('${project.entry.coverImage}'); background-size: cover; background-position: center;`}></div>
                    </>
                ) : (
                    /* PLACEHOLDER PATTERN "NO SIGNAL" */
                    <div class="absolute inset-0 w-full h-full bg-deep-canvas flex items-center justify-center overflow-hidden">
                        <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(var(--veranda-green) 1px, transparent 1px), linear-gradient(90deg, var(--veranda-green) 1px, transparent 1px); background-size: 40px 40px;"></div>
                        <div class="absolute inset-0 opacity-5" style="background: repeating-linear-gradient(45deg, #000, #000 10px, var(--veranda-green) 10px, var(--veranda-green) 20px);"></div>
                        
                        <div class="relative z-10 text-center">
                            <div class="w-16 h-16 border border-veranda-green/30 mx-auto mb-4 flex items-center justify-center rounded-sm animate-pulse">
                                <span class="font-mono text-xs text-veranda-green">!</span>
                            </div>
                            <span class="block font-mono text-[10px] tracking-[0.3em] text-veranda-green uppercase mb-1">Asset_Missing</span>
                            <span class="block font-mono text-xs text-a83-accent font-bold animate-pulse">AWAITING_UPLINK</span>
                        </div>
                    </div>
                )}

                <div class="absolute inset-0 bg-gradient-to-t from-a83-bg via-a83-bg/40 to-transparent opacity-90 lg:opacity-80 transition-opacity duration-500"></div>

                <div class="absolute inset-0 p-6 md:p-10 flex flex-col justify-end">
                    
                    <div class="absolute top-6 left-6 flex items-center gap-3 fade-in-element">
                        <span class="bg-a83-text-bold text-a83-bg font-mono text-[9px] uppercase px-2 py-0.5 font-bold">
                            #{ (index + 1).toString().padStart(2, '0') }
                        </span>
                        <span class="text-[9px] font-mono text-a83-text/60 tracking-widest uppercase border border-veranda-green/30 px-2 py-0.5">
                            {project.entry.arch}
                        </span>
                    </div>

                    <div class="relative overflow-hidden">
                        <h3 class="glitch-text-target text-3xl md:text-5xl lg:text-6xl font-black text-a83-text-bold tracking-tighter leading-[0.9] mb-3 transform translate-y-0 lg:translate-y-8 transition-transform duration-500 slide-up-element">
                            {project.entry.entity}
                        </h3>
                        
                        <div class="border-t border-veranda-green/30 pt-4 flex flex-col md:flex-row gap-4 justify-between md:items-end opacity-100 lg:opacity-0 transition-opacity duration-500 fade-in-element delay-100">
                            <p class="text-a83-text/80 text-sm max-w-md line-clamp-2 font-medium font-mono">
                                {project.entry.protocolReadout}
                            </p>
                            <div class="font-mono text-[9px] text-a83-accent whitespace-nowrap hidden md:block border border-a83-accent/30 px-2 py-1 bg-a83-accent/5">
                                STATUS: OPTIMAL
                            </div>
                        </div>
                    </div>
                </div>

                <a href={`/work/${project.slug}`} class="absolute inset-0 z-30 focus:outline-none cursor-none"></a>
            </div>
          </article>
        ))}
        
        <div class="min-w-[5vw] h-full shrink-0 snap-align-none"></div>
      </div>
  </div>

  <div class="nav-content-sync w-full max-w-[1800px] mx-auto px-6 lg:px-16 relative z-10 pointer-events-none shrink-0 transition-all duration-500">
     <div class="w-full h-px bg-veranda-green/20 flex items-center">
        <div id="prog-bar" class="h-[2px] bg-a83-accent shadow-[0_0_15px_var(--a83-accent)] w-0 relative transition-all duration-100 ease-out">
            <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-a83-accent rotate-45"></div>
        </div>
     </div>
  </div>

  <div id="magnetic-cursor" class="nav-content-sync fixed top-0 left-0 w-16 h-16 pointer-events-none z-50 opacity-0 transition-opacity duration-300 hidden lg:flex items-center justify-center text-a83-accent">
     <div class="absolute inset-0 border border-current rounded-full animate-[spin_10s_linear_infinite] opacity-80 border-dashed"></div>
     <div class="absolute inset-1 border border-current rounded-full scale-50 opacity-40"></div>
     <div class="w-1 h-1 bg-current rounded-full"></div>
     <span id="cursor-text" class="absolute top-full mt-4 font-mono text-[9px] tracking-[0.2em] font-bold bg-a83-bg px-1 border border-a83-accent/30">VIEW</span>
  </div>

</section>

<style is:global>
  html {
    scroll-snap-type: y proximity;
    scroll-padding-top: 0;
  }
</style>

<style>
  #highlights-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: none;
  }
  #highlights-track::-webkit-scrollbar { display: none; }

  .active-slide .glitch-layer { animation: glitch-anim 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both; }
  .active-slide .glitch-layer.layer-r { animation-delay: 0ms; transform: translate(5px, -5px); }
  .active-slide .glitch-layer.layer-g { animation-delay: 50ms; transform: translate(-5px, 5px); }

  .active-slide .slide-up-element { transform: translateY(0) !important; }
  .active-slide .fade-in-element { opacity: 1 !important; }
  .group:hover .slide-up-element { transform: translateY(0) !important; }
  .group:hover .fade-in-element { opacity: 1 !important; }

  @keyframes glitch-anim {
    0% { opacity: 0; clip-path: inset(50% 0 50% 0); transform: translate(0); }
    20% { opacity: 0.8; clip-path: inset(10% 0 60% 0); transform: translate(-5px, 5px); filter: hue-rotate(90deg); }
    40% { opacity: 0.8; clip-path: inset(40% 0 20% 0); transform: translate(5px, -5px); filter: hue-rotate(180deg); }
    60% { opacity: 0.8; clip-path: inset(80% 0 5% 0); transform: translate(-2px, 2px); }
    80% { opacity: 0.8; clip-path: inset(10% 0 80% 0); transform: translate(2px, -2px); }
    100% { opacity: 0; clip-path: inset(50% 0 50% 0); transform: translate(0); }
  }
</style>

<script>
  const section = document.getElementById('highlights');
  const track = document.getElementById('highlights-track') as HTMLElement;
  const progBar = document.getElementById('prog-bar');
  const prevBtn = document.getElementById('nav-prev');
  const nextBtn = document.getElementById('nav-next');
  const cards = document.querySelectorAll('.cinematic-card');
  
  const cursor = document.getElementById('magnetic-cursor');
  const cursorText = document.getElementById('cursor-text');

  if (section && cursor && window.matchMedia("(pointer: fine)").matches) {
      const moveCursor = (e: MouseEvent) => {
          cursor.style.transform = `translate3d(${e.clientX - 32}px, ${e.clientY - 32}px, 0)`;
      };
      section.addEventListener('mouseenter', () => {
          cursor.classList.remove('opacity-0');
          window.addEventListener('mousemove', moveCursor);
      });
      section.addEventListener('mouseleave', () => {
          cursor.classList.add('opacity-0');
          window.removeEventListener('mousemove', moveCursor);
      });
      cards.forEach(card => {
          card.addEventListener('mouseenter', () => {
              cursor.classList.add('scale-125');
              cursor.querySelector('.border')?.classList.add('border-a83-accent');
              if(cursorText) cursorText.innerText = "OPEN";
          });
          card.addEventListener('mouseleave', () => {
              cursor.classList.remove('scale-125');
              cursor.querySelector('.border')?.classList.remove('border-a83-accent');
              if(cursorText) cursorText.innerText = "VIEW";
          });
      });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('active-slide');
        void (entry.target as HTMLElement).offsetWidth; 
        entry.target.classList.add('active-slide');
      } else {
        entry.target.classList.remove('active-slide');
      }
    });
  }, { root: track, threshold: 0.6 });
  cards.forEach(c => observer.observe(c));

  if (track && progBar) {
     track.addEventListener('scroll', () => {
        const max = track.scrollWidth - track.clientWidth;
        const percent = (track.scrollLeft / max) * 100;
        progBar.style.width = `${percent}%`;
     }, { passive: true });
     prevBtn?.addEventListener('click', () => {
        const card = track.querySelector('article');
        const w = card ? card.clientWidth : 800;
        track.scrollBy({ left: -(w + 32), behavior: 'smooth' });
     });
     nextBtn?.addEventListener('click', () => {
        const card = track.querySelector('article');
        const w = card ? card.clientWidth : 800;
        track.scrollBy({ left: (w + 32), behavior: 'smooth' });
     });
  }
</script>