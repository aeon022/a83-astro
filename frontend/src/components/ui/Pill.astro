---
// Dateipfad: frontend/src/components/ui/Pill.astro
// Vibe: Tactical Tag / Military ID Label
// Change: Rounded-Full removed -> Rounded-SM (Industrial Look)

interface Props {
  text: string;
  theme?: 'neon' | 'dark' | 'outline';
}

const { text, theme = 'neon' } = Astro.props;

const themeClasses = {
  // ALERT / ACTIVE: Kojima Orange background, Dark text (Industrial Hazard Label)
  neon: 'bg-a83-accent text-deep-canvas border-a83-accent shadow-[0_0_10px_var(--a83-accent)]',
  
  // STANDARD / INFO: Surface background, Veranda Green border (Tactical Readout)
  dark: 'bg-a83-surface text-a83-text border-veranda-green/30 hover:border-veranda-green/60',
  
  // SUBTLE / META: Transparent, Tech-Specs lines
  outline: 'border-veranda-green/50 text-veranda-green bg-veranda-green/5 hover:bg-veranda-green/10'
};
---

<span class:list={[
  'inline-flex items-center px-2 py-0.5 rounded-sm text-[9px] md:text-[10px] font-mono font-bold tracking-widest uppercase transition-all duration-300 select-none cursor-default border',
  themeClasses[theme]
]}>
  {/* Tactical Square Indicator (nur bei Neon) */}
  {theme === 'neon' && <span class="w-1.5 h-1.5 bg-deep-canvas mr-2 animate-pulse rounded-[1px]"></span>}
  {text}
</span>