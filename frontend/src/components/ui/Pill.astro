// Dateipfad: frontend/src/components/ui/Pill.astro
---
// Das funktionale Setting (TypeScript Logic)
interface Props {
  text: string;
  theme?: 'neon' | 'dark' | 'outline';
}

const { text, theme = 'neon' } = Astro.props;

// Tailwind-Klassen basierend auf dem Theme dynamisch zuweisen
// Wir nutzen die Tailwind v4 Tokens, die wir zuvor definiert haben, 
// oder greifen auf die direkten Utility-Klassen aus dem Konzept zurück.
const themeClasses = {
  neon: 'bg-[#00ff66] text-black', // Der ABTEILUNG83 Neon-Vibe
  dark: 'bg-[#0a0a0a] text-white border border-gray-800',
  outline: 'border border-[#00ff66] text-[#00ff66]'
};
---

<span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${themeClasses[theme]}`}>
  {text}
</span>