---
// Dateipfad: frontend/src/components/ui/Pill.astro
interface Props {
  text: string;
  theme?: 'neon' | 'dark' | 'outline';
}

const { text, theme = 'neon' } = Astro.props;

const themeClasses = {
  // Haupt-Status: Leuchtet in der Akzentfarbe (z.B. Orange), schwarzer Text für Kontrast
  neon: 'bg-a83-accent text-a83-bg border border-a83-accent shadow-[0_0_15px_color-mix(in_srgb,var(--a83-accent)_40%,transparent)]',
  
  // Tech-Specs: Dezent dunkel, Glassmorphismus
  dark: 'bg-black/60 text-white/80 border border-white/10 backdrop-blur-md hover:border-white/30',
  
  // Parameter: Transparenter Hintergrund, farbige Linie
  outline: 'border border-a83-accent text-a83-accent bg-a83-accent/5 hover:bg-a83-accent/10'
};
---

<span class:list={[
  'inline-flex items-center px-3 py-1 rounded-full text-[10px] md:text-xs font-mono font-bold tracking-widest uppercase transition-all duration-300 select-none cursor-default',
  themeClasses[theme]
]}>
  {/* Kleiner "Live"-Indikator nur beim Neon-Theme */}
  {theme === 'neon' && <span class="w-1.5 h-1.5 bg-a83-bg rounded-full mr-2 animate-pulse"></span>}
  {text}
</span>