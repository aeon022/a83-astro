---
interface Props {
  text: string;
  theme?: 'neon' | 'dark' | 'outline';
}

const { text, theme = 'neon' } = Astro.props;

const themeClasses = {
  neon: 'bg-[#00ff66] text-black',
  dark: 'bg-[#0a0a0a] text-white border border-gray-800',
  outline: 'border border-[#00ff66] text-[#00ff66]'
};
---
<span class:list={[
  'inline-flex items-center px-3 py-1 rounded-full text-sm font-medium',
  themeClasses[theme]
]}>
  {text}
</span>