---
const { logo, links, cta, ctaUrl } = Astro.props;
---
<nav>
  <div class="nav-logo" set:html={logo}></div>
  <ul class="nav-links">
    {links.map((link: { href: string; label: string }) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
  <a href={ctaUrl} class="btn btn-primary" target="_blank" set:html={cta}></a>
</nav>
