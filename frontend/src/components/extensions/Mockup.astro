---
const { sectionLabel, title, subtitle, variant } = Astro.props;

const isLyricOs = variant === 'a83-lyric-os';
const isEnvSwitch = variant === 'envswitch';
const isAiPurifier = variant === 'ai-context-purifier';
---
<section class="mockup-section">
  <div class="container">
    <p class="section-label" set:html={sectionLabel}></p>
    <h2>{title}</h2>
    <p class="sub mockup-subtitle" set:html={subtitle}></p>

    {isLyricOs ? (
      <div class="lyricos-mock-shell">
        <div class="lyricos-mock-grid"></div>
        <div class="lyricos-mock">
          <div class="lyricos-mock-bar">
            <div class="lyricos-mock-title">A83 :// LYRIC-OS</div>
            <span>🎵</span>
          </div>
          <div class="lyricos-mock-status">LYRICS GENERATED</div>
          <div class="lyricos-mock-body">
            <div>
              <div class="lyricos-mock-label">LYRICS VIA</div>
              <div class="lyricos-mock-modes">
                <div class="lyricos-mock-btn active">⚡ API</div>
                <div class="lyricos-mock-btn">CLAUDE</div>
                <div class="lyricos-mock-btn">CHATGPT</div>
                <div class="lyricos-mock-btn">GEMINI</div>
              </div>
            </div>
            <div>
              <div class="lyricos-mock-label">MUSIK</div>
              <div class="lyricos-mock-modes">
                <div class="lyricos-mock-btn music">♪ SUNO</div>
                <div class="lyricos-mock-btn music">♪ UDIO</div>
              </div>
            </div>
            <div class="lyricos-transform">▶ IN SONG VERWANDELN</div>
            <div class="lyricos-output">
              <div><span class="lyricos-output-tag">[Chorus]</span></div>
              <div class="lyricos-output-line">Neon signs and broken code,</div>
              <div class="lyricos-output-line">we are data on the road -</div>
              <div class="lyricos-output-line">somewhere between the link and light</div>
              <div class="lyricos-output-line">we became the song of night.</div>
            </div>
          </div>
        </div>
      </div>
    ) : isEnvSwitch ? (
      <div class="envswitch-shell">
        <div class="envswitch-url-demo">
          <div class="envswitch-url-bar">
            <span class="envswitch-url-proto">https://</span>
            <span class="envswitch-url-host">staging.shop.de</span>
            <span class="envswitch-url-path">/products/123?ref=sale</span>
          </div>
          <div class="envswitch-url-arrow">↓ click "Live"</div>
          <div class="envswitch-url-bar envswitch-url-bar--active">
            <span class="envswitch-url-proto">https://</span>
            <span class="envswitch-url-host envswitch-url-host--active">shop.de</span>
            <span class="envswitch-url-path">/products/123?ref=sale</span>
          </div>
        </div>

        <div class="mockup-wrap envswitch-mock-wrap">
          <div class="browser-chrome">
            <div class="browser-dot"></div>
            <div class="browser-dot"></div>
            <div class="browser-dot"></div>
            <div class="browser-url">staging.shop.de/products/123</div>
          </div>
          <div class="browser-body envswitch-browser-body">
            <div class="envswitch-fake-page">
              <div class="envswitch-fake-page__nav">
                <div class="envswitch-fake-page__logo">ShopDemo</div>
                <div class="envswitch-fake-page__navlinks">
                  <span>Products</span>
                  <span>About</span>
                  <span>Contact</span>
                </div>
              </div>
              <div class="envswitch-fake-page__body">
                <div class="envswitch-fake-page__breadcrumb">Home / Products / Wireless Headphones</div>
                <div class="envswitch-fake-page__title">Wireless Headphones Pro</div>
                <div class="envswitch-fake-page__price">€149.00</div>
                <div class="envswitch-fake-page__btn">Add to Cart</div>
              </div>
            </div>

            <div class="envswitch-popup">
              <div class="envswitch-popup__header">
                <div class="envswitch-popup__logo">EnvSwitch</div>
                <span class="envswitch-popup__menu">≡</span>
              </div>
              <div class="envswitch-popup__urlbar">
                <span class="envswitch-popup__dot"></span>
                <span class="envswitch-popup__host">staging.shop.de</span>
                <span class="envswitch-popup__badge">Staging</span>
              </div>
              <div class="envswitch-popup__project">Online Shop</div>
              <div class="envswitch-popup__envs">
                <div class="envswitch-env-btn">
                  <span class="envswitch-env-btn__label">Local</span>
                  <span class="envswitch-env-btn__host">localhost:3000</span>
                </div>
                <div class="envswitch-env-btn active">
                  <span class="envswitch-env-btn__label">Staging</span>
                  <span class="envswitch-env-btn__host">staging.shop.de</span>
                </div>
                <div class="envswitch-env-btn">
                  <span class="envswitch-env-btn__label">Live</span>
                  <span class="envswitch-env-btn__host">shop.de</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : isAiPurifier ? (
      <div class="purifier-shell">
        <div class="purifier-ba-grid">
          <div class="purifier-ba-card purifier-ba-card--before">
            <div class="purifier-ba-label"><span class="purifier-ba-dot purifier-ba-dot--red"></span>WITHOUT - raw clipboard</div>
            <div class="purifier-ba-content">
              <span class="purifier-noise">Home | Products | Blog | Contact | Login</span>
              <span class="purifier-noise">We use cookies to improve your experience. Accept All</span>
              <span class="purifier-noise">Home › Blog › JavaScript › Async</span>
              <span class="purifier-keep">Understanding Async/Await</span>
              <span class="purifier-keep">Async functions let you write async code as if it were synchronous. The await keyword pauses execution until a Promise resolves...</span>
              <span class="purifier-noise">Share: Twitter LinkedIn Facebook Copy Link</span>
              <span class="purifier-noise">Related: 10 JS Tips · Top Frameworks 2026</span>
              <span class="purifier-noise">Author: Jane Doe · Senior Dev · 142 followers</span>
              <span class="purifier-noise">Comments (24) · Subscribe to newsletter</span>
            </div>
          </div>

          <div class="purifier-ba-arrow">→</div>

          <div class="purifier-ba-card purifier-ba-card--after">
            <div class="purifier-ba-label"><span class="purifier-ba-dot purifier-ba-dot--green"></span>WITH PURIFIER - clean Markdown</div>
            <div class="purifier-ba-content">
              <span class="purifier-md-h">## Understanding Async/Await</span><br />
              <span class="purifier-md-body">Async functions let you write async code as if it were synchronous. The await keyword pauses execution until a Promise resolves...</span><br /><br />
              <span class="purifier-md-dim">// 312 chars · noise removed ✓</span>
            </div>
          </div>
        </div>

        <div class="mockup-wrap purifier-mock-wrap">
          <div class="browser-chrome">
            <div class="browser-dot"></div>
            <div class="browser-dot"></div>
            <div class="browser-dot"></div>
            <div class="browser-url">dev.to/article/understanding-async-await</div>
          </div>
          <div class="browser-body purifier-browser-body">
            <div class="purifier-fake-page">
              <div class="purifier-fake-page__nav">
                <div class="purifier-fake-nav-logo">DEV Community</div>
                <div class="purifier-fake-nav-links"><span>Feed</span><span>Tags</span><span>Sign in</span></div>
              </div>
              <div class="purifier-fake-page__body">
                <div class="purifier-cookie"><span>🍪 We use cookies to improve your experience.</span><button class="purifier-cookie__btn">Accept All</button></div>
                <div class="purifier-breadcrumb">Home › JavaScript › Async</div>
                <div class="purifier-selected">
                  <div class="purifier-fake-h1">Understanding Async/Await in JavaScript</div>
                  <div class="purifier-fake-p">Async functions allow you to write promise-based code as if it were synchronous. The <code>await</code> keyword pauses execution inside an async function until the Promise resolves, without blocking the main thread.</div>
                  <div class="purifier-fake-p">This makes error handling with try/catch natural and keeps the code readable even for complex async flows.</div>
                </div>
                <div class="purifier-share">🔗 Share: Twitter · LinkedIn · Copy Link · Reddit</div>
                <div class="purifier-author">Jane Doe · Senior Developer · Follow · 142 followers</div>
              </div>
            </div>

            <div class="purifier-md-panel">
              <div class="purifier-md-panel__header">
                <span class="purifier-md-panel__title">▶ PURIFIED OUTPUT</span>
                <span class="purifier-md-panel__badge">COPIED ✓</span>
              </div>
              <div class="purifier-md-panel__content">
                <span class="purifier-md-h">## Understanding Async/Await</span><br />
                <span class="purifier-md-body">Async functions allow you to write promise-based code as if it were synchronous. The `await` keyword pauses execution inside an async function until the Promise resolves, without blocking the main thread.</span><br /><br />
                <span class="purifier-md-body">This makes error handling with try/catch natural and keeps the code readable even for complex async flows.</span>
              </div>
              <div class="purifier-md-panel__footer">312 CHARS · NOISE REMOVED</div>
            </div>

            <div class="purifier-toast">✓ Copied as Markdown · 312 chars</div>
          </div>
        </div>
      </div>
    ) : (
      <div class="mockup-wrap">
        <div class="browser-chrome">
          <div class="browser-dot"></div>
          <div class="browser-dot"></div>
          <div class="browser-dot"></div>
          <div class="browser-url">chatgpt.com</div>
        </div>
        <div class="browser-body">
          <div class="fake-chat">
            <div class="chat-msg ai">Hello! How can I help you today?</div>
            <div class="chat-msg user" style="font-size:11px;opacity:0.7">Act as a senior software engineer and review my code for...</div>
            <div class="chat-msg ai" style="opacity:0.6;font-size:11px">Sure! Please share your code and I'll provide a thorough review focusing on...</div>
            <div class="chat-input-row">
              <div class="chat-input" style="color:var(--muted);font-size:11px">Message ChatGPT...</div>
            </div>
          </div>

          <div class="ext-panel">
            <div class="ext-header">
              <span class="ext-logo">▶ PROMPTVAULT</span>
              <span style="color:var(--muted);font-size:10px">⚙</span>
            </div>
            <div class="ext-ai-row">
              <span class="ext-label">TARGET:</span>
              <select class="ext-select"><option>CHATGPT</option></select>
              <span style="color:var(--muted);font-size:9px;border:1px solid var(--border);padding:2px 6px">+ CUSTOM</span>
            </div>
            <div class="ext-form">
              <input class="ext-input" placeholder="prompt_identifier..." readonly>
              <textarea class="ext-textarea" placeholder="// Enter prompt payload..." readonly></textarea>
              <button class="ext-save-btn">+ SAVE PROMPT</button>
            </div>
            <div class="ext-list">
              <div class="ext-card">
                <div class="ext-card-title">CODE_REVIEW_SENIOR</div>
                <div class="ext-card-preview">Act as a senior software engineer and review my code for bugs, performance issues and best practices...</div>
                <div class="ext-card-actions">
                  <div class="ext-action">DEL</div>
                  <div class="ext-action">COPY</div>
                  <div class="ext-action insert">INSERT</div>
                </div>
              </div>
              <div class="ext-card">
                <div class="ext-card-title">EXPLAIN_SIMPLE</div>
                <div class="ext-card-preview">Explain this concept as if I'm a complete beginner. Use simple analogies...</div>
                <div class="ext-card-actions">
                  <div class="ext-action">DEL</div>
                  <div class="ext-action">COPY</div>
                  <div class="ext-action insert">INSERT</div>
                </div>
              </div>
              <div class="ext-card">
                <div class="ext-card-title">WRITE_TESTS</div>
                <div class="ext-card-preview">Write comprehensive unit tests for the following code...</div>
                <div class="ext-card-actions">
                  <div class="ext-action">DEL</div>
                  <div class="ext-action">COPY</div>
                  <div class="ext-action insert">INSERT</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
<hr class="divider">

<style>
  .mockup-subtitle {
    margin-inline: auto;
    text-align: center;
  }

  .lyricos-mock-shell {
    position: relative;
    margin: 40px auto 0;
    max-width: 420px;
  }

  .lyricos-mock-grid {
    position: absolute;
    inset: -24px;
    background-image:
      linear-gradient(color-mix(in srgb, var(--a83-accent) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--a83-accent) 12%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse at center, black 35%, transparent 78%);
    pointer-events: none;
  }

  .lyricos-mock {
    position: relative;
    overflow: hidden;
    margin: 0 auto;
    max-width: 380px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--a83-surface) 88%, #0c1030), color-mix(in srgb, var(--a83-bg) 88%, #090b1f));
    border: 1px solid color-mix(in srgb, var(--a83-accent) 22%, var(--a83-surface));
    border-radius: 4px;
    box-shadow:
      0 0 60px color-mix(in srgb, var(--a83-accent) 16%, transparent),
      0 32px 70px rgba(0, 0, 0, 0.28);
    animation: lyricos-float 5s ease-in-out infinite;
    text-align: left;
  }

  .lyricos-mock::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 30%;
    height: 100%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--a83-accent) 10%, transparent), transparent);
    animation: lyricos-scan 3s ease-in-out infinite;
    pointer-events: none;
  }

  .lyricos-mock-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--a83-bg) 88%, #0c1030), color-mix(in srgb, var(--a83-surface) 82%, #14183a));
    border-bottom: 1px solid color-mix(in srgb, var(--a83-accent) 18%, var(--a83-surface));
  }

  .lyricos-mock-title {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.18em;
    color: var(--a83-accent);
    text-shadow: 0 0 12px color-mix(in srgb, var(--a83-accent) 36%, transparent);
  }

  .lyricos-mock-status {
    padding: 7px 14px;
    background: color-mix(in srgb, var(--a83-surface) 84%, #181c48);
    border-bottom: 1px solid color-mix(in srgb, var(--a83-accent) 18%, var(--a83-surface));
    font-size: 10px;
    color: color-mix(in srgb, #00ffaa 65%, var(--a83-text));
    letter-spacing: 0.08em;
  }

  .lyricos-mock-status::before {
    content: '> ';
    color: color-mix(in srgb, var(--a83-accent) 40%, var(--a83-sub));
  }

  .lyricos-mock-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .lyricos-mock-label {
    margin-bottom: 5px;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--a83-sub);
  }

  .lyricos-mock-modes {
    display: flex;
    gap: 4px;
  }

  .lyricos-mock-btn {
    flex: 1;
    padding: 5px 3px;
    font-size: 9px;
    font-weight: 700;
    text-align: center;
    color: var(--a83-sub);
    background: color-mix(in srgb, var(--a83-surface) 84%, #191d48);
    border: 1px solid color-mix(in srgb, var(--a83-accent) 12%, var(--a83-surface));
    border-radius: 2px;
  }

  .lyricos-mock-btn.active {
    color: var(--a83-accent);
    border-color: var(--a83-accent);
    background: transparent;
    box-shadow: 0 0 6px color-mix(in srgb, var(--a83-accent) 20%, transparent);
  }

  .lyricos-mock-btn.music {
    color: #cc5500;
    border-color: #331500;
  }

  .lyricos-transform {
    width: 100%;
    padding: 11px;
    text-align: center;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.18em;
    color: #0a0a20;
    background: linear-gradient(135deg, #00c8e0, #0099bb);
    border-radius: 2px;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
  }

  .lyricos-output {
    padding: 10px 12px;
    font-size: 10px;
    font-style: italic;
    line-height: 1.7;
    color: var(--a83-sub);
    background: color-mix(in srgb, var(--a83-bg) 90%, #0b0b1e);
    border: 1px solid color-mix(in srgb, var(--a83-accent) 12%, var(--a83-surface));
    border-left: 2px solid var(--a83-accent);
    border-radius: 2px;
  }

  .lyricos-output-tag {
    color: var(--a83-accent);
    font-style: normal;
    font-weight: 700;
  }

  .lyricos-output-line {
    color: var(--a83-text-bold);
  }

  @keyframes lyricos-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes lyricos-scan {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(400%); }
  }

  @media (max-width: 700px) {
    .lyricos-mock-shell {
      max-width: 100%;
    }
  }

  .envswitch-shell {
    margin-top: 40px;
  }

  .envswitch-url-demo {
    max-width: 600px;
    margin: 0 auto 32px;
    text-align: left;
  }

  .envswitch-url-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    font-size: 13px;
  }

  .envswitch-url-bar--active {
    border-color: color-mix(in srgb, var(--a83-accent) 40%, var(--border));
  }

  .envswitch-url-proto {
    color: var(--muted);
  }

  .envswitch-url-host {
    color: var(--text-strong);
    font-weight: 600;
  }

  .envswitch-url-host--active {
    color: var(--a83-accent);
  }

  .envswitch-url-path {
    color: color-mix(in srgb, var(--muted) 65%, var(--a83-bg));
  }

  .envswitch-url-arrow {
    margin: 4px 0;
    text-align: center;
    color: var(--a83-accent);
    opacity: 0.65;
  }

  .envswitch-browser-body {
    background: color-mix(in srgb, var(--a83-bg) 88%, #0f1117);
  }

  .envswitch-fake-page {
    width: 440px;
    display: flex;
    flex-direction: column;
    background: #f5f5f5;
  }

  .envswitch-fake-page__nav {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    color: #111;
  }

  .envswitch-fake-page__logo {
    font-size: 14px;
    font-weight: 700;
  }

  .envswitch-fake-page__navlinks {
    display: flex;
    gap: 16px;
    font-size: 12px;
    color: #6b7280;
  }

  .envswitch-fake-page__body {
    flex: 1;
    padding: 24px 20px;
    color: #111;
  }

  .envswitch-fake-page__breadcrumb {
    margin-bottom: 16px;
    font-size: 11px;
    color: #9ca3af;
  }

  .envswitch-fake-page__title {
    margin-bottom: 8px;
    font-size: 20px;
    font-weight: 700;
  }

  .envswitch-fake-page__price {
    margin-bottom: 16px;
    font-size: 24px;
    font-weight: 700;
    color: #1d4ed8;
  }

  .envswitch-fake-page__btn {
    display: inline-block;
    padding: 10px 20px;
    border-radius: 6px;
    background: #1d4ed8;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  .envswitch-popup {
    width: 260px;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border);
    background: color-mix(in srgb, var(--a83-bg) 90%, #111318);
  }

  .envswitch-popup__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 13px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--a83-bg) 88%, #0f1117);
  }

  .envswitch-popup__logo {
    color: var(--a83-accent);
    font-size: 12px;
    font-weight: 700;
  }

  .envswitch-popup__menu {
    color: color-mix(in srgb, var(--muted) 80%, var(--a83-text));
  }

  .envswitch-popup__urlbar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-bottom: 1px solid var(--border);
  }

  .envswitch-popup__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    flex-shrink: 0;
  }

  .envswitch-popup__host {
    flex: 1;
    font-size: 11px;
    color: color-mix(in srgb, var(--muted) 82%, var(--a83-text));
  }

  .envswitch-popup__badge {
    border-radius: 999px;
    padding: 2px 7px;
    background: color-mix(in srgb, var(--a83-accent) 12%, transparent);
    color: var(--a83-accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .envswitch-popup__project {
    padding: 9px 13px 2px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--muted) 65%, var(--a83-bg));
  }

  .envswitch-popup__envs {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 4px 10px 12px;
  }

  .envswitch-env-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 11px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: color-mix(in srgb, var(--a83-surface) 72%, var(--a83-bg));
    animation: fadeUp 0.3s ease both;
  }

  .envswitch-env-btn.active {
    border-color: var(--a83-accent);
    background: color-mix(in srgb, var(--a83-accent) 8%, transparent);
  }

  .envswitch-env-btn:nth-child(2) { animation-delay: 0.08s; }
  .envswitch-env-btn:nth-child(3) { animation-delay: 0.16s; }

  .envswitch-env-btn__label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-strong);
  }

  .envswitch-env-btn.active .envswitch-env-btn__label {
    color: var(--a83-accent);
  }

  .envswitch-env-btn__host {
    font-size: 10px;
    text-align: right;
    color: color-mix(in srgb, var(--muted) 65%, var(--a83-bg));
