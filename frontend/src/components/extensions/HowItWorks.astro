---
const { sectionLabel, title, steps } = Astro.props;
---
<section id="install">
  <div class="container">
    <p class="section-label" set:html={sectionLabel}></p>
    <h2>{title}</h2>

    <div class="steps">
      {steps.map((step: { num: string; title: string; desc: string }) => (
        <div class="step">
          <div class="step-num">{step.num}</div>
          <div class="step-title">{step.title}</div>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<hr class="divider">
