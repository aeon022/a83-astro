---
const { sectionLabel, title, subtitle, tiers } = Astro.props;

function normalizeFeatures(tier) {
  if (Array.isArray(tier.features)) {
    return tier.features;
  }

  const activeFeatures = String(tier.features ?? '')
    .split('\n')
    .map((item) => item.trim())
    .filter(Boolean)
    .map((text) => ({ text, dim: false }));

  const dimmedFeatures = String(tier.dimmedFeatures ?? '')
    .split('\n')
    .map((item) => item.trim())
    .filter(Boolean)
    .map((text) => ({ text, dim: true }));

  return [...activeFeatures, ...dimmedFeatures];
}
---
<section id="pricing">
  <div class="container">
    <p class="section-label" set:html={sectionLabel}></p>
    <h2>{title}</h2>
    <p class="sub" set:html={subtitle}></p>

    <div class="pricing-grid">
      {tiers.map((tier: { tier: string; amount: string; note: string; features: any[] | string; dimmedFeatures?: string; btn: string; btnUrl: string; featured: boolean }) => (
        <div class={`price-card ${tier.featured ? 'featured' : ''}`}>
          {tier.featured && <div class="price-badge">MOST POPULAR</div>}
          <div class="price-tier">{tier.tier}</div>
          <div class="price-amount" set:html={tier.amount}></div>
          <div class="price-note" set:html={tier.note}></div>
          <ul class="price-features">
            {normalizeFeatures(tier).map((feature: { text: string; dim: boolean }) => (
              <li class={feature.dim ? 'dim' : ''}>{feature.text}</li>
            ))}
          </ul>
          <a href={tier.btnUrl} class={`btn ${tier.featured ? 'btn-primary' : 'btn-ghost'}`} style="width:100%;justify-content:center" target="_blank">{tier.btn}</a>
        </div>
      ))}
    </div>
  </div>
</section>
<hr class="divider">
