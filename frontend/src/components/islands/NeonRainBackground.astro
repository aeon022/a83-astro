---
// src/components/islands/NeonRainBackground.astro
---
<canvas id="real-neon-rain" class="fixed inset-0 z-0 pointer-events-none mix-blend-screen"></canvas>

<script>
  const canvas = document.getElementById('real-neon-rain') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d', { alpha: true });

  if (ctx) {
    let width = canvas.width = window.innerWidth;
    let height = canvas.height = window.innerHeight;

    // ZUSTANDS-STEUERUNG
    let isIntense = false; // Standard: Dezent

    // Wir hören auf globale Signale vom Hero
    window.addEventListener('a83-rain-intensify', () => { isIntense = true; });
    window.addEventListener('a83-rain-normalize', () => { isIntense = false; });

    // BASIS-KALIBRIERUNG (RONIN MIL-SPEC Kojima Orange)
    const rainColor = '255, 75, 18'; 
    // Wenn intensiv, verdreifachen wir die Tropfenanzahl für den "Sturm"-Effekt
    const getDropCount = () => isIntense ? 300 : 80;
    let drops: Drop[] = [];
    let wind = 0.1; 

    const random = (min: number, max: number) => Math.random() * (max - min) + min;

    class Drop {
      x: number = 0;
      y: number = 0;
      length: number = 0;
      speed: number = 0;
      opacity: number = 0;
      layer: number = 0;

      constructor() {
        this.reset(true);
      }

      reset(initial = false) {
        this.layer = Math.floor(random(1, 3));
        this.x = random(0, width);
        this.y = initial ? random(-height, height) : random(-50, 0);
        
        // REAKTIVE PHYSIK:
        if (isIntense) {
            // GHOST IN THE SHELL MODUS: Schnell, hart, sichtbar
            this.speed = this.layer * random(3, 6); // Viel schneller
            this.length = this.layer * random(20, 40); // Längere "Streifen"
            this.opacity = this.layer * 0.25; // Deutlich sichtbarer
        } else {
            // DEZENTER MODUS: Langsam, kaum wahrnehmbar
            this.speed = this.layer * random(0.5, 1.2); 
            this.length = this.layer * random(8, 15);
            this.opacity = this.layer * 0.05; 
        }
      }

      update() {
        this.y += this.speed;
        this.x += wind * this.layer * (isIntense ? 0.5 : 0.2); // Mehr Wind bei Sturm

        if (this.y > height) {
          this.reset();
        }
      }

      draw() {
        ctx.beginPath();
        ctx.strokeStyle = `rgba(${rainColor}, ${this.opacity})`;
        ctx.lineWidth = this.layer * (isIntense ? 0.8 : 0.3); // Dickere Tropfen bei Sturm
        ctx.moveTo(this.x, this.y);
        ctx.lineTo(this.x - (wind * this.layer), this.y - this.length);
        ctx.stroke();
      }
    }

    // Initialisierung
    drops = Array.from({ length: getDropCount() }, () => new Drop());

    function animate() {
      ctx.clearRect(0, 0, width, height);

      // Dynamische Anpassung der Tropfenmenge
      const targetCount = getDropCount();
      if (drops.length < targetCount) {
          drops.push(new Drop());
      } else if (drops.length > targetCount) {
          drops.pop();
      }

      drops.forEach(drop => {
        drop.update();
        drop.draw();
      });

      requestAnimationFrame(animate);
    }

    animate();

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      drops = Array.from({ length: getDropCount() }, () => new Drop());
    });
  }
</script>

<style>
  canvas {
    /* Leichter Blur für Tiefe, mix-blend-screen lässt es leuchten */
    filter: blur(0.5px); 
    z-index: 0; /* Liegt HINTER dem Hero Content (z-10), aber VOR dem Hintergrund */
  }
</style>