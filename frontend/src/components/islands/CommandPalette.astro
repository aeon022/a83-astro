---
// Dateipfad: frontend/src/components/islands/CommandPalette.astro
// Vibe: Tactical HUD / Field Operator Console
// Features: Keyboard First, Dusty Watermark, Kojima-Style

const commands = [
  { id: 'nav-01', label: 'Go to: Portfolio', href: '/work', type: 'NAV' },
  { id: 'nav-02', label: 'Go to: Services', href: '/services', type: 'NAV' },
  { id: 'nav-03', label: 'Go to: Process', href: '/process', type: 'NAV' },
  { id: 'act-01', label: 'Run: ROI Calculator', href: '/#roi-calculator', type: 'EXEC' },
  { id: 'act-02', label: 'Init: Connection Protocol', href: '/contact', type: 'EXEC' },
  { id: 'sys-01', label: 'Mode: Dark', action: 'dark', type: 'SYS' },
  { id: 'sys-02', label: 'Mode: Light', action: 'light', type: 'SYS' },
  { id: 'sys-03', label: 'Mode: System', action: 'system', type: 'SYS' },
];
---

<div 
  id="cmd-overlay" 
  class="fixed inset-0 z-[9999] hidden bg-deep-canvas/90 backdrop-blur-sm flex items-start justify-center pt-[15vh] transition-opacity duration-200 opacity-0"
  aria-hidden="true"
>
  <div 
    id="cmd-container"
    class="relative w-full max-w-2xl bg-deep-canvas border border-veranda-green/40 shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden transform scale-95 transition-all duration-200 ease-out opacity-0"
  >
    
    <div class="absolute top-2 right-4 pointer-events-none select-none z-0 text-right opacity-20 mix-blend-overlay">
       <pre class="font-mono text-[10px] leading-tight text-bone-white blur-[0.5px]">
const sys_root = "COMMAND_MODE";
const permission = "ROOT_ACCESS";
       </pre>
    </div>

    <div class="h-1 w-full bg-veranda-green/20 flex items-center justify-between px-1">
       <div class="w-1/3 h-full bg-veranda-green/40"></div>
       <div class="w-12 h-full bg-a83-accent opacity-50"></div>
    </div>

    <div class="relative p-4 border-b border-veranda-green/20 z-10 bg-deep-canvas/50">
      <div class="flex items-center gap-4">
        <span class="text-a83-accent font-mono text-lg animate-pulse">></span>
        <input 
          type="text" 
          id="cmd-input" 
          placeholder="Enter command..." 
          class="w-full bg-transparent border-none outline-none text-bone-white font-mono text-lg placeholder-veranda-green/30 caret-a83-accent uppercase tracking-wider"
          autocomplete="off"
        />
        <span class="text-[10px] font-mono text-veranda-green/60 border border-veranda-green/20 px-2 py-1 rounded-sm hidden sm:block">
          ESC TO ABORT
        </span>
      </div>
    </div>

    <ul id="cmd-list" class="max-h-[60vh] overflow-y-auto py-2 z-10 relative">
      {commands.map((cmd) => (
        <li class="px-2">
          <a 
            href={cmd.href || '#'} 
            class="cmd-item group flex items-center justify-between p-3 border-l-2 border-transparent hover:border-a83-accent hover:bg-white/5 transition-all cursor-pointer"
            data-label={cmd.label.toLowerCase()}
            data-action={cmd.action}
          >
            <div class="flex items-center gap-4">
               <span class={`font-mono text-[9px] px-1.5 py-0.5 border ${cmd.type === 'EXEC' ? 'border-a83-accent text-a83-accent' : 'border-veranda-green/50 text-veranda-green'}`}>
                 {cmd.type}
               </span>
               <span class="font-mono text-sm text-a83-text group-hover:text-bone-white group-hover:tracking-wide transition-all">
                 {cmd.label}
               </span>
            </div>
            <span class="opacity-0 group-hover:opacity-100 text-a83-accent text-xs font-mono">
              [EXECUTE] ↵
            </span>
          </a>
        </li>
      ))}
      
      <li id="cmd-empty" class="hidden p-8 text-center text-veranda-green/50 font-mono text-sm italic">
        > No matching protocols found.
      </li>
    </ul>

    <div class="bg-black/40 p-2 flex justify-between items-center text-[9px] font-mono text-veranda-green/40 border-t border-veranda-green/10">
       <span>A83_CONSOLE_V2.4</span>
       <div class="flex gap-4">
          <span>NAV: ↑↓</span>
          <span>SELECT: ENTER</span>
       </div>
    </div>

  </div>
</div>

<script>
  const overlay  = document.getElementById('cmd-overlay');
  const container = document.getElementById('cmd-container');
  const input    = document.getElementById('cmd-input') as HTMLInputElement;
  const listItems = document.querySelectorAll('.cmd-item');
  const emptyMsg  = document.getElementById('cmd-empty');

  let isOpen = false;
  let focusedIndex = -1;

  // Returns currently visible items
  function getVisible(): HTMLElement[] {
    return Array.from(listItems).filter(
      (el) => (el as HTMLElement).parentElement!.style.display !== 'none'
    ) as HTMLElement[];
  }

  // Highlight a specific visible item by index
  function setFocused(index: number) {
    const visible = getVisible();
    // Clear all highlights
    visible.forEach((el) => {
      el.classList.remove('border-a83-accent', '!bg-white/5');
      el.classList.add('border-transparent');
    });
    focusedIndex = visible.length === 0 ? -1 : Math.max(0, Math.min(index, visible.length - 1));
    if (focusedIndex >= 0 && visible[focusedIndex]) {
      visible[focusedIndex].classList.remove('border-transparent');
      visible[focusedIndex].classList.add('border-a83-accent', '!bg-white/5');
      visible[focusedIndex].scrollIntoView({ block: 'nearest' });
    }
  }

  function openPalette() {
    if (isOpen) return;
    isOpen = true;
    focusedIndex = -1;
    overlay?.classList.remove('hidden');
    void overlay?.offsetWidth; // Force reflow for transition
    overlay?.classList.remove('opacity-0');
    container?.classList.remove('opacity-0', 'scale-95');
    container?.classList.add('scale-100');
    input.value = '';
    filterItems('');
    input?.focus();
    document.body.style.overflow = 'hidden';
  }

  function closePalette() {
    if (!isOpen) return;
    isOpen = false;
    overlay?.classList.add('opacity-0');
    container?.classList.remove('scale-100');
    container?.classList.add('opacity-0', 'scale-95');
    setTimeout(() => {
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }

  function executeItem(el: HTMLElement) {
    const action = el.getAttribute('data-action');
    if (action === 'dark' || action === 'light') {
      document.documentElement.classList.remove('dark', 'light');
      document.documentElement.classList.add(action);
      localStorage.setItem('theme', action);
      closePalette();
      return;
    }
    if (action === 'system') {
      // Clear override and immediately apply system preference
      localStorage.removeItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.remove('dark', 'light');
      document.documentElement.classList.add(prefersDark ? 'dark' : 'light');
      closePalette();
      return;
    }
    const href = el.getAttribute('href');
    if (href && href !== '#') {
      window.location.href = href;
      closePalette();
    }
  }

  // Keyboard: arrows + enter (keydown so we can preventDefault scroll)
  document.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    const visible = getVisible();

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setFocused(focusedIndex + 1 >= visible.length ? 0 : focusedIndex + 1);
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      setFocused(focusedIndex - 1 < 0 ? visible.length - 1 : focusedIndex - 1);
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      if (focusedIndex >= 0 && visible[focusedIndex]) {
        executeItem(visible[focusedIndex]);
      }
    }
  });

  // Open/close shortcuts (keyup)
  document.addEventListener('keyup', (e) => {
    if (e.key === '?' || (e.shiftKey && e.code === 'Slash') || (e.shiftKey && e.key === '/')) {
      if (!isOpen && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openPalette();
      }
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      isOpen ? closePalette() : openPalette();
    }
    if (e.key === 'Escape' && isOpen) {
      e.preventDefault();
      closePalette();
    }
  });

  // Close on backdrop click
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closePalette();
  });

  // Filter input
  input?.addEventListener('input', (e) => {
    filterItems((e.target as HTMLInputElement).value);
  });

  function filterItems(term: string) {
    const lowerTerm = term.toLowerCase();
    let hasVisible = false;
    listItems.forEach((item) => {
      const el = item as HTMLElement;
      const label = el.getAttribute('data-label') || '';
      if (label.includes(lowerTerm)) {
        el.parentElement!.style.display = 'block';
        hasVisible = true;
      } else {
        el.parentElement!.style.display = 'none';
      }
    });
    if (emptyMsg) emptyMsg.style.display = hasVisible ? 'none' : 'block';
    focusedIndex = -1; // Reset selection after filter
  }

  // Click handler for all items
  document.getElementById('cmd-list')?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest('.cmd-item') as HTMLElement | null;
    if (!item) return;
    e.preventDefault();
    executeItem(item);
  });
</script>