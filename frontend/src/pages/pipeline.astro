---
// Version: V19.3 - CYBER-TERMINAL OVERDRIVE
// Vibe: High-Level Glitch / Neural Link / Military Tech
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pipeline // Overdrive_SOP">
  <div class="fixed inset-0 pointer-events-none z-[100] opacity-[0.03] mix-blend-screen bg-[url('https://media.giphy.com/media/oEI9uWUicKgR2/giphy.gif')]"></div>
  
  <section class="nav-content-sync min-h-screen bg-a83-bg pt-32 pb-40 px-6 lg:px-16 relative overflow-hidden selection:bg-a83-accent selection:text-white">
    
    <div id="grid-bg" class="absolute inset-0 opacity-[0.02] bg-[linear-gradient(var(--veranda-green)_1px,transparent_1px),linear-gradient(90deg,var(--veranda-green)_1px,transparent_1px)] bg-[size:50px_50px] pointer-events-none transition-transform duration-500"></div>

    <div class="max-w-[1200px] mx-auto relative z-10">
        
        <header class="mb-32 border-l-4 border-a83-accent pl-8 py-2 relative group">
            <div class="absolute -left-1 top-0 h-full w-1 bg-a83-accent animate-glitch-flicker"></div>
            <div class="flex items-center gap-4 font-mono text-[11px] text-a83-accent mb-3 tracking-[0.4em] font-black uppercase">
                <span>// PROTOCOL_0193</span>
                <span class="opacity-30">|</span>
                <span class="animate-pulse">SIGNAL_STRONG</span>
            </div>
            <h1 class="text-6xl lg:text-8xl font-black text-a83-text-bold tracking-tighter uppercase leading-none scramble-text" data-value="Execution_Pipeline.">
                Execution_Pipeline.
            </h1>
        </header>

        <div class="relative">
            
            <div class="absolute left-[15px] md:left-1/2 md:-translate-x-1/2 top-0 bottom-0 w-[4px] bg-veranda-green/5 overflow-visible">
                <div id="scroll-progress-line" class="w-full h-full bg-a83-accent origin-top scale-y-0 transition-transform duration-100 ease-linear relative shadow-[0_0_30px_rgba(255,75,18,0.8)]">
                    <div class="absolute inset-0 w-full h-[300%] bg-[linear-gradient(transparent,rgba(255,255,255,0.8),transparent)] animate-energy-surge"></div>
                    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-10 h-10 bg-a83-accent rounded-full blur-[20px] animate-ping"></div>
                </div>
            </div>

            <div class="space-y-56 pb-20">
                
                {['RECON', 'BLUEPRINT', 'DEPLOYMENT', 'EXTRACTION'].map((phase, i) => (
                  <div class={`pipeline-step relative flex flex-col md:flex-row items-start md:items-center gap-12 group ${i % 2 !== 0 ? 'md:flex-row-reverse left-aligned' : 'right-aligned'}`} data-step={i+1}>
                    
                    <div class={`laser hidden md:block absolute ${i % 2 !== 0 ? 'right-1/2 origin-right' : 'left-1/2 origin-left'} top-1/2 h-[2px] bg-a83-accent scale-x-0 group-[.active]:scale-x-100 transition-transform duration-500 ease-out w-[calc(50%-3rem)] z-0 shadow-[0_0_20px_var(--a83-accent)]`}></div>

                    <div class="flex-1 hidden md:block opacity-0 group-[.active]:opacity-100 transition-all duration-700 transform group-[.active]:translate-x-0 translate-x-10 group-[.left-aligned]:-translate-x-10">
                        <span class="font-mono text-[10px] text-veranda-green font-black tracking-[0.5em] uppercase">Phase_0{i+1}_Status_Active</span>
                    </div>
                    
                    <div class="pipeline-node relative z-20 shrink-0">
                        <div class="node-box w-10 h-10 bg-a83-bg border-2 border-a83-accent/30 flex items-center justify-center group-[.active]:border-a83-accent group-[.active]:rotate-45 transition-all duration-500">
                            <div class="w-2 h-2 bg-a83-accent opacity-0 group-[.active]:opacity-100 group-[.active]:-rotate-45"></div>
                            <div class="absolute inset-0 border border-a83-accent opacity-0 group-[.active]:animate-fractal-1"></div>
                            <div class="absolute inset-0 border border-a83-accent opacity-0 group-[.active]:animate-fractal-2"></div>
                        </div>
                    </div>

                    <div class="flex-1 relative z-10">
                        <div class="content-glitch-box opacity-0 group-[.active]:opacity-100 transition-all duration-300">
                            <div class="bg-a83-surface/40 backdrop-blur-md border border-veranda-green/20 p-8 lg:p-12 group-[.active]:animate-entry-glitch relative overflow-hidden">
                                <div class="absolute top-2 right-2 font-mono text-[8px] opacity-20 group-[.active]:opacity-100">00{i+1}_MOD</div>
                                
                                <span class="font-mono text-[10px] text-a83-accent font-black tracking-widest block mb-4 uppercase">System_Link_{phase}</span>
                                <h3 class="text-4xl font-black text-a83-text-bold uppercase tracking-tighter mb-4 group-[.active]:animate-chromatic">
                                    {i === 0 && "Intelligence & Audit."}
                                    {i === 1 && "Architecture & UI."}
                                    {i === 2 && "Execution & Build."}
                                    {i === 3 && "Mission_Complete."}
                                </h3>
                                <div class="w-12 h-1 bg-a83-accent mb-6 scale-x-0 group-[.active]:scale-x-100 transition-transform duration-700 origin-left"></div>
                                <p class="font-mono text-xs text-a83-text-bold/60 leading-relaxed uppercase">
                                    {i === 0 && "Radikaler Scan deiner Infrastruktur. Wir finden den Bloat und eliminieren Komplexität."}
                                    {i === 1 && "Entwicklung des kinetischen Interfaces. Taktische UI für maximale Conversion-Effizienz."}
                                    {i === 2 && "Hardcoding ohne Overhead. Astro & Tailwind v4 in ihrer reinsten Deployment-Form."}
                                    {i === 3 && "Extraktion und Go-Live. Das System läuft stabil. Handover an den Operator abgeschlossen."}
                                </p>
                            </div>
                        </div>
                    </div>
                  </div>
                ))}

            </div>
        </div>

        <div class="mt-40 bg-a83-accent p-16 text-center group relative overflow-hidden active:scale-95 transition-transform">
            <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-10 transition-opacity animate-pulse"></div>
            <div class="absolute top-0 left-0 w-full h-1 bg-white/20 animate-data-flow"></div>
            <h2 class="text-5xl lg:text-7xl font-black text-a83-bg uppercase tracking-tighter mb-8 relative z-10">Einstieg_Bestätigen.</h2>
            <a href="/contact" class="relative z-10 inline-block bg-a83-bg text-a83-accent px-12 py-5 font-mono text-sm font-black uppercase tracking-[0.4em] hover:invert transition-all">Start_Project.sh</a>
        </div>

    </div>
  </section>
</BaseLayout>

<script>
  // SCRAMBLE TEXT LOGIC
  const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789";
  document.querySelectorAll('.scramble-text').forEach((el: any) => {
    el.onmouseover = () => {
      let iteration = 0;
      const interval = setInterval(() => {
        el.innerText = el.innerText.split("").map((l: any, i: number) => {
          if(i < iteration) return el.dataset.value[i];
          return letters[Math.floor(Math.random() * 36)];
        }).join("");
        if(iteration >= el.dataset.value.length) clearInterval(interval);
        iteration += 1 / 3;
      }, 30);
    }
  });

  // SCROLL SYNC
  window.addEventListener('scroll', () => {
    const progressLine = document.getElementById('scroll-progress-line');
    const bgGrid = document.getElementById('grid-bg');
    const scrollPct = Math.min(window.scrollY / (document.body.scrollHeight - window.innerHeight) * 1.4, 1);
    
    if (progressLine) progressLine.style.transform = `scaleY(${scrollPct})`;
    if (bgGrid) bgGrid.style.transform = `translateY(${window.scrollY * -0.05}px)`;

    document.querySelectorAll('.pipeline-step').forEach((step) => {
      const rect = step.getBoundingClientRect();
      const isActive = rect.top < window.innerHeight * 0.6;
      step.classList.toggle('active', isActive);
    });
  }, { passive: true });
</script>

<style is:global>
  /* 1. Energy Surge in Pipe */
  @keyframes energy-surge {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  .animate-energy-surge {
    animation: energy-surge 1.5s ease-in-out infinite;
  }

  /* 2. Fractal Node Discharge */
  @keyframes fractal {
    0% { transform: scale(1) rotate(0deg); opacity: 1; }
    100% { transform: scale(3) rotate(90deg); opacity: 0; }
  }
  .animate-fractal-1 { animation: fractal 0.8s ease-out forwards; }
  .animate-fractal-2 { animation: fractal 0.8s ease-out 0.2s forwards; }

  /* 3. Glitch Entry Materialization */
  @keyframes entry-glitch {
    0% { clip-path: inset(50% 0 50% 0); transform: skewX(20deg) scale(0.9); }
    40% { clip-path: inset(0 0 0 0); transform: skewX(-10deg) scale(1.05); }
    70% { transform: skewX(5deg); }
    100% { clip-path: inset(0 0 0 0); transform: skewX(0deg) scale(1); }
  }
  .group.active .content-glitch-box {
      animation: entry-glitch 0.6s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }

  /* 4. Chromatic Aberration on Active Text */
  @keyframes chromatic {
    0%, 100% { text-shadow: 2px 0 0 #ff4b12, -2px 0 0 #00ffff; }
    50% { text-shadow: -2px 0 0 #ff4b12, 2px 0 0 #00ffff; }
  }
  .group.active .animate-chromatic {
      animation: chromatic 0.2s ease-in-out infinite;
  }

  @keyframes glitch-flicker {
      0% { opacity: 1; transform: scaleY(1); }
      10% { opacity: 0.5; transform: scaleY(0.8); }
      20% { opacity: 1; transform: scaleY(1.1); }
      100% { opacity: 1; transform: scaleY(1); }
  }
  .animate-glitch-flicker { animation: glitch-flicker 2s infinite; }
</style>