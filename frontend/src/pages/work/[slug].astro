---
// Version: V15.5 - SHOWCASE BLUEPRINT WITH MEDIA
// Update: Integrated coverImage and precise singular-collection mapping

import BaseLayout from '../../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const { slug } = Astro.params;

// Daten aus der Singular-Collection 'showcase' laden
const mission = await reader.collections.showcase.read(slug as string);

if (!mission) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`${mission.title} | Mission_Log`}>
  <section class="min-h-screen bg-a83-bg pt-32 pb-20 px-6 lg:px-16 overflow-x-hidden relative selection:bg-a83-accent selection:text-white">
    
    <div class="absolute inset-0 opacity-[0.015] bg-[linear-gradient(var(--veranda-green)_1px,transparent_1px),linear-gradient(90deg,var(--veranda-green)_1px,transparent_1px)] bg-[size:30px_30px] pointer-events-none"></div>

    <div class="max-w-[1600px] mx-auto mb-10 flex items-center justify-between border-b border-veranda-green/20 pb-6 relative z-20">
        <div class="flex items-center gap-4 font-mono text-[10px] text-a83-text-bold uppercase tracking-[0.3em]">
            <a href="/" class="hover:text-a83-accent transition-colors font-bold">A83_ROOT</a>
            <span class="opacity-30">/</span>
            <a href="/work" class="hover:text-a83-accent transition-colors font-bold">REPORTS</a>
            <span class="opacity-30">/</span>
            <span class="text-a83-accent font-black">{mission.entity}</span>
        </div>
        <div class="hidden md:flex items-center gap-6 font-mono text-[10px]">
            <span class="text-veranda-green font-bold uppercase tracking-widest">DECRYPTING_MISSION_LOG</span>
            <span class="text-a83-accent animate-pulse font-black">● LIVE_FEED</span>
        </div>
    </div>

    <div class="max-w-[1600px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 w-full auto-rows-min relative z-10">
        
        <div class="md:col-span-8 bg-a83-surface/40 border border-veranda-green/20 relative overflow-hidden group min-w-0 w-full min-h-[400px]">
            {mission.coverImage ? (
              <img 
                src={mission.coverImage} 
                alt={mission.title} 
                class="absolute inset-0 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700 opacity-60 group-hover:opacity-100 group-hover:scale-105"
              />
            ) : (
              <div class="absolute inset-0 bg-deep-canvas flex items-center justify-center font-mono text-veranda-green/20">NO_VISUAL_DATA</div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-deep-canvas via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute bottom-8 left-8 z-10">
                <span class="bg-a83-accent text-a83-bg font-mono text-[10px] font-black px-2 py-0.5 uppercase mb-4 inline-block">Visual_Archive</span>
                <h1 class="text-2xl sm:text-4xl lg:text-7xl font-black text-white tracking-tighter uppercase leading-tight sm:leading-[0.85]">{mission.title}</h1>
            </div>
        </div>

        <div class="md:col-span-4 bg-a83-surface/40 border border-veranda-green/20 p-8 flex flex-col justify-between min-w-0 w-full">
            <div class="space-y-6">
                <div class="flex justify-between items-start border-b border-veranda-green/20 pb-4">
                    <span class="font-mono text-[11px] text-a83-text-bold uppercase font-bold tracking-widest">Entity</span>
                    <span class="text-a83-text-bold font-mono text-[11px] font-black uppercase text-right">{mission.entity}</span>
                </div>
                <div class="flex justify-between items-start border-b border-veranda-green/20 pb-4">
                    <span class="font-mono text-[11px] text-a83-text-bold uppercase font-bold tracking-widest">Vector</span>
                    <span class="text-a83-text-bold font-mono text-[11px] font-black uppercase text-right">{mission.vector}</span>
                </div>
                <div class="flex justify-between items-start border-b border-veranda-green/20 pb-4">
                    <span class="font-mono text-[11px] text-a83-text-bold uppercase font-bold tracking-widest">Cycle</span>
                    <span class="text-a83-text-bold font-mono text-[11px] font-black uppercase">{mission.cycle}</span>
                </div>
            </div>

            <div class="pt-10">
                <span class="block font-mono text-[10px] text-a83-text-bold/50 uppercase mb-2 tracking-[0.2em] font-bold">Final_Status</span>
                <span class="text-3xl lg:text-4xl font-black text-a83-accent tracking-tighter uppercase">{mission.finalStatus}</span>
            </div>
        </div>

        <div class="md:col-span-12 bg-a83-surface/40 border border-veranda-green/20 p-8 lg:p-14 min-w-0 w-full">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="md:w-1/3 shrink-0">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-px bg-a83-accent/60"></div>
                        <h3 class="font-mono text-[11px] text-a83-accent uppercase tracking-[0.4em] font-black">LOG_SUMMARY</h3>
                    </div>
                    <p class="text-xl font-mono text-a83-text-bold font-bold leading-tight uppercase">
                        {mission.protocolReadout}
                    </p>
                </div>
                <div class="flex-1 border-l border-veranda-green/20 pl-0 md:pl-12">
                    <div class="font-mono text-sm text-a83-text-bold/80 leading-relaxed whitespace-pre-line">
                        {mission.taskProtocol}
                    </div>
                </div>
            </div>
        </div>

        <div class="md:col-span-12 lg:col-span-9 bg-a83-surface/40 border border-veranda-green/20 p-8 lg:p-12 min-w-0">
             <div class="flex items-center gap-3 mb-10">
                <div class="w-10 h-px bg-a83-accent/60"></div>
                <h3 class="font-mono text-[11px] text-a83-accent uppercase tracking-[0.4em] font-black">FIX_EXECUTED</h3>
            </div>
            <div class="font-mono text-[15px] text-a83-text-bold leading-relaxed whitespace-pre-line bg-a83-bg p-8 border-l-4 border-a83-accent">
                {mission.fixExecuted}
            </div>
        </div>

        <div class="md:col-span-12 lg:col-span-3 bg-a83-surface/40 border border-veranda-green/20 p-8 flex flex-col gap-6 min-w-0">
            <h3 class="font-mono text-[11px] text-a83-accent uppercase font-black tracking-[0.3em] border-b border-veranda-green/20 pb-4">Stack_Deployed</h3>
            <div class="flex flex-col gap-3">
                {mission.stackDeployed?.map((tech: string) => (
                    <div class="border border-veranda-green/20 px-4 py-2 bg-a83-bg/50 font-mono text-[10px] text-a83-text-bold font-bold uppercase tracking-widest hover:border-a83-accent transition-colors">
                        > {tech}
                    </div>
                ))}
            </div>
            <div class="mt-auto pt-6 opacity-30">
                <span class="block font-mono text-[8px] uppercase tracking-widest leading-none">Arch_Ref</span>
                <span class="font-mono text-[10px] font-bold truncate block">{mission.arch}</span>
            </div>
        </div>

    </div>

    {mission.gatewayUri && (
        <div class="max-w-[1600px] mx-auto mt-8">
            <a href={mission.gatewayUri} target="_blank" class="group relative block bg-a83-accent p-10 text-center overflow-hidden transition-all duration-500 active:scale-[0.99]">
                <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-10 transition-opacity"></div>
                <div class="relative z-10 font-mono text-xl lg:text-2xl font-black text-a83-bg uppercase tracking-[0.3em]">
                    Access_Live_Gateway_
                </div>
            </a>
        </div>
    )}

  </section>
</BaseLayout>