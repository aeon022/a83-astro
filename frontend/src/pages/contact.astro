---
// Version: V17.2 - SECURE CONNECTION GATEWAY (SOCIAL SYNC)
// Vibe: Encrypted Handshake / Terminal Input
// Path: src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/core/SEO.astro';

---

<BaseLayout title="Contact // Init_Handshake">

<SEO 
    slot="head" 
    title="Contact // Projekt-Handshake initiieren" 
    description="Bereit für den direkten Uplink? Kontaktiere ABTEILUNG83 für dein nächstes High-Performance Web-Projekt. Keine Agentur-Umwege."
  />

  <section class="nav-content-sync min-h-screen bg-a83-bg pt-32 pb-20 px-6 lg:px-16 relative overflow-hidden selection:bg-a83-accent selection:text-white">
    
    <div class="absolute inset-0 opacity-[0.015] bg-[linear-gradient(var(--veranda-green)_1px,transparent_1px),linear-gradient(90deg,var(--veranda-green)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>

    <div class="max-w-[1200px] mx-auto relative z-10">
        
        <header class="mb-12 border-l-4 border-a83-accent pl-8 py-2">
            <div class="flex items-center gap-4 font-mono text-[11px] text-a83-accent mb-3 tracking-[0.4em] font-black uppercase">
                <span>// CONNECTION_INITIATION</span>
                <span class="opacity-30">|</span>
                <span>SECURE_UPLINK_v.5.2</span>
            </div>
            <h1 class="text-6xl lg:text-8xl font-black text-a83-text-bold tracking-tighter uppercase leading-none">
                Get_In_Touch.
            </h1>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <form id="contact-form" action="/api/contact" method="POST" class="lg:col-span-8 bg-a83-surface/30 border border-veranda-green/20 p-8 lg:p-12 space-y-10 relative">
                <div class="absolute top-0 right-0 p-4 font-mono text-[8px] text-veranda-green/20 uppercase tracking-widest">
                    Handshake_Protocol_Active
                </div>

                <div id="form-success" class="hidden border border-a83-accent/40 bg-a83-accent/10 p-6 font-mono text-sm text-a83-accent uppercase tracking-widest">
                    // Transmission_Received — ich melde mich so bald wie möglich.
                </div>
                <div id="form-error" class="hidden border border-red-500/40 bg-red-500/10 p-6 font-mono text-sm text-red-400 uppercase tracking-widest">
                    // Transmission_Failed — bitte direkt an post@abteilung83.com schreiben.
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="space-y-4">
                        <label class="block font-mono text-[10px] text-a83-text-bold uppercase font-black tracking-widest opacity-60">01_Entity_Name</label>
                        <input name="name" type="text" placeholder="DEIN NAME / FIRMA" class="w-full bg-transparent border-b-2 border-veranda-green/20 py-4 font-mono text-xl text-a83-text-bold focus:border-a83-accent outline-none transition-colors placeholder:text-veranda-green/20 uppercase" required />
                    </div>
                    <div class="space-y-4">
                        <label class="block font-mono text-[10px] text-a83-text-bold uppercase font-black tracking-widest opacity-60">02_Communication_Node</label>
                        <input name="email" type="email" placeholder="EMAIL_ADRESSE" class="w-full bg-transparent border-b-2 border-veranda-green/20 py-4 font-mono text-xl text-a83-text-bold focus:border-a83-accent outline-none transition-colors placeholder:text-veranda-green/20 uppercase" required />
                    </div>
                </div>

                <div class="space-y-6">
                    <label class="block font-mono text-[10px] text-a83-text-bold uppercase font-black tracking-widest opacity-60">03_Requested_Module</label>
                    <div class="flex flex-wrap gap-3">
                        {['One-Pager', 'Custom_Dev', 'UI/UX_Audit', 'Rescue_Op', 'Other'].map(service => (
                            <label class="cursor-none group">
                                <input type="radio" name="service" value={service} class="peer hidden" />
                                <span class="px-6 py-2 border border-veranda-green/20 font-mono text-[11px] text-a83-text-bold/50 uppercase font-bold peer-checked:bg-a83-accent peer-checked:text-a83-bg peer-checked:border-a83-accent transition-all group-hover:border-a83-accent/50 block">
                                    {service}
                                </span>
                            </label>
                        ))}
                    </div>
                </div>

                <div class="space-y-4">
                    <label class="block font-mono text-[10px] text-a83-text-bold uppercase font-black tracking-widest opacity-60">04_Mission_Briefing</label>
                    <textarea name="message" rows="4" placeholder="BESCHREIB DEIN PROJEKT..." class="w-full bg-a83-bg/30 border border-veranda-green/20 p-6 font-mono text-lg text-a83-text-bold focus:border-a83-accent outline-none transition-colors placeholder:text-veranda-green/20 uppercase resize-none"></textarea>
                </div>

                <button id="submit-btn" type="submit" class="w-full bg-a83-accent p-8 font-mono text-2xl font-black text-a83-bg uppercase tracking-[0.3em] hover:brightness-110 active:scale-[0.99] transition-all relative overflow-hidden group disabled:opacity-50 disabled:cursor-not-allowed">
                    <span id="submit-label" class="relative z-10">Execute_Handshake_</span>
                    <div class="absolute inset-0 -translate-x-full bg-white opacity-10 group-hover:translate-x-0 transition-transform duration-700 ease-out"></div>
                </button>
            </form>

            <aside class="lg:col-span-4 space-y-8">
                <div class="bg-a83-surface/30 border border-veranda-green/20 p-8 space-y-6">
                    <span class="block font-mono text-[10px] text-a83-accent font-black uppercase tracking-[0.4em] border-b border-a83-accent/20 pb-4">// DIRECT_UPLINK</span>
                    <div class="space-y-4 font-mono text-sm text-a83-text-bold uppercase">
                        <div>
                            <span class="block text-[9px] text-veranda-green uppercase font-bold tracking-widest mb-1">Mail_Channel</span>
                            <a href="mailto:post@abteilung83.com" class="hover:text-a83-accent transition-colors">post@abteilung83.com</a>
                        </div>
                        <div>
                            <span class="block text-[9px] text-veranda-green uppercase font-bold tracking-widest mb-1">Comms_Line</span>
                            <a href="tel:+436605672361" class="hover:text-a83-accent transition-colors">+43 660 567 23 61</a>
                        </div>
                        <div>
                            <span class="block text-[9px] text-veranda-green uppercase font-bold tracking-widest mb-1">Location_Node</span>
                            <p>GRAZ_CENTRAL // AUSTRIA</p>
                        </div>
                    </div>
                </div>

                <div class="bg-a83-surface/30 border border-veranda-green/20 p-8 space-y-6">
                    <span class="block font-mono text-[10px] text-a83-accent font-black uppercase tracking-[0.4em] border-b border-a83-accent/20 pb-4">// SOCIAL_NODES</span>
                    <div class="grid grid-cols-1 gap-3 font-mono text-[11px] uppercase font-bold">
                        <a href="https://www.linkedin.com/in/gerwin-weiher/" target="_blank" class="flex items-center gap-3 text-a83-text-bold/60 hover:text-a83-accent transition-all group">
                            <span class="w-2 h-px bg-veranda-green/30 group-hover:w-4 group-hover:bg-a83-accent transition-all"></span> LinkedIn
                        </a>
                        <a href="https://www.instagram.com/gerwin.weiher/" target="_blank" class="flex items-center gap-3 text-a83-text-bold/60 hover:text-a83-accent transition-all group">
                            <span class="w-2 h-px bg-veranda-green/30 group-hover:w-4 group-hover:bg-a83-accent transition-all"></span> Instagram
                        </a>
                        <a href="https://x.com/gerwinweiher" target="_blank" class="flex items-center gap-3 text-a83-text-bold/60 hover:text-a83-accent transition-all group">
                            <span class="w-2 h-px bg-veranda-green/30 group-hover:w-4 group-hover:bg-a83-accent transition-all"></span> X_Twitter
                        </a>
                        <a href="https://www.youtube.com/@aeon022" target="_blank" class="flex items-center gap-3 text-a83-text-bold/60 hover:text-a83-accent transition-all group">
                            <span class="w-2 h-px bg-veranda-green/30 group-hover:w-4 group-hover:bg-a83-accent transition-all"></span> YouTube
                        </a>
                        <a href="https://github.com/aeon022" target="_blank" class="flex items-center gap-3 text-a83-text-bold/60 hover:text-a83-accent transition-all group">
                            <span class="w-2 h-px bg-veranda-green/30 group-hover:w-4 group-hover:bg-a83-accent transition-all"></span> GitHub
                        </a>
                    </div>
                </div>

                <div class="bg-deep-canvas/10 border-l-2 border-a83-accent p-8 font-mono">
                    <span class="block text-[10px] text-a83-text-bold font-black uppercase mb-4 tracking-widest">// SECURITY_PROTOCOL</span>
                    <p class="text-[11px] text-a83-text-bold/60 leading-relaxed italic uppercase font-medium">
                        Deine Daten werden über einen gesicherten End-to-End-Kanal übertragen. Keine Speicherung in Drittanbieter-Clouds ohne deine explizite Autorisierung.
                    </p>
                </div>
            </aside>
        </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement;
  const btn     = document.getElementById('submit-btn') as HTMLButtonElement;
  const label   = document.getElementById('submit-label') as HTMLSpanElement;
  const success = document.getElementById('form-success') as HTMLDivElement;
  const error   = document.getElementById('form-error') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    label.textContent = 'Transmitting_...';
    success.classList.add('hidden');
    error.classList.add('hidden');

    try {
      const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
      if (res.ok) {
        success.classList.remove('hidden');
        form.reset();
      } else {
        error.classList.remove('hidden');
      }
    } catch {
      error.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      label.textContent = 'Execute_Handshake_';
    }
  });
</script>

<style>
  input:focus, textarea:focus {
    box-shadow: 0 0 15px rgba(255, 75, 18, 0.1);
  }
</style>