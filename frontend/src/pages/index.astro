---
// Dateipfad: frontend/src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CommandPalette from '../components/islands/CommandPalette.astro';
import Pill from '../components/ui/Pill.astro';
import Hero from '../components/blocks/Hero.astro';
import Manifesto from '../components/blocks/Manifesto.astro';
import Process from '../components/blocks/Process.astro';
import Highlights from '../components/blocks/Highlights.astro';
import Services from '../components/blocks/Services.astro';

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);

// Parallel Data Fetching
const [settings, showcaseProjects, serviceModules] = await Promise.all([
  reader.singletons.globalSettings.read(),
  reader.collections.showcase.all(),
  reader.collections.services.all()
]);

const highlightProjects = showcaseProjects.filter(
  project => project.entry.isHighlighted === true
);

const headline = settings?.headline || 'Less Noise. Nice Data. No Bloat.';
const systemStatus = settings?.status === 'active' ? 'ACTIVE_NODE' : 'MAINTENANCE_MODE';
---

<BaseLayout title={headline}>
  
  <div class="flex flex-col items-center w-full font-mono text-a83-text">
    
    {/* 1. HERO */}
    <div class="w-full relative">
      <Hero />
      
      <div class="nav-content-sync absolute bottom-12 left-0 right-0 z-30 flex flex-col items-center pointer-events-none">
        <div class="flex flex-wrap gap-4 justify-center pointer-events-auto interactive-element" data-sound="hover">
          <Pill text={`status: ${systemStatus}`} theme="neon" />
          <Pill text="engine: astro_v5" theme="dark" />
          <Pill text="zero_bloat: true" theme="outline" />
        </div>

        <div class="flex justify-center mt-6">
           <div class="animate-pulse text-sm text-a83-sub font-mono tracking-widest text-center">
              Press <kbd class="bg-black/50 border border-a83-sub/30 rounded px-2 py-1 text-white">Cmd</kbd> + <kbd class="bg-black/50 border border-a83-sub/30 rounded px-2 py-1 text-white">K</kbd> to execute
           </div>
        </div>
      </div>
    </div>

    {/* 2. MANIFESTO */}
    <Manifesto />

    {/* 3. PROCESS */}   
    <Process />

    {/* 4. HIGHLIGHTS */}
    {highlightProjects.length > 0 && (
      <Highlights projects={highlightProjects} />
    )}

    {/* 5. SERVICES (Jetzt am Ende der Kette) */}
    <Services modules={serviceModules} />

  </div>

  <CommandPalette />
</BaseLayout>