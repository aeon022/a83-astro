---
// Version: V15.0 - CENTRAL_COMMAND_SNAP_ENGINE
// Vibe: Central Command / Dashboard
// Update: Full CSS Scroll-Snap Integration

import BaseLayout from '../layouts/BaseLayout.astro';
import Pill from '../components/ui/Pill.astro';
import SEO from '../components/core/SEO.astro';

// Content Blocks
import Hero from '../components/blocks/Hero.astro';
import Manifesto from '../components/blocks/Manifesto.astro';
import Process from '../components/blocks/Process.astro';
import Highlights from '../components/blocks/Highlights.astro';
import Services from '../components/blocks/Services.astro';
import KnowledgeBase from '../components/blocks/KnowledgeBase.astro';
import ContactCTA from '../components/blocks/ContactCTA.astro';

// Data Layer (Keystatic)
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);

// Parallel Data Fetching
const [settings, showcaseProjects] = await Promise.all([
  reader.singletons.globalSettings.read(),
  reader.collections.showcase.all(),
]);

const highlightProjects = showcaseProjects.filter(
  project => project.entry.isHighlighted === true
);

const headline = settings?.headline || 'Less Noise. Nice Data. No Bloat.';
const systemStatus = settings?.status === 'active' ? 'ACTIVE_NODE' : 'MAINTENANCE_MODE';
---

<BaseLayout title={headline} isSnappable={true}>

  <SEO 
    slot="head" 
    title="ABTEILUNG83 // Digital Systems Engineering Graz" 
    description="Webdesign & High-Performance Entwicklung. Ich baue Astro & WordPress Systeme ohne Bloat. Strategie, Performance und ROI für dein digitales Asset."
  />
  
  {/* 1. HERO SECTION (Locked to Viewport) */}
  <div class="w-full snap-start snap-always relative group overflow-hidden">
    <Hero />
    
    {/* OVERLAY UI (Nav-Sync) */}
    <div class="nav-content-sync absolute bottom-12 left-0 right-0 z-30 flex flex-col items-center pointer-events-none transition-all duration-500">
      <div class="flex flex-wrap gap-4 justify-center pointer-events-auto interactive-element">
        <Pill text={`status: ${systemStatus}`} theme="neon" />
        <Pill text="engine: astro_v5" theme="dark" />
        <Pill text="zero_bloat: true" theme="outline" />
      </div>

      <div class="flex justify-center mt-6 opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-500">
         <div class="text-[10px] text-veranda-green font-mono tracking-widest text-center uppercase">
            Press <kbd class="bg-deep-canvas border border-veranda-green/30 rounded-sm px-1.5 py-0.5 text-bone-white font-bold font-mono">Cmd</kbd> + <kbd class="bg-deep-canvas border border-veranda-green/30 rounded-sm px-1.5 py-0.5 text-bone-white font-bold font-mono">K</kbd> to execute
         </div>
      </div>
    </div>
  </div>

  {/* 2. MANIFESTO */}
  <section class="w-full snap-start snap-always">
    <Manifesto />
  </section>

  {/* 3. PIPELINE / PROCESS */}   
  <section class="w-full snap-start snap-always">
    <Process />
  </section>

  {/* 4. HIGHLIGHTS (Conditional) */}
  {highlightProjects.length > 0 && (
    <section class="w-full snap-start snap-always">
      <Highlights projects={highlightProjects} />
    </section>
  )}

  {/* 5. SERVICES */}
  <section class="w-full snap-start snap-always">
    <Services />
  </section>

  {/* 6. KNOWLEDGE BASE (FAQ) 
      Hier nutzen wir snap-proximity, falls die Liste sehr lang wird, 
      damit der User in der Mitte der Liste stoppen kann.
  */}
  <section class="w-full snap-start snap-proximity">
    <KnowledgeBase />
  </section>

  {/* 7. CONTACT SECTION */}
  <section class="w-full snap-start snap-always">
    <ContactCTA />
  </section>


</BaseLayout>