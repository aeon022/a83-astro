---
// Dateipfad: frontend/src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CommandPalette from '../components/islands/CommandPalette.astro';
import Pill from '../components/ui/Pill.astro';
import Hero from '../components/blocks/Hero.astro';
import Manifesto from '../components/blocks/Manifesto.astro';

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const settings = await reader.singletons.globalSettings.read();
const showcaseProjects = await reader.collections.showcase.all();
const pricingModels = await reader.collections.pricing.all();

const headline = settings?.headline || 'Less Noise. Nice Data. No Bloat.';
const systemStatus = settings?.status === 'active' ? 'ACTIVE_NODE' : 'MAINTENANCE_MODE';
---

<BaseLayout title={headline}>
  
  <div class="flex flex-col items-center w-full font-mono text-a83-text">
    
    {/* =========================================
        HERO SECTION 
        ========================================= */}
    <div class="w-full relative">
      <Hero />
      
      <div class="nav-content-sync absolute bottom-12 left-0 right-0 z-30 flex flex-col items-center pointer-events-none">
        
        <div class="flex flex-wrap gap-4 justify-center pointer-events-auto interactive-element" data-sound="hover">
          <Pill text={`status: ${systemStatus}`} theme="neon" />
          <Pill text="engine: astro_v5" theme="dark" />
          <Pill text="zero_bloat: true" theme="outline" />
        </div>

        <div class="flex justify-center mt-6">
           <div class="animate-pulse text-sm text-a83-sub font-mono tracking-widest text-center">
              Press <kbd class="bg-black/50 border border-a83-sub/30 rounded px-2 py-1 text-white">Cmd</kbd> + <kbd class="bg-black/50 border border-a83-sub/30 rounded px-2 py-1 text-white">K</kbd> to execute
           </div>
        </div>
        
      </div>
    </div>

    {/* =========================================
        MANIFESTO (System Core / Hero 2)
        ========================================= */}
    <Manifesto />

    {/* =========================================
        DYNAMIC DATA SECTIONS (Missions & Contracts)
        ========================================= */}
    <main class="nav-content-sync w-full max-w-[1600px] px-6 lg:px-16 py-32 flex flex-col gap-40">

      {/* --- SHOWCASE --- */}
      <section class="flex flex-col gap-10">
        <div class="inline-block bg-a83-surface/50 px-4 py-2 border-l-2 border-a83-accent w-max">
          <h2 class="text-xl md:text-2xl uppercase tracking-[0.2em] font-bold text-white">// DECLASSIFIED_MISSIONS</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {showcaseProjects.map((project) => (
            <article class="border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] p-8 md:p-10 hover:border-a83-accent/50 transition-all duration-300 group relative overflow-hidden">
              
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--a83-accent)_10%,transparent)_0%,transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

              <h3 class="text-2xl md:text-3xl font-bold mb-6 text-white tracking-tight">> {project.slug}</h3>
              
              <div class="grid grid-cols-2 gap-y-4 gap-x-8 mb-8 text-sm md:text-base border-b border-white/10 pb-8 text-white/60">
                <div><span class="opacity-40 block text-xs tracking-widest uppercase mb-1">Entity</span> <span class="text-white">{project.entry.entity}</span></div>
                <div><span class="opacity-40 block text-xs tracking-widest uppercase mb-1">Vector</span> <span class="text-white">{project.entry.vector}</span></div>
                <div><span class="opacity-40 block text-xs tracking-widest uppercase mb-1">Arch</span> <span class="text-white">{project.entry.arch}</span></div>
                <div><span class="opacity-40 block text-xs tracking-widest uppercase mb-1">Cycle</span> <span class="text-white">{project.entry.cycle}</span></div>
              </div>

              <div class="space-y-6 text-sm md:text-base opacity-80 mb-10">
                <p class="italic whitespace-pre-wrap text-a83-accent/80 font-mono text-xs">[{project.entry.protocolReadout}]</p>
                
                <div class="pl-4 border-l border-white/20">
                  <span class="opacity-40 block mb-2 text-xs tracking-widest uppercase">Task_Protocol</span>
                  <div class="text-white/80 whitespace-pre-wrap leading-relaxed">{project.entry.taskProtocol}</div>
                </div>

                <div class="pl-4 border-l border-a83-accent/40">
                  <span class="opacity-40 block mb-2 text-xs tracking-widest uppercase">Fix_Executed</span>
                  <div class="text-white whitespace-pre-wrap leading-relaxed">{project.entry.fixExecuted}</div>
                </div>
              </div>

              <div class="flex flex-wrap justify-between items-center text-xs mt-auto pt-4 border-t border-white/10">
                <div class="flex gap-3 items-center">
                  <span class="opacity-40 tracking-widest uppercase">Status:</span> 
                  <span class="bg-green-500/10 text-green-400 px-3 py-1 border border-green-500/20 font-bold tracking-widest">{project.entry.finalStatus}</span>
                </div>
                {project.entry.gatewayUri && (
                  <a href={project.entry.gatewayUri} target="_blank" class="text-a83-accent hover:text-white transition-colors tracking-[0.2em] uppercase font-bold flex items-center gap-2">
                    INIT_GATEWAY 
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      {/* --- PRICING --- */}
      <section class="flex flex-col gap-10">
        <div class="inline-block bg-a83-surface/50 px-4 py-2 border-l-2 border-a83-accent w-max">
          <h2 class="text-xl md:text-2xl uppercase tracking-[0.2em] font-bold text-white">// CONTRACT_DEFINITIONS</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {pricingModels.map((pkg) => (
            <article class={`border bg-white/[0.02] p-8 md:p-10 flex flex-col justify-between transition-all
              ${pkg.entry.clearance === 'L3' ? 'border-a83-accent/50 shadow-[0_0_30px_color-mix(in_srgb,var(--a83-accent)_10%,transparent)]' : 'border-white/10 hover:border-white/30'}`}>
              
              <div>
                <div class="flex justify-between items-start mb-6">
                  <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight">> {pkg.entry.name}</h3>
                  <span class={`text-xs px-3 py-1 tracking-widest border ${pkg.entry.clearance === 'L3' ? 'border-a83-accent text-a83-accent bg-a83-accent/10' : 'border-white/30 text-white/50'}`}>
                    {pkg.entry.clearance}
                  </span>
                </div>
                
                <p class="text-base text-white/60 mb-8 min-h-[3rem] whitespace-pre-wrap leading-relaxed">{pkg.entry.description}</p>
                
                <div class="text-4xl md:text-5xl font-black mb-10 border-b border-white/10 pb-8 text-white">
                  <span class="text-xs tracking-widest uppercase block font-normal text-a83-accent mb-2 font-mono">Unit_Price</span> 
                  {pkg.entry.price}
                </div>

                <div class="space-y-8 text-sm md:text-base font-mono">
                  <div>
                    <span class="opacity-40 block mb-4 text-xs tracking-widest uppercase">Output_Parameters:</span>
                    <ul class="space-y-3 text-white/80">
                      {pkg.entry.outputParameters.map(param => (
                        <li class="flex gap-3 items-start"><span class="text-a83-accent opacity-70">├─</span> <span>{param}</span></li>
                      ))}
                    </ul>
                  </div>
                  
                  <div>
                    <span class="opacity-40 block mb-4 text-xs tracking-widest uppercase">Build_Success:</span>
                    <ul class="space-y-3 text-white/80">
                      {pkg.entry.buildSuccess.map(metric => (
                        <li class="flex gap-3 items-start"><span class="text-green-500 opacity-70">└─</span> <span>{metric}</span></li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <a href={pkg.entry.actionLink || 'mailto:post@abteilung83.at'} 
                 class="mt-12 block text-center border border-a83-accent bg-a83-accent/10 py-4 hover:bg-a83-accent hover:text-black transition-all text-a83-accent font-bold tracking-[0.2em] uppercase group">
                Execute_Contract<span class="animate-pulse group-hover:text-black">_</span>
              </a>
            </article>
          ))}
        </div>
      </section>

    </main>
  </div>

  <CommandPalette />
</BaseLayout>