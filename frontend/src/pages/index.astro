---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import CommandPalette from '../components/islands/CommandPalette.astro';
import Pill from '../components/ui/Pill.astro';

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const settings = await reader.singletons.globalSettings.read();
const showcaseProjects = await reader.collections.showcase.all();
const pricingModels = await reader.collections.pricing.all();

const headline = settings?.headline || 'Less Noise. Nice Data. No Bloat.';
const systemStatus = settings?.status === 'active' ? 'ACTIVE_NODE' : 'MAINTENANCE_MODE';
---

<BaseLayout title={headline}>
  
  <div class="flex flex-col items-center w-full font-mono text-a83-text">
    
    {/* =========================================
        HERO SECTION 
        ========================================= */}
    <section class="w-full relative pb-20">
      <Hero />
      
      <div class="mt-8 flex flex-wrap gap-4 justify-center interactive-element" data-sound="hover">
        <Pill text={`status: ${systemStatus}`} theme="neon" />
        <Pill text="engine: astro_v5" theme="dark" />
        <Pill text="zero_bloat: true" theme="outline" />
      </div>

      <div class="flex justify-center mt-12">
         <div class="animate-pulse text-sm text-a83-sub font-mono tracking-widest text-center">
            Press <kbd class="bg-a83-surface border border-a83-sub/30 rounded px-2 py-1 text-a83-text">Cmd</kbd> + <kbd class="bg-a83-surface border border-a83-sub/30 rounded px-2 py-1 text-a83-text">K</kbd> to scroll/execute
         </div>
      </div>
    </section>

    {/* =========================================
        DYNAMIC DATA SECTIONS 
        ========================================= */}
    <main class="w-full max-w-5xl px-6 md:px-8 pb-32 flex flex-col gap-32">

      {/* --- SHOWCASE --- */}
      <section class="flex flex-col gap-6">
        <div class="inline-block bg-a83-surface/50 px-3 py-1 border-l-2 border-a83-accent w-max">
          <h2 class="text-xl uppercase tracking-widest font-bold">// DECLASSIFIED_MISSIONS</h2>
        </div>

        <div class="grid grid-cols-1 gap-8">
          {showcaseProjects.map((project) => (
            <article class="border border-a83-sub/20 bg-a83-surface/60 backdrop-blur-sm p-6 hover:border-a83-accent/50 transition-colors">
              <h3 class="text-xl font-bold mb-4 text-a83-text-bold">> ./read_protocol --id {project.slug}</h3>
              
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 text-sm border-b border-a83-sub/20 pb-6 text-a83-text/80">
                <div><span class="opacity-50 block text-a83-sub">ENTITY:</span> {project.entry.entity}</div>
                <div><span class="opacity-50 block text-a83-sub">VECTOR:</span> {project.entry.vector}</div>
                <div><span class="opacity-50 block text-a83-sub">ARCH:</span> {project.entry.arch}</div>
                <div><span class="opacity-50 block text-a83-sub">CYCLE:</span> {project.entry.cycle}</div>
              </div>

              <div class="space-y-6 text-sm md:text-base opacity-90">
                <p class="italic whitespace-pre-wrap text-a83-accent/80">[{project.entry.protocolReadout}]</p>
                
                <div class="pl-4 border-l border-a83-sub/30">
                  <span class="opacity-50 block mb-2 text-a83-sub">// TASK_PROTOCOL</span>
                  <div class="text-a83-text whitespace-pre-wrap">{project.entry.taskProtocol}</div>
                </div>

                <div class="pl-4 border-l border-a83-sub/30">
                  <span class="opacity-50 block mb-2 text-a83-sub">// FIX_EXECUTED</span>
                  <div class="text-a83-text whitespace-pre-wrap">{project.entry.fixExecuted}</div>
                </div>
              </div>

              <div class="mt-8 flex flex-wrap justify-between items-center text-xs border-t border-a83-sub/20 pt-4">
                <div class="flex gap-2 items-center">
                  <span class="opacity-50 text-a83-sub">// FINAL_STATUS:</span> 
                  <span class="animate-pulse bg-a83-accent/20 text-a83-accent px-2 py-1 font-bold">{project.entry.finalStatus}</span>
                </div>
                {project.entry.gatewayUri && (
                  <a href={project.entry.gatewayUri} target="_blank" class="border border-a83-sub/40 hover:border-a83-accent hover:bg-a83-accent hover:text-white px-3 py-1 transition-colors">
                    [ INIT_GATEWAY ]
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      {/* --- PRICING --- */}
      <section class="flex flex-col gap-6">
        <div class="inline-block bg-a83-surface/50 px-3 py-1 border-l-2 border-a83-accent w-max">
          <h2 class="text-xl uppercase tracking-widest font-bold">// CONTRACT_DEFINITIONS</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {pricingModels.map((pkg) => (
            <article class={`border bg-a83-surface/60 backdrop-blur-sm p-6 flex flex-col justify-between
              ${pkg.entry.clearance === 'L3' ? 'border-a83-accent shadow-[0_0_15px_color-mix(in_srgb,var(--a83-accent)_15%,transparent)]' : 'border-a83-sub/20 hover:border-a83-accent/50'}`}>
              
              <div>
                <div class="flex justify-between items-start mb-4">
                  <h3 class="text-lg font-bold text-a83-text-bold">> {pkg.entry.name}</h3>
                  <span class="text-xs border border-a83-sub/30 px-2 py-1 text-a83-sub">{pkg.entry.clearance}</span>
                </div>
                
                <p class="text-sm text-a83-text/70 mb-6 min-h-[3rem] whitespace-pre-wrap">{pkg.entry.description}</p>
                
                <div class="text-3xl font-bold mb-8 border-b border-a83-sub/20 pb-4 text-a83-text-bold">
                  <span class="text-xs opacity-50 block font-normal text-a83-accent mb-1">// UNIT_PRICE:</span> 
                  {pkg.entry.price}
                </div>

                <div class="space-y-6 text-sm">
                  <div>
                    <span class="opacity-50 block mb-2 text-a83-sub">OUTPUT_PARAMETERS:</span>
                    <ul class="space-y-2 text-a83-text">
                      {pkg.entry.outputParameters.map(param => (
                        <li class="flex gap-2 items-start"><span class="text-a83-accent opacity-70">├─</span> <span>{param}</span></li>
                      ))}
                    </ul>
                  </div>
                  
                  <div>
                    <span class="opacity-50 block mb-2 text-a83-sub">BUILD_SUCCESS:</span>
                    <ul class="space-y-2 text-a83-text">
                      {pkg.entry.buildSuccess.map(metric => (
                        <li class="flex gap-2 items-start"><span class="text-a83-accent opacity-70">└─</span> <span>{metric}</span></li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <a href={pkg.entry.actionLink || 'mailto:hello@abteilung83.at'} 
                 class="mt-10 block text-center border border-a83-accent py-3 hover:bg-a83-accent hover:text-white transition-all font-bold tracking-widest group text-a83-text-bold">
                > sh start_project.sh<span class="animate-pulse group-hover:text-white">_</span>
              </a>
            </article>
          ))}
        </div>
      </section>

    </main>
  </div>

  <CommandPalette />
</BaseLayout>