---
// Version: V23.5 - THE OPERATOR MANUAL (PATH_SYNC)
// Vibe: Technical Specification / Versatile Systems Engineering
// Update: Fixed public directory pathing for Vite compatibility
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/core/SEO.astro';

// Korrektur: In Astro/Vite werden Dateien aus /public direkt über / serviert.
const operatorPhoto = "/images/operator.webp";
---

<BaseLayout title="About // Gerwin_Weiher_Profile">
  
  <SEO 
    slot="head" 
    title="Gerwin Weiher // Web-Architektur & Systems Engineering Graz" 
    description="Erfahre mehr über ABTEILUNG83. Ich entwickle performante Web-Systeme mit Astro & WordPress (Breakdance/Oxygen). 15+ Jahre Erfahrung in digitaler Infrastruktur."
  />

  <section class="nav-content-sync min-h-screen bg-bone-white dark:bg-a83-bg text-black dark:text-white pt-32 pb-24 px-6 lg:px-16 relative overflow-hidden selection:bg-a83-accent selection:text-white transition-colors duration-500">
    
    <div class="absolute inset-0 opacity-[0.05] bg-[radial-gradient(#000_1px,transparent_1px)] bg-[size:30px_30px] pointer-events-none"></div>

    <div class="max-w-[1200px] mx-auto relative z-10">
        
        <header class="mb-32 border-l-4 border-a83-accent pl-8 py-2 flex flex-col md:flex-row justify-between items-start gap-12">
            <div class="flex-1">
                <div class="flex items-center gap-4 font-mono text-[11px] text-a83-accent mb-3 tracking-[0.4em] font-black uppercase">
                    <span>// ENTITY_PROFILE</span>
                    <span class="opacity-20 text-black dark:text-white">|</span>
                    <span>OPERATOR_ID: GERWIN_WEIHER</span>
                </div>
                <h1 class="text-5xl sm:text-7xl lg:text-9xl font-black text-black dark:text-white tracking-tighter uppercase leading-tight sm:leading-[0.85]">
                    Gerwin.<br/><span class="text-a83-accent">Weiher_</span>
                </h1>
                <p class="mt-12 font-mono text-base sm:text-xl text-black dark:text-white max-w-xl uppercase font-black leading-tight border-t border-black/10 dark:border-white/10 pt-8 italic transition-colors duration-500">
                    "Websites sind Werkzeuge. Die Wahl des Systems folgt der Funktion – nicht dem Hype."
                </p>
            </div>

            <div class="relative w-full md:w-[350px] aspect-[3/4] overflow-hidden border border-black/10 dark:border-white/10 group transition-colors duration-500">
                <div class="absolute inset-0 bg-a83-accent/10 mix-blend-multiply z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <img 
                    src={operatorPhoto} 
                    alt="Gerwin Weiher - Digital Systems Engineer" 
                    class="w-full h-full object-cover grayscale contrast-125 brightness-90 transition-all duration-700 group-hover:scale-105"
                />
                <div class="absolute top-4 right-4 z-20 font-mono text-[8px] text-white bg-black px-2 py-1 uppercase tracking-widest opacity-60">
                    Live_Feed: Active
                </div>
                <div class="absolute bottom-0 left-0 w-full h-1 bg-a83-accent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left z-20"></div>
            </div>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-32">
            <div class="md:col-span-4">
                <span class="font-mono text-[10px] text-a83-accent font-black uppercase tracking-widest block mb-4">// ADAPTIVE_STRATEGY</span>
                <h2 class="text-3xl font-black uppercase tracking-tighter leading-none">Custom Logic.<br/>Any Platform.</h2>
            </div>
            <div class="md:col-span-8 font-mono text-sm uppercase leading-relaxed text-black/80 dark:text-white/80 space-y-6 transition-colors duration-500">
                <p>
                    Mein Name ist Gerwin Weiher. Ich entwickle digitale Ökosysteme, die exakt auf deine Anforderungen zugeschnitten sind. Ob hochmoderne **Astro-Architekturen** oder robuste **WordPress-Systeme** – mein Fokus liegt immer auf sauberem Code und messbarem Output.
                </p>
                <p>
                    Ich implementiere WordPress nicht „von der Stange“. Ich nutze professionelle Visual Engines wie **Breakdance** oder **Oxygen Builder**, entwickle **Custom Templates** oder konfiguriere High-End Installationen so, dass sie performen wie ein statisches System.
                </p>
            </div>
        </div>

        <section class="mb-32">
            <div class="flex items-center gap-6 mb-16 uppercase">
                <h2 class="text-4xl font-black tracking-tighter">System_Capabilities.</h2>
                <div class="h-px flex-1 bg-black/10 dark:bg-white/10 transition-colors duration-500"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {[
                    { label: 'Static_Core', val: 'Astro 5.0 / Vite' },
                    { label: 'Dynamic_CMS', val: 'WordPress Expert' },
                    { label: 'Visual_Logic', val: 'Breakdance / Oxygen' },
                    { label: 'Styling_Unit', val: 'Tailwind / Custom CSS' },
                    { label: 'Templating', val: 'PHP / Liquid / JSX' },
                    { label: 'Intel_Mgmt', val: 'Keystatic / Markdoc' },
                    { label: 'Deployment', val: 'Managed Hosting / VPS' },
                    { label: 'Optimization', val: 'Performance / SEO' },
                ].map(spec => (
                    <div class="border border-black/10 dark:border-white/10 p-6 space-y-2 bg-black/[0.02] dark:bg-white/[0.03] hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-all">
                        <span class="block font-mono text-[9px] text-black/40 dark:text-white/40 font-black uppercase transition-colors duration-500">{spec.label}</span>
                        <span class="block font-mono text-sm font-black uppercase text-black dark:text-white transition-colors duration-500">{spec.val}</span>
                    </div>
                ))}
            </div>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-black/10 dark:bg-white/10 mb-32 border border-black/10 dark:border-white/10 transition-colors duration-500">
          <div class="bg-bone-white dark:bg-a83-bg p-12 space-y-6 transition-colors duration-500">
              <span class="font-mono text-[10px] text-black/40 dark:text-white/40 font-black uppercase tracking-widest transition-colors duration-500">// TYPICAL_ISSUES (THE NOISE)</span>
              <ul class="font-mono text-xs uppercase space-y-3 opacity-40">
                  <li>- Unnötiger Plugin-Ballast</li>
                  <li>- Langsame Page-Builder (Bloat)</li>
                  <li>- Schlechte Core Web Vitals</li>
                  <li>- Fehlende Sicherheits-Protokolle</li>
              </ul>
          </div>
          <div class="bg-bone-white dark:bg-a83-bg p-12 space-y-6 border-l border-black/10 dark:border-white/10 transition-colors duration-500">
              <span class="font-mono text-[10px] text-a83-accent font-black uppercase tracking-widest">// A83_STANDARD (THE SIGNAL)</span>
              <ul class="font-mono text-xs uppercase space-y-3 font-bold">
                  <li class="flex gap-3"><span class="text-a83-accent">-></span> Lean-Architecture (Astro/WP)</li>
                  <li class="flex gap-3"><span class="text-a83-accent">-></span> Visual Engines (Breakdance/Oxygen)</li>
                  <li class="flex gap-3"><span class="text-a83-accent">-></span> Tactical Performance Tuning</li>
                  <li class="flex gap-3"><span class="text-a83-accent">-></span> Full Control / Scalability</li>
              </ul>
          </div>
        </div>

        <div class="bg-black text-bone-white p-12 lg:p-20 relative overflow-hidden">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(var(--a83-accent)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none"></div>
            
            <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-12">
                <div class="space-y-4">
                    <span class="block font-mono text-[10px] text-a83-accent font-black uppercase tracking-widest">// BASE_NODE</span>
                    <p class="text-2xl font-black uppercase">Graz, Styria<br/>Austria / Central EU</p>
                </div>
                <div class="space-y-4">
                    <span class="block font-mono text-[10px] text-a83-accent font-black uppercase tracking-widest">// SYSTEM_UPTIME</span>
                    <p class="text-2xl font-black uppercase">15+ Years in Digital<br/>Infrastructure</p>
                </div>
                <div class="space-y-4">
                    <span class="block font-mono text-[10px] text-a83-accent font-black uppercase tracking-widest">// CORE_OBJECTIVE</span>
                    <p class="text-2xl font-black uppercase">Clean Data.<br/>High Conversion.</p>
                </div>
            </div>
        </div>

        <footer class="mt-32 pt-16 border-t border-black/10 dark:border-white/10 flex flex-col md:flex-row justify-between gap-8 items-end transition-colors duration-500">
            <div class="font-mono text-[10px] text-black/40 dark:text-white/40 uppercase space-y-1 text-left transition-colors duration-500">
                <p>Abteilung83 operates as a high-performance engineering unit.</p>
                <p>Strategic tech-decisions for long-term digital growth.</p>
            </div>
            <a href="/contact" class="bg-black text-bone-white px-6 sm:px-12 py-4 sm:py-6 font-mono text-sm sm:text-xl font-black uppercase hover:bg-a83-accent transition-all group overflow-hidden relative w-full md:w-auto text-center">
                <span class="relative z-10">Initiate_Project_Handshake</span>
                <div class="absolute inset-0 bg-a83-accent -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-out"></div>
            </a>
        </footer>

    </div>
  </section>
</BaseLayout>
