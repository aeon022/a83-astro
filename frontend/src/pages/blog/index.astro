<script lang="ts">
  // =========================================================
  // VANILLA/TS: GLITCH, LIVE COMPILER & ACTIVE TRANSMISSIONS
  // =========================================================
  document.addEventListener('astro:page-load', () => {
    // 1. LIVE GHOST COMPILER
    const compiler = document.getElementById('live-compiler');
    if (compiler) {
      compiler.innerHTML = '';
      const messages = [
        "<span class='text-veranda-green'>[INIT]</span> Connecting to Neural Net...",
        "Decrypting Legacy Manifests...",
        "<span class='text-a83-accent'>[WARN]</span> Monolith detected. Bypassing.",
        "Executing Zero-Bloat protocol.",
        "<span class='text-veranda-green'>[OK]</span> Server Islands hydrated.",
        "Transferring consciousness to Astro...",
        "Hash: 0x" + Math.random().toString(16).slice(2, 10).toUpperCase(),
        "<span class='text-veranda-green'>[SYNC]</span> Mem-Alloc stable at 83MB."
      ];

      let msgIndex = 0;

      const typeLine = () => {
        if (msgIndex >= messages.length) msgIndex = 0;

        const line = document.createElement('div');
        line.innerHTML = `> ${messages[msgIndex]}`;
        compiler.appendChild(line);

        if (compiler.children.length > 7) compiler.removeChild(compiler.firstChild as ChildNode);

        msgIndex++;
        setTimeout(typeLine, Math.random() * 600 + 200);
      };

      setTimeout(typeLine, 800);
    }

    // 2. ACTIVE TRANSMISSIONS (Live Loading Bars)
    const bars = document.querySelectorAll<HTMLElement>('.sim-bar');
    if (bars.length > 0) {
      setInterval(() => {
        bars.forEach((bar) => {
          let current = parseFloat(bar.getAttribute('data-val') || '0');

          if (current < 100) {
            current += Math.random() * 4;
            if (current > 100) current = 100;

            bar.setAttribute('data-val', current.toString());
            bar.style.width = `${current}%`;

            const pctText = bar.parentElement?.parentElement?.querySelector<HTMLElement>('.sim-pct');
            if (pctText) pctText.textContent = `${Math.floor(current)}%`;
          } else if (Math.random() > 0.95) {
            bar.setAttribute('data-val', '0');
            bar.style.width = `0%`;
          }
        });
      }, 500);
    }

    // 3. FAKE CODE RAIN BACKGROUND
    const codeRain = document.getElementById('bg-code-rain');
    if (codeRain) {
      let rainText = '';
      const chars = '01ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      for (let i = 0; i < 1500; i++) rainText += chars.charAt(Math.floor(Math.random() * chars.length));
      codeRain.textContent = rainText;
    }

    // 4. CANVAS NODE NETWORK (Theme)
    const canvas = document.getElementById('nexus-bg') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const nodes: Array<{ x: number; y: number; vx: number; vy: number; radius: number }> = [];
    const numNodes = Math.floor((width * height) / 10000);

    for (let i = 0; i < numNodes; i++) {
      nodes.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 1.2,
        vy: (Math.random() - 0.5) * 1.2,
        radius: Math.random() * 1.5 + 0.5
      });
    }

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < nodes.length; i++) {
        const node = nodes[i];
        node.x += node.vx;
        node.y += node.vy;

        if (node.x < 0 || node.x > width) node.vx *= -1;
        if (node.y < 0 || node.y > height) node.vy *= -1;

        ctx.beginPath();
        ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(163, 184, 153, 0.4)';
        ctx.fill();

        for (let j = i + 1; j < nodes.length; j++) {
          const node2 = nodes[j];
          const dx = node.x - node2.x;
          const dy = node.y - node2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 110) {
            ctx.beginPath();
            ctx.moveTo(node.x, node.y);
            ctx.lineTo(node2.x, node2.y);
            ctx.strokeStyle = `rgba(163, 184, 153, ${0.25 - dist / 440})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    };

    draw();
  });
</script>

<style is:global>
  /* -----------------------------------------------------------
     HARDCORE TERMINAL / GLITCH ANIMATIONS
     ----------------------------------------------------------- */

  /* Terminal Cursor */
  .animate-cursor-blink { animation: terminal-blink 1s step-end infinite; }
  @keyframes terminal-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* INITIAL LOAD GLITCH */
  @keyframes entrance-glitch {
    0% { clip-path: inset(50% 0 50% 0); transform: scale(1.05); filter: hue-rotate(90deg) blur(5px); opacity: 0; }
    20% { clip-path: inset(10% 0 80% 0); opacity: 1; filter: invert(1); }
    40% { clip-path: inset(80% 0 10% 0); transform: scale(0.98); filter: none; }
    60% { clip-path: inset(0 0 0 0); transform: scale(1.02); filter: hue-rotate(-45deg); }
    80% { clip-path: inset(20% 0 50% 0); transform: translate(5px, -5px); }
    100% { clip-path: inset(0 0 0 0); transform: scale(1); filter: none; opacity: 1; }
  }
  .animate-entrance-glitch { animation: entrance-glitch 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }

  /* Rotations */
