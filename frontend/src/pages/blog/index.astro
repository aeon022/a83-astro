---
// Dateipfad: frontend/src/pages/blog/index.astro
// Version: V6.3 - LIGHT OPS / OUTLINES ONLY (NO BLOCK BACKGROUNDS)
// Ziel: keine Panel-Backplates, nur Outlines + Ghost FX, mehr Abstand oben.

import BaseLayout from '../../layouts/BaseLayout.astro';
import GlitchText from '../../components/ui/GlitchText.astro';
---

<BaseLayout
  title="Intelligence Nexus [LOCKED] | ABTEILUNG83"
  description="Zugriff auf den Data-Nexus. Ghost-Synchronisation läuft."
>
  <!-- Network Canvas -->
  <canvas id="nexus-bg" class="fixed inset-0 z-[-2] w-full h-full opacity-35"></canvas>

  <!-- Light ambient background (kein Schwarz) -->
  <div
    class="fixed inset-0 z-[-1] pointer-events-none dark:hidden
           bg-[radial-gradient(1200px_900px_at_15%_10%,rgba(163,184,153,0.22),transparent_55%),
               radial-gradient(900px_700px_at_85%_25%,rgba(255,106,0,0.10),transparent_60%),
               linear-gradient(to_bottom,rgba(248,250,249,1),rgba(241,245,243,1))]"
  ></div>

  <!-- Subtle grid -->
  <div
    class="fixed inset-0 pointer-events-none z-0
           bg-[linear-gradient(rgba(10,20,16,0.06)_1px,transparent_1px)]
           bg-[size:100%_4px] mix-blend-multiply dark:mix-blend-overlay opacity-40 dark:opacity-20"
  ></div>

  <!-- Soft flicker -->
  <div class="fixed inset-0 pointer-events-none z-50 mix-blend-multiply opacity-[0.05] animate-screen-glitch bg-veranda-green/20"></div>

  <main class="relative z-10 w-full min-h-screen p-4 md:p-6 lg:p-12 flex flex-col pt-52 pb-20">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-4 w-full max-w-[1400px] mx-auto min-h-[65vh]
             animate-entrance-glitch opacity-0 [animation-fill-mode:forwards]"
    >
      <!-- HERO / HUD -->
      <section class="col-span-1 md:col-span-12 lg:col-span-8 panel-outline p-6 lg:p-10 relative overflow-hidden flex flex-col justify-center animate-container-glitch">
        <div class="absolute top-0 left-0 w-full h-[1px] bg-veranda-green/60 animate-scan-horizontal"></div>

        <div class="flex items-center justify-between mb-8 relative z-10">
          <div class="flex items-center gap-3 text-veranda-green font-mono text-[9px] uppercase tracking-widest border border-veranda-green/30 bg-transparent px-2 py-1">
            <span class="w-1.5 h-1.5 bg-veranda-green animate-pulse"></span>
            SYS_NEXUS::GHOST_SYNC
          </div>

          <div class="font-mono text-[9px] text-black/45 dark:text-bone-white/45 tracking-widest hidden sm:flex gap-4">
            <span class="animate-pulse text-a83-accent">MEM: 83TB</span>
            <span>NODE: A83-ALPHA</span>
          </div>
        </div>

        <h1 class="text-5xl sm:text-7xl lg:text-8xl font-bold uppercase tracking-tighter text-black dark:text-bone-white leading-[0.85] mb-6 relative z-10">
          <GlitchText text="Intelligence" />
          <br />
          <span class="text-transparent [-webkit-text-stroke:1.5px_rgba(20,40,32,0.75)] dark:[-webkit-text-stroke:1.5px_rgba(228,232,223,0.75)] drop-shadow-[0_0_10px_rgba(163,184,153,0.18)] animate-pulse-fast">
            Nexus
          </span>
        </h1>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mt-4 relative z-10">
          <div class="border-l border-a83-accent/40 pl-4">
            <h3 class="font-mono text-[10px] text-a83-accent mb-2 uppercase tracking-widest animate-glitch-text">
              Operation Protocol
            </h3>
            <p class="font-mono text-[11px] text-black/65 dark:text-bone-white/65 leading-relaxed uppercase">
              > Legacy Systeme terminiert.<br />
              > Zero-Bloat Architektur wird injiziert.<br />
              > Bewusstseinstransfer bei 83%.
            </p>
          </div>

          <div class="flex flex-col gap-2 font-mono text-[9px] text-black/55 dark:text-bone-white/55 uppercase tracking-widest mt-2">
            <div class="flex flex-col gap-1">
              <div class="flex justify-between"><span>Ghost Sync</span> <span class="text-a83-accent">Active</span></div>
              <div class="w-full h-[1px] bg-black/10">
                <div class="h-full bg-a83-accent/80 w-[83%] animate-pulse"></div>
              </div>
            </div>

            <div class="flex flex-col gap-1 mt-2">
              <div class="flex justify-between"><span>Decryption</span> <span class="text-veranda-green">Bypassed</span></div>
              <div class="w-full h-[1px] bg-black/10">
                <div class="h-full bg-veranda-green/80 w-[100%]"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="absolute inset-0 font-mono text-[8px] text-veranda-green/15 opacity-40 break-all overflow-hidden z-0 select-none pointer-events-none" id="bg-code-rain"></div>
      </section>

      <!-- NEURAL CORE -->
      <section class="col-span-1 md:col-span-6 lg:col-span-4 panel-outline p-6 relative overflow-hidden hidden sm:flex flex-col items-center justify-center">
        <div class="absolute top-4 left-4 font-mono text-[9px] text-black/45 dark:text-bone-white/45 tracking-widest">NEURAL_CORE</div>

        <div class="relative w-40 h-40 lg:w-48 lg:h-48 flex items-center justify-center my-4 animate-core-glitch">
          <div class="absolute inset-0 bg-veranda-green/12 rounded-full blur-2xl animate-pulse"></div>

          <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full text-black/15 animate-spin-slow">
            <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 10" />
            <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="40 80" class="text-veranda-green/60" />
            <path d="M100 0 L100 200 M0 100 L200 100" stroke="currentColor" stroke-width="0.6" opacity="0.25" />
          </svg>

          <div class="absolute inset-6 border border-dashed border-a83-accent/35 rounded-full animate-spin-reverse"></div>

          <div class="w-8 h-8 lg:w-10 lg:h-10 bg-a83-accent/0 border border-a83-accent/55 rounded-sm flex items-center justify-center backdrop-blur-md animate-ping-slow rotate-45 shadow-[0_0_18px_rgba(255,106,0,0.16)]">
            <div class="w-2 h-2 bg-black/70 dark:bg-bone-white/70 rounded-full animate-pulse-fast"></div>
          </div>
        </div>
      </section>

      <!-- LIVE COMPILER -->
      <section class="col-span-1 md:col-span-6 lg:col-span-4 panel-outline p-4 relative h-48 lg:h-64 overflow-hidden flex flex-col">
        <div class="font-mono text-[9px] text-veranda-green/90 mb-2 border-b border-black/10 pb-2 flex justify-between">
          <span>// GHOST_COMPILER.exe</span>
          <span class="animate-pulse text-a83-accent">EXECUTING</span>
        </div>

        <div id="live-compiler" class="font-mono text-[10px] text-black/70 dark:text-bone-white/70 leading-relaxed overflow-hidden flex-grow flex flex-col justify-end gap-1"></div>
      </section>

      <!-- METRICS -->
      <section class="col-span-1 md:col-span-12 lg:col-span-8 panel-outline p-6 relative flex flex-col justify-between h-48 lg:h-64">
        <div class="font-mono text-[9px] text-black/45 dark:text-bone-white/45 mb-4 border-b border-black/10 dark:border-white/10 pb-2 uppercase">
          // System_Metrics_Array
        </div>

        <div class="grid grid-cols-4 gap-2 md:gap-4 h-full items-end pb-2">
          <div class="flex flex-col justify-end h-full gap-1 group">
            <div class="font-mono text-[9px] text-a83-accent text-right">0x83</div>
            <div class="w-full bg-black/5 dark:bg-white/5 h-full relative">
              <div class="absolute bottom-0 w-full bg-a83-accent/70 h-[83%] group-hover:bg-a83-accent transition-all animate-bar-glitch-1"></div>
            </div>
            <div class="font-mono text-[8px] text-black/45 dark:text-bone-white/45 text-center mt-1">ASTRO_CORE</div>
          </div>

          <div class="flex flex-col justify-end h-full gap-1 group">
            <div class="font-mono text-[9px] text-veranda-green text-right">0x99</div>
            <div class="w-full bg-black/5 dark:bg-white/5 h-full relative">
              <div class="absolute bottom-0 w-full bg-veranda-green/70 h-[99%] group-hover:bg-veranda-green transition-all animate-bar-glitch-2"></div>
            </div>
            <div class="font-mono text-[8px] text-black/45 dark:text-bone-white/45 text-center mt-1">ZOD_SCHEMA</div>
          </div>

          <div class="flex flex-col justify-end h-full gap-1 group">
            <div class="font-mono text-[9px] text-black/70 dark:text-bone-white/70 text-right">0x45</div>
            <div class="w-full bg-black/5 dark:bg-white/5 h-full relative">
              <div class="absolute bottom-0 w-full bg-black/45 dark:bg-bone-white/45 h-[45%] group-hover:bg-black/60 dark:group-hover:bg-bone-white/60 transition-all animate-bar-glitch-3"></div>
            </div>
            <div class="font-mono text-[8px] text-black/45 dark:text-bone-white/45 text-center mt-1">V8_ENGINE</div>
          </div>

          <div class="flex flex-col justify-end h-full gap-1 group hidden sm:flex">
            <div class="font-mono text-[9px] text-a83-accent text-right">ERR</div>
            <div class="w-full bg-red-500/10 h-full relative">
              <div class="absolute bottom-0 w-full bg-red-500/60 h-[15%] animate-pulse-fast"></div>
            </div>
            <div class="font-mono text-[8px] text-red-600/70 text-center mt-1">LEGACY_JS</div>
          </div>
        </div>
      </section>
    </div>

    <!-- COMMUNIQUE -->
    <div class="w-full max-w-4xl mx-auto mt-16 mb-16 relative">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-full h-[1px] bg-black/10 dark:bg-white/10 grow"></div>
        <div class="font-mono text-[10px] md:text-xs text-black/45 dark:text-bone-white/45 uppercase tracking-widest border border-black/10 dark:border-white/10 px-4 py-1 bg-transparent">
          Decrypted Communique // Read-Only
        </div>
        <div class="w-full h-[1px] bg-black/10 dark:bg-white/10 grow"></div>
      </div>

      <article class="panel-outline p-6 md:p-10 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-veranda-green/70"></div>
        <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-a83-accent/70"></div>

        <div class="font-mono text-[10px] md:text-xs text-a83-accent mb-4 break-all">
          root@a83-alpha:~ $ cat /docs/COMMUNIQUE.md
        </div>

        <h2 class="font-mono text-xl md:text-2xl lg:text-3xl font-bold uppercase tracking-tight text-black dark:text-bone-white mb-5 mt-0">
          Was passiert hier?
        </h2>

        <div class="font-mono text-[12px] md:text-sm text-black/75 dark:text-bone-white/75 leading-relaxed space-y-4">
          <p>Du suchst unseren Blog. Du findest einen Terminal-Compiler in Aktion. Warum?</p>

          <p class="text-black/80 dark:text-bone-white/80">
            Weil wir uns weigern, Standard-Müll auszuliefern. Die ABTEILUNG83 strukturiert aktuell ihre gesamte Architektur um.
            Wir migrieren von monolithischen Legacy-Systemen auf einen nativen
            <span class="text-veranda-green font-semibold">Astro + TypeScript Stack</span>.
            Keine aufgeblähten Pagebuilder, kein unnötiges Client-Side-JavaScript. Nur rohe Performance.
          </p>

          <p class="text-black/80 dark:text-bone-white/80">
            Hier entsteht in Kürze der <span class="text-veranda-green font-semibold">Intelligence Nexus</span>.
            Unser Archiv für Deep-Dives, Architektur-Konzepte, Performance-Patterns und ungeschönte Dev-Logs.
          </p>

          <div class="mt-6 border-t border-black/10 dark:border-white/10 pt-6">
            <ul class="list-none p-0 m-0 space-y-3">
              <li class="flex items-start gap-3">
                <span class="text-a83-accent mt-[2px]">>></span>
                <span><span class="text-veranda-green font-semibold">Tech Breakdowns:</span> Wie wir Systeme bauen, die bei Lighthouse die 100 knacken.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-a83-accent mt-[2px]">>></span>
                <span><span class="text-veranda-green font-semibold">DevOps & Docker:</span> Unsere Server-Architekturen und Deployment-Pipelines.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-a83-accent mt-[2px]">>></span>
                <span><span class="text-veranda-green font-semibold">Tactical UI/UX:</span> Warum wir „Less Noise. Nice Data.“ als Direktive fahren.</span>
              </li>
            </ul>
          </div>

          <div class="mt-6 flex items-center">
            <span class="text-veranda-green mr-2">root@a83-alpha:~ $</span>
            <span class="w-2 h-4 bg-black/70 dark:bg-bone-white/70 animate-cursor-blink inline-block"></span>
          </div>
        </div>
      </article>
    </div>

    <!-- TRANSMISSIONS -->
    <div class="w-full max-w-5xl mx-auto">
      <div class="font-mono text-[9px] text-veranda-green/70 uppercase tracking-widest mb-4 border-b border-veranda-green/20 pb-2 flex justify-between">
        <span>// INCOMING_TRANSMISSIONS (GHOST_NODES)</span>
        <span class="animate-pulse text-black/40 dark:text-bone-white/40">DOWNLOADING...</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4" id="transmission-grid">
        <div class="panel-outline p-4 relative overflow-hidden">
          <div class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(0,0,0,0.03)_50%,transparent_75%)] bg-[length:250%_250%] animate-shimmer"></div>
          <div class="relative z-10">
            <div class="font-mono text-[9px] text-a83-accent mb-3 flex justify-between">
              <span>FILE_0x83</span> <span class="animate-pulse text-black/35 dark:text-bone-white/35">ACTV</span>
            </div>
            <div class="w-full h-1.5 bg-black/10 dark:bg-white/10 mb-4 relative overflow-hidden">
              <div class="sim-bar absolute top-0 left-0 h-full bg-a83-accent/75 transition-all duration-300" data-val="42" style="width: 42%;"></div>
            </div>
            <div class="font-mono text-[9px] text-black/55 dark:text-bone-white/55 flex justify-between">
              <span>COMPILING</span> <span class="sim-pct text-black/80 dark:text-bone-white/80">42%</span>
            </div>
          </div>
        </div>

        <div class="panel-outline p-4 relative overflow-hidden">
          <div class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(0,0,0,0.03)_50%,transparent_75%)] bg-[length:250%_250%] animate-shimmer" style="animation-delay: 0.35s"></div>
          <div class="relative z-10">
            <div class="font-mono text-[9px] text-veranda-green mb-3 flex justify-between">
              <span>PARSING_AST</span> <span class="animate-pulse text-black/35 dark:text-bone-white/35">ACTV</span>
            </div>
            <div class="w-full h-1.5 bg-black/10 dark:bg-white/10 mb-4 relative overflow-hidden">
              <div class="sim-bar absolute top-0 left-0 h-full bg-veranda-green/75 transition-all duration-300" data-val="89" style="width: 89%;"></div>
            </div>
            <div class="font-mono text-[9px] text-black/55 dark:text-bone-white/55 flex justify-between">
              <span>EXTRACTING</span> <span class="sim-pct text-black/80 dark:text-bone-white/80">89%</span>
            </div>
          </div>
        </div>

        <div class="panel-outline p-4 relative overflow-hidden hidden sm:block">
          <div class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(0,0,0,0.03)_50%,transparent_75%)] bg-[length:250%_250%] animate-shimmer" style="animation-delay: 0.7s"></div>
          <div class="relative z-10">
            <div class="font-mono text-[9px] text-black/55 dark:text-bone-white/55 mb-3 flex justify-between">
              <span>DEV_LOG_01</span> <span class="text-black/45 dark:text-bone-white/45">QUEUED</span>
            </div>
            <div class="w-full h-1.5 bg-black/10 dark:bg-white/10 mb-4 relative overflow-hidden">
              <div class="sim-bar absolute top-0 left-0 h-full bg-black/35 dark:bg-bone-white/35 transition-all duration-300" data-val="12" style="width: 12%;"></div>
            </div>
            <div class="font-mono text-[9px] text-black/55 dark:text-bone-white/55 flex justify-between">
              <span>DECRYPT</span> <span class="sim-pct text-black/80 dark:text-bone-white/80">12%</span>
            </div>
          </div>
        </div>

        <div class="panel-outline p-4 relative overflow-hidden hidden md:block">
          <div class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(0,0,0,0.03)_50%,transparent_75%)] bg-[length:250%_250%] animate-shimmer" style="animation-delay: 1.05s"></div>
          <div class="relative z-10">
            <div class="font-mono text-[9px] text-black/55 dark:text-bone-white/55 mb-3 flex justify-between">
              <span>UI_PATTERN_Z</span> <span class="text-black/45 dark:text-bone-white/45">QUEUED</span>
            </div>
            <div class="w-full h-1.5 bg-black/10 dark:bg-white/10 mb-4 relative overflow-hidden">
              <div class="sim-bar absolute top-0 left-0 h-full bg-black/35 dark:bg-bone-white/35 transition-all duration-300" data-val="4" style="width: 4%;"></div>
            </div>
            <div class="font-mono text-[9px] text-black/55 dark:text-bone-white/55 flex justify-between">
              <span>DECRYPT</span> <span class="sim-pct text-black/80 dark:text-bone-white/80">4%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script lang="ts">
  document.addEventListener('astro:page-load', () => {
    // 1) LIVE COMPILER
    const compiler = document.getElementById('live-compiler');
    if (compiler) {
      compiler.innerHTML = '';
      const messages = [
        "<span class='text-veranda-green'>[INIT]</span> Connecting to Neural Net...",
        "Decrypting Legacy Manifests...",
        "<span class='text-a83-accent'>[WARN]</span> Monolith detected. Bypassing.",
        "Executing Zero-Bloat protocol.",
        "<span class='text-veranda-green'>[OK]</span> Server Islands hydrated.",
        "Transferring consciousness to Astro...",
        "Hash: 0x" + Math.random().toString(16).slice(2, 10).toUpperCase(),
        "<span class='text-veranda-green'>[SYNC]</span> Mem-Alloc stable at 83MB."
      ];

      let msgIndex = 0;
      const typeLine = () => {
        if (msgIndex >= messages.length) msgIndex = 0;
        const line = document.createElement('div');
        line.innerHTML = `> ${messages[msgIndex]}`;
        compiler.appendChild(line);
        if (compiler.children.length > 7) compiler.removeChild(compiler.firstChild as ChildNode);
        msgIndex++;
        setTimeout(typeLine, Math.random() * 600 + 200);
      };
      setTimeout(typeLine, 800);
    }

    // 2) TRANSMISSIONS
    const bars = document.querySelectorAll<HTMLElement>('.sim-bar');
    if (bars.length > 0) {
      setInterval(() => {
        bars.forEach((bar) => {
          let current = parseFloat(bar.getAttribute('data-val') || '0');
          if (current < 100) {
            current += Math.random() * 4;
            if (current > 100) current = 100;
            bar.setAttribute('data-val', current.toString());
            bar.style.width = `${current}%`;
            const pctText = bar.parentElement?.parentElement?.querySelector<HTMLElement>('.sim-pct');
            if (pctText) pctText.textContent = `${Math.floor(current)}%`;
          } else if (Math.random() > 0.95) {
            bar.setAttribute('data-val', '0');
            bar.style.width = `0%`;
          }
        });
      }, 500);
    }

    // 3) CODE RAIN
    const codeRain = document.getElementById('bg-code-rain');
    if (codeRain) {
      let rainText = '';
      const chars = '01ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      for (let i = 0; i < 1500; i++) rainText += chars.charAt(Math.floor(Math.random() * chars.length));
      codeRain.textContent = rainText;
    }

    // 4) CANVAS NETWORK
    const canvas = document.getElementById('nexus-bg') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const nodes: Array<{ x: number; y: number; vx: number; vy: number; radius: number }> = [];
    const numNodes = Math.floor((width * height) / 11000);

    for (let i = 0; i < numNodes; i++) {
      nodes.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.95,
        vy: (Math.random() - 0.5) * 0.95,
        radius: Math.random() * 1.4 + 0.4
      });
    }

    const draw = () => {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < nodes.length; i++) {
        const node = nodes[i];
        node.x += node.vx;
        node.y += node.vy;

        if (node.x < 0 || node.x > width) node.vx *= -1;
        if (node.y < 0 || node.y > height) node.vy *= -1;

        ctx.beginPath();
        ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(163, 184, 153, 0.26)';
        ctx.fill();

        for (let j = i + 1; j < nodes.length; j++) {
          const node2 = nodes[j];
          const dx = node.x - node2.x;
          const dy = node.y - node2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(node.x, node.y);
            ctx.lineTo(node2.x, node2.y);
            ctx.strokeStyle = `rgba(163, 184, 153, ${0.15 - dist / 900})`;
            ctx.lineWidth = 0.55;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    };

    draw();
  });
</script>

<style is:global>
  /* OUTLINE-ONLY PANELS */
  .panel-outline {
    background: transparent;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 0;
    box-shadow: none;
    backdrop-filter: none;
  }
  :where(.dark, .dark *) .panel-outline {
    border-color: rgba(255,255,255,0.12);
  }

  /* Animations (wie gehabt, leicht entschärft) */
  .animate-cursor-blink { animation: terminal-blink 1s step-end infinite; }
  @keyframes terminal-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  @keyframes entrance-glitch {
    0% { clip-path: inset(55% 0 45% 0); transform: scale(1.03); filter: hue-rotate(35deg) blur(4px); opacity: 0; }
